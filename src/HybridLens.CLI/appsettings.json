{
  "Workspace": {
    "ExcludeTestProjects": true,
    "ExcludePatterns": [],
    "IncludePatterns": []
  },
  "Detectors": {
    "GodClass": {
      "MaxMethods": 20,
      "MaxFields": 15,
      "MaxLinesOfCode": 500
    },
    "LongMethod": {
      "MaxLinesOfCode": 50,
      "MaxCyclomaticComplexity": 10
    },
    "ObsoleteApi": {
      "DeprecatedNamespacePrefixes": []
    }
  },
  "Context": {
    "Strategy": "PerFinding",
    "TokenBudget": 2000,
    "SnippetContextLines": 10,
    "TemplateDirectory": "templates",
    "Metadata": {}
  },
  "Llm": {
    "Provider": "claude",
    "Model": "claude-sonnet-4-6",
    "Temperature": 0.2,
    "MaxTokens": 1024
  }
}
