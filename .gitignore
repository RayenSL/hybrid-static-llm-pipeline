*.nupkg
*.snupkg
project.nuget.cache
.nuget/

# Test results
TestResults/
coverage/
*.trx
*.coveragexml

# Publish output
publish/
out/

# Secrets & config overrides
appsettings.local.json
appsettings.*.local.json
*.env
.env
*.pfx
*.key

# Rider / JetBrains
