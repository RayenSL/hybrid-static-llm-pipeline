# .NET build output
bin/
obj/

# Outputs
**/output/
**/runs/

# Archived experiment runs (large generated artefacts)
archive/previous-runs-*/
experiments/**/archive/

# Superseded figure sets: regenerable from the sealed campaign via analysis/
archive/previous-figures-*/

# Thesis writing drafts: the thesis is authored outside this repo
archive/thesis-drafts-*/

# Per-assignment codebase reconstructions: regenerable from campaign/final-sources
# via preflight/archive_materialized_codebases.py. The INDEX/SUMMARY/SHA256SUMS
# records at the viewable-codebases root are kept as provenance.
experiments/**/viewable-codebases/*/

# Local scratch
tmp/

# NuGet
*.nupkg
*.snupkg
project.nuget.cache
.nuget/

# Test results
TestResults/
coverage/
*.trx
*.coveragexml

# Publish output
publish/
out/

# Secrets & config overrides
appsettings.local.json
appsettings.*.local.json
*.env
.env
*.pfx
*.key

# Rider / JetBrains
# (per-user workspace state — shared .idea files like vcs.xml are committed)
.idea/
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/shelf/
.idea/**/contentModel.xml
.idea/**/.idea.*.iml
.idea/**/modules.xml
.idea/**/dataSources/
.idea/**/dataSources.local.xml
.idea/**/httpRequests/
.idea/**/queries/
.idea/**/copilot.data.migration.ask2agent.xml

# Visual Studio
.vs/
*.user
*.suo

# OS
.DS_Store
Thumbs.db
desktop.ini
__pycache__/

# Generated analysis artifacts; retain source, tests, protocols and input selections
/analysis/**/results/
/analysis/**/*_results/
/analysis/**/figures/
/analysis/**/logs/
/analysis/*/SHA256SUMS.json

# Thesis typesetting belongs outside this code repository.
*.tex
*.bib
*.sty
*.cls
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
# Historical writing bundles and local document review exports.
/docs/*overleaf*/
/docs/*overleaf*.zip
/analysis/maintenance_efficiency/reaccrual/thesis_revision/
/analysis/maintenance_efficiency/thesis_integration/

# Non-code thesis/reference documents and presentation drafts stay outside Git.
/*.pdf
/presentations/
/CHECK_*_REVIEW.md
/THESIS_*_REVIEW*.md
/LITERATURE_SELECTION*
