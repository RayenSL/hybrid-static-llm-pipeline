.idea/**/tasks.xml
.idea/**/shelf/
.idea/**/contentModel.xml
.idea/**/.idea.*.iml
.idea/**/modules.xml
.idea/**/dataSources/
.idea/**/dataSources.local.xml
.idea/**/httpRequests/
.idea/**/queries/
