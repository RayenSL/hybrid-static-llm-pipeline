    "project": "per-snapshot project field",
    "production_prefix": "per-snapshot production_prefix field",
    "exclude_paths": [
      "bin/",
      "obj/"
    ],
    "exclude_generated_filename_suffixes": [
      ".g.cs",
      ".g.i.cs",
      ".generated.cs",
      ".designer.cs"
    ],
    "exclude_generated_header_markers": [
      "<auto-generated",
      "<autogenerated"
    ],
    "generated_header_scan_characters": 2048,
    "partial_types": "class declarations; do not merge parts",
    "tests_and_tools": "all paths outside the production prefix excluded from measurements",
    "component_policy": "one central production component with explicit rename/successor mapping"
  },
  "framework": {
    "policy": "original default production project; for multitargeting select its first declared TargetFrameworks entry",
    "implicit_legacy_default": "v2.0 only for the verified VS2005 project format with no explicit target",
    "retargeting_allowed": false,
    "transitions": "record and annotate; no attribution of changes solely to source evolution",
    "references": "exact selected target reference files with SHA-256; retain copies in replay bundle"
  },
  "detectors": {
    "GodClass": {
      "AtfdFew": 4,
      "WmcVeryHigh": 47,
      "TccThreshold": 0.3333
    },
    "LongMethod": {
      "MaxCyclomaticComplexity": 10,
      "MaxLinesOfCode": 50
    },
    "ObsoleteApi": {
      "DeprecatedNamespacePrefixes": []
    }
  },
  "measurement": {
    "god_class_unit": "class declaration",
    "long_method_unit": "MethodDeclarationSyntax",
    "obsolete_api_unit": "distinct obsolete referenced symbol per source file under the existing detector",
    "normalisation": [
      "flagged class declarations / eligible class declarations",
      "flagged method declarations / eligible method declarations",
      "production files with obsolete API findings / eligible production files"
    ],
    "source_size": "physical lines including blanks/comments, reported separately; not a complexity surrogate",
    "status_values": [
      "complete",
      "partial",
      "failed",
      "not_applicable"
    ],
    "valid_zero": "complete with explicit empty findings and zero counts; zero denominators yield null rates"
  },
  "adapter": {
    "strategy": "export evaluated Csc command-line arguments using installed MSBuild; reconstruct compilation with the unchanged HybridLens detector sources and frozen Roslyn; retain original source, defines and reference APIs",
    "upstream_source_edits_allowed": false,
    "sdk_selector_adaptation": "use explicitly recorded SDK build invocation from outside snapshot SDK discovery; if a selector needs an override, it must be scripted and recorded",
    "generated_sources": "retain as semantic support; exclude from measured findings/denominators",
    "compiler_errors": "any parser/reference/compilation error prevents complete status",
    "analyzer_generators": "do not silently omit required generated declarations; require clean reconstructed compilation",
    "deterministic_dependency_builds": "Deterministic=true, ContinuousIntegrationBuild=true, DeterministicSourcePaths=false, and per-snapshot root mapped to /_/; required for byte-identical locally built project references."
  },
  "reproducibility": {
    "independent_snapshot_directories": 2,
    "require_same_reference_bytes": true,
    "require_same_source_bytes": true,
    "compare": "canonical complete measurements, findings, denominators, source/reference hashes and effective compiler settings",
    "exclude_from_comparison": [
      "absolute paths",
      "wall-clock timestamps",
      "durations",
      "diagnostic presentation paths"
    ],
    "failure_is_not_equality_success": true,
    "offline_replay": "reconstruct and rescan from archived source, compiler arguments, reference assemblies and frozen scanner without repository or NuGet access",
    "frozen_analyser": "source snapshot and SHA-256 inventory, not Git HEAD alone"
  },
  "inference": "descriptive prevalence in one purposively selected library; no individual persistence, repair, causality or population-generalisation claims",
  "full_study_gate": "all 17 snapshots complete in both independent directories and offline replay",
  "parent_protocol_sha256": "bda03c9d6a462d56565559a2ed7df6b97bfe97030b4a9894a70ca82371cf667b",
