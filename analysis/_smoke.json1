{"run_id": "f712b2a843d5417898a5f4e77873c553", "timestamp": "2026-06-03T08:05:28.617737+00:00", "run_number": 1, "anti_pattern_type": "god_class", "file_path": "Z:\\GitHub\\ibis.calculeren.bouw\\Ibis.Calculeren\\BL\\Begroting.cs", "symbol_name": "Ibis.Calculeren.BL.BBegroting", "line": 88, "severity": "critical", "snippet": "\r\n    #endregion enum\r\n    /// <summary> Begroting: onderdeel van Project </summary>\r\n    public partial class BBegroting : IBegroting, IDisposable\r\n    {\r\n        private readonly ILogboek _logboek = IoC.Resolve<ILogboek>();\r\n        private readonly IKostenbestandRaadplegen _kostenbestandRaadplegen = IoC.Resolve<IKostenbestandRaadplegen>();\r\n        private readonly IBAfronden _afronden = IoC.Resolve<IBAfronden>();\r\n        private readonly IStructuurStatusFout _structuurStatusFout = IoC.Resolve<IStructuurStatusFout>();\r\n        private readonly IVoortgangsBalk _voortgangsBalk = IoC.Resolve<IVoortgangsBalk>();\r\n        private readonly ILogger<BBegroting> _logger = IoC.ResolveLogger<BBegroting>();\r\n        private readonly ICopyPasteBegroting _copyPasteBegroting = IoC.Resolve<ICopyPasteBegroting>();\r\n        private readonly IOptieNiveauWisseling _optieNiveauWisseling = IoC.Resolve<IOptieNiveauWisseling>();\r\n        private readonly IRapportService _rapportService = IoC.Resolve<IRapportService>();\r\n        private readonly IMaakBrutobegroting _maakBrutobegroting = IoC.Resolve<IMaakBrutobegroting>();\r\n        private readonly IIbisConfiguration _ibisConfiguration = IoC.Resolve<IIbisConfiguration>();\r\n        private readonly IKostenModel _kostenModel = IoC.Resolve<IKostenModel>();\r\n        private readonly IBStatics _statics = IoC.Resolve<IBStatics>();\r\n        private readonly IMeldingVenster _meldingVenster = IoC.Resolve<IMeldingVenster>();\r\n\r\n        #region Constanten\r\n        public const string c_RegBehoudVervangMidVraagUmc = \"vervangBehoudMidVraagUmc\";\r\n        public const string c_RegBehoudMidUmc = \"behoudMidUmc\";\r\n        public const string c_RegVervangMidUmc = \"vervangMidUmc\";\r\n        public const string c_BrutoVerzamelPosten = \"ABCDEFHIJKLPWXYZ\";\r\n        public const string c_NettoVerzamelposten = \"GMNOQRSTUV\";\r\n        public const int c_RElId = 1;   // ID gereserveerd voor rootelement\r\n        private const int c_OpmLen = BOpmaakSjabloon.c_NaamLen;\r\n        public const string c_FntVulCodeUitElement = \"FntVulCodeUitElement\";\r\n        private const string Format = \"{0}. {1}.\\r\\n{2}\";\r\n        #endregion Constanten\r\n\r\n        #region Data members\r\n        private static int m_NaamNummer;          // Tbv default-constructor\r\n        private static BBegroting? s_VoorbeeldBegroting;   // Tbv wijzigen opmaak\r\n        private string? m_Oms;                     // Omschrijving: BgrOms\r\n        private EBgrTpe m_Tpe;                    // Type: TRD | ELT | ODH | RAW (=Traditioneel | Element |Onderhoud | RAW)\r\n        private int m_Umc;                        // Unieke middelencodering: een middel kan door meerdere kostenposten worden toegepast\r\n                                                  // private bool m_UmcMidOverschrijf;         // Als begroting is Umc Overschrijf de middelen als er gekopieerd wordt van uit de referentie\r\n        private double m_TotUur;                  // TotaalUren\r\n        private BXtoKst? m_XtoKst;                 // NettoArbeid, ... , BrutoStaartKosten\r\n        private string? m_Dtm;                     // Dtm(A20)\tdatum van laatste update, formaat YYYY-MM-DD UU:MM:SS (tbv vergelijking)\r\n        private int? m_MaxId;                     // Tbv uitgeven nieuwe ID's\r\n        private IStructuur? m_Stu;                 // Bevat onderbouwing: lijst van BStructuurRegel-objecten\r\n        private BMiddelen? m_Mid;                  // gesorteerde lijst met middelen\r\n        private BBegrotingsGegevenVzl? m_Bgv;      // lijst met begrotingsgegevens (door programma gedefinieerd)\r\n        private BGebruikersGegevenVzl? m_Ggv;      // lijst met gebruikersgegevens (door gebruiker gedefinieerd)\r\n        private IBegrotingBlad? m_Bbd;            // begrotingblad, aanvankelijk null\r\n        private BVastTotaal? m_VastTotaal;\r\n        private int m_VttId = -1;                 // ID van kostenpost waarmee naar vast totaal wordt gerekend. -1: nog niet bepaald\r\n        private int m_Versie = 1;                 // Tbv tekenen van wijzigingen\r\n        private string? m_RKOrg;                  // Origineel van de reservekopie\r\n        private bool m_Snel;\r\n        private bool m_GroepeerOpdrachten;\r\n        private BAfgerondRekenen? m_AfgerondRekenen;\r\n        private BMetingen? m_Metingen;\r\n        private EActieContext m_ActieContext = EActieContext.Geen;\r\n        private bool m_BtwToepassen;\r\n        private List<BElement.BElementStatus>? m_ElementStatusLijstIvmSqlServerLezen;\r\n        private readonly IMaxIdBepaler _maxIdBepaler;\r\n\r\n        public BMeetstaatKoppeling? _ActieveKoppeling { get; set; }\r\n        public bool _UurloonMeldingen { get; set; }\r\n\r\n        /// <summary>Eigenschappen van een onderhoud kostenbestand (kostenbestand en parameters)\r\n        /// </summary>\r\n        private BBrinkKostenbestandEigenschappen? m_BrinkKostenbestandEigenschappenOnderhoud;\r\n\r\n        #region Project Begroting informatie\r\n        #endregion Project Begroting informatie\r\n\r\n        #region Raw informatie\r\n        private BRawInfo? m_RawInfo;\r\n        public BRawInfo _RawInfo => m_RawInfo ?? throw new InvalidOperationException(\"RawInfo not initialized\");\r\n        #endregion Raw informatie\r\n\r\n        private LeesMiddelDlgte? m_LeesMiddel;\r\n        private LeesMetingDlgte? m_LeesMeting;\r\n        private LeesMetingGuidDlgte? m_LeesMetingGuid;\r\n        private VraagKopieerKoppelingDlgte? m_VraagKopieerKoppeling;\r\n\r\n        private IMeetstaatModelVzl? m_MeetstaatModelVzl;\r\n        private IList<BMeting>? m_MtnLijstTbvSqlLezen;\r\n        #endregion\r\n\r\n        #region Valuta\r\n        /// <summary>De actieve basisvaluta van de begroting (deze kan gewijzigd worden met WijzigValuta())\r\n        /// </summary>\r\n        private BDocValuta? m_BasisValuta;\r\n\r\n        /// <summary>get/set De actieve basisvaluta van de begroting (deze kan gewijzigd worden met WijzigValuta())\r\n        /// (set kan alleen indien m_BasisValuta nog null is anders volgt een DebugAssert\r\n        /// </summary>\r\n        public BDocValuta? _BasisValuta\r\n        {\r\n            get => m_BasisValuta;\r\n            set\r\n            {\r\n                if (value != null)\r\n                    m_BasisValuta ??= value;\r\n            }\r\n        }\r\n        /// <summary>get/set Lijst met begrotingsvalutagegevens (door programma gedefinieerd)\r\n        /// </summary>\r\n        public IList<BValutaDeco> BegrotingsValuta { get; }\r\n        /// <summary>get / set De gelezen aanduiding van de actieve valuta\r\n        /// NB Dit lost het kip/ei probleem van de basivaluta / bgr gegevens op \r\n        /// (geen basisvaluta zonder basisvalutalijst en geen basisvalutagegevens zonder een naam)\r\n        /// </summary>\r\n        public string? _VltAanduiding { get\r\n            {\r\n                if (field != null)\r\n                    return field;\r\n                if (m_BasisValuta != null)\r\n                    return m_BasisValuta._Aanduiding;\r\n                return null;\r\n            }\r\n            set; }\r\n        /// <summary>get De Id van de actieve valuta (m_BasisValuta)\r\n        /// </summary>\r\n        public int _VltId\r\n        {\r\n            get\r\n            {\r\n                if (m_BasisValuta != null)\r\n                    return m_BasisValuta._VltId;\r\n                else\r\n                    return -1;\r\n            }\r\n        }\r\n        #endregion Valuta\r\n\r\n        #region Btw\r\n        private static readonly double s_BtwHoogDefault = 21.0;\r\n        private static readonly double s_BtwLaagDefault = 6.0;\r\n        #endregion Btw\r\n\r\n        #region Properties\r\n\r\n        /// <summary>get/set De context (control/grid) die op dat moment actief is\r\n        /// </summary>\r\n        /// \r\n        public string? _Gebruiker { get; set; }\r\n\r\n        public string? _BepaalElementenBoekNaam { get; set; }\r\n        public BestandBestaat? _BestaatElementenBoek { get; set; }\r\n        public BestandBestaat? _BestaatPrijzenBoek { get; set; }\r\n\r\n        //BestandBestaat\r\n        /// <summary>get/set Een lijst van alle metingen die op dit moment in de begroting aanwezig zijn\r\n        /// (inclusief nieuwe en verwijderde)\r\n        /// </summary>\r\n        public BXtoKst _XtoKst => m_XtoKst ?? throw new InvalidOperationException(\"XtoKst not initialized\");\r\n\r\n        public IUserInterface? _UserInterface { get; private set; }\r\n\r\n        public int _HoogsteNiveau { get; set; } = 29999;\r\n\r\n        public string _Naam\r\n        {\r\n            get { return _DocumentNaam; }\r\n            set\r\n            {\r\n                if (value == null || value.Trim().Length == 0)\r\n                    throw new NaamIsLeegException();\r\n\r\n                _DocumentNaam = value.SaneerTekst();\r\n            }\r\n        }\r\n        public string _Oms\r\n        {\r\n            get { return m_Oms ?? throw new InvalidOperationException(\"Oms not initialized\"); }\r\n            set { m_Oms = value.SaneerTekst(); }  // geen eisen\r\n        }\r\n\r\n        /// <summary>Tarief voor btw-hoog</summary>\r\n        public double _BtwHoog\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_BtwHoog);\r\n                if (bgv == null)\r\n                {\r\n                    _BtwHoog = s_BtwHoogDefault;\r\n                    return s_BtwHoogDefault;\r\n                }\r\n                return bgv.GeefDouble();\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_BtwHoog, EGgvTpe.Numeriek, \"Btw hoog\");//NIETVERTALEN\r\n                bgv.WijzigDouble(value);\r\n            }\r\n        }\r\n\r\n        /// <summary>Tarief voor btw-laag</summary>\r\n        public double _BtwLaag\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_BtwLaag);\r\n                if (bgv == null)\r\n                {\r\n                    _BtwLaag = s_BtwLaagDefault;\r\n                    return s_BtwLaagDefault;\r\n                }\r\n                return bgv.GeefDouble();\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_BtwLaag, EGgvTpe.Numeriek, \"Btw laag\");//NIETVERTALEN\r\n                bgv.WijzigDouble(value);\r\n            }\r\n        }\r\n        /// <summary>\r\n        /// Geef een lijstje met de beschikbare btw tarieven.\r\n        /// Bijv 21% wordt 0.21\r\n        /// </summary>\r\n        public Dictionary<EXto, double> _BtwTarieven\r\n        {\r\n            get\r\n            {\r\n                Dictionary<EXto, double> result = new Dictionary<EXto, double>\r\n                {\r\n                    { EXto.Bgh, _BtwHoog / 100 },\r\n                    { EXto.Bgl, _BtwLaag / 100 }\r\n                };\r\n\r\n                return result;\r\n            }\r\n        }\r\n\r\n        #region BIM-meetstaten\r\n        /// <summary>Toegevoegd t.b.v. BimOnline\r\n        /// </summary>\r\n        public string _BegrotingsGuid\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_BegrotingsGuid);\r\n                if (bgv == null)\r\n                {\r\n                    return string.Empty;\r\n                }\r\n                return bgv.GeefTekst();\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_BegrotingsGuid, EGgvTpe.Tekst, \"Begroting Guid\");//NIETVERTALEN\r\n                bgv.WijzigTekst(value);\r\n            }\r\n        }\r\n\r\n        /// <summary>Toegevoegd t.b.v. BimOnline\r\n        /// </summary>\r\n        public string _ProjectBIMONLINEId\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_BimProjectId);\r\n                if (bgv == null)\r\n                {\r\n                    return string.Empty;\r\n                }\r\n                return bgv.GeefTekst();\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_BimProjectId, EGgvTpe.Tekst, \"id van het project\");//NIETVERTALEN\r\n                bgv.WijzigTekst(value);\r\n            }\r\n        }\r\n        /// <summary>Toegevoegd t.b.v. BimOnline\r\n        /// </summary>\r\n        public string _BimModelId\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_BimModelId);\r\n                if (bgv == null)\r\n                {\r\n                    return string.Empty;\r\n                }\r\n                return bgv.GeefTekst();\r\n            }\r\n            set\r\n            {\r\n\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_BimModelId, EGgvTpe.Tekst, \"id van het model\");//NIETVERTALEN\r\n                bgv.WijzigTekst(value);\r\n            }\r\n        }\r\n        /// <summary>Toegevoegd t.b.v. BimOnline\r\n        /// </summary>\r\n        public string _BimRevision\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_BimRevision);\r\n                if (bgv == null)\r\n                {\r\n                    return string.Empty;\r\n                }\r\n                return bgv.GeefTekst();\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_BimRevision, EGgvTpe.Tekst, \"id van de revisie\");//NIETVERTALEN\r\n                bgv.WijzigTekst(value);\r\n            }\r\n        }\r\n\r\n        #endregion  // BIM-meetstaten\r\n\r\n        public double _BrutoVloerOppervlak\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_BrutoVloerOppervlak);\r\n                if (bgv == null)\r\n                {\r\n                    _BrutoVloerOppervlak = 0.0;\r\n                    return 0.0;\r\n                }\r\n                return bgv.GeefDouble();\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_BrutoVloerOppervlak, EGgvTpe.Numeriek, \"Bruto vloer oppervlak\");//NIETVERTALEN\r\n                bgv.WijzigDouble(value);\r\n            }\r\n        }\r\n        public double _BrutoGebouwInhoud\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_BrutoGebouwInhoud);\r\n                if (bgv == null)\r\n                {\r\n                    _BrutoGebouwInhoud = 0.0;\r\n                    return 0.0;\r\n                }\r\n                return bgv.GeefDouble();\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_BrutoGebouwInhoud, EGgvTpe.Numeriek, \"Bruto gebouw inhoud\");//NIETVERTALEN\r\n                bgv.WijzigDouble(value);\r\n            }\r\n        }\r\n\r\n        public double Levensduur\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_Levensduur);\r\n                if (bgv == null)\r\n                {\r\n                    return Levensduur = 0.0;\r\n                }\r\n                return bgv.GeefDouble();\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_Levensduur, EGgvTpe.Numeriek, \"Levensduur in jaren\");//NIETVERTALEN\r\n                bgv.WijzigDouble(value);\r\n            }\r\n        }\r\n\r\n        public EN15804LifecyclePhases Levensfases\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_Levensfases);\r\n                if (bgv == null)\r\n                {\r\n                    return 0;\r\n                }\r\n                return (EN15804LifecyclePhases)bgv.GeefInt();\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_Levensfases, EGgvTpe.Numeriek, \"Levensfases\");//NIETVERTALEN\r\n                bgv.WijzigInt((int)value);\r\n            }\r\n        }\r\n\r\n        /// <summary>get/set Bgv Property: Btw toepassen\r\n        /// </summary>\r\n        public bool _BtwToepassen\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_BtwToepassen);\r\n                if (bgv != null)\r\n                    return bgv._Wde.Length > 0 && bgv._Wde[0] == 'J';\r\n\r\n                _BtwToepassen = false;\r\n                return false;\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_BtwToepass