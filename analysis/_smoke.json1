 }\r\n\r\n        /// <summary>get/set Eigenschappen van een onderhoud kostenbestand (kostenbestand en parameters)\r\n        /// </summary>\r\n        public BBrinkKostenbestandEigenschappen? _BrinkKostenbestandEigenschappenOnderhoud\r\n        {\r\n            get\r\n            {\r\n                if (m_BrinkKostenbestandEigenschappenOnderhoud == null)\r\n                {\r\n                    BBrinkKostenbestandEigenschappen? kbEigenschappen = new(_KostenbestandEigenschappenOnderhoud, _KostenbestandOnderhoudParameters, DateTime.Now.Year);\r\n\r\n                    if (kbEigenschappen._KostenbestandId != null)\r\n                    {\r\n                        if (KostenbestandInloggen())\r\n                        {\r\n                            if (kbEigenschappen._AltijdLaatsteVersie)\r\n                            {\r\n                                if (!DateTime.TryParse(_Dtm_Toonbaar, out DateTime begrotingDatum))\r\n                                    begrotingDatum = DateTime.Now;\r\n                                kbEigenschappen = _kostenbestandRaadplegen.LeesTegebruikenKostenBestand(kbEigenschappen, begrotingDatum.Year);\r\n                            }\r\n                            else\r\n                            {\r\n                                // Bepaal de wijzigdatum van het kostenbestan op de server\r\n                                BKostenBestand? kostenBestand = _kostenModel?.GeefKostenBestand((Guid)kbEigenschappen._KostenbestandId);\r\n                                if (kostenBestand?.wijzigdatum != null)\r\n                                {\r\n                                    if (kbEigenschappen._Wijzigdatum < kostenBestand.wijzigdatum)\r\n                                    {\r\n                                        kbEigenschappen._Wijzigdatum = kostenBestand.wijzigdatum;\r\n                                        _KostenbestandEigenschappenOnderhoud = kbEigenschappen._Identificatie;\r\n                                    }\r\n\r\n                                }\r\n                                else\r\n                                {\r\n                                    // Geen kostenbestand gevonden!!\r\n                                    // Het aanwezige kostenbestand in tact houden.\r\n                                }\r\n                            }\r\n\r\n                            if (_KostenbestandOnderhoudParameters != null)\r\n                            {\r\n                                m_BrinkKostenbestandEigenschappenOnderhoud = new BBrinkKostenbestandEigenschappen(kbEigenschappen?._Identificatie,\r\n                                                                                                                  _KostenbestandOnderhoudParameters, kbEigenschappen?._MJOBJaar ?? 0);\r\n                            }\r\n                        }\r\n                    }\r\n                    m_BrinkKostenbestandEigenschappenOnderhoud = kbEigenschappen;\r\n\r\n                }\r\n\r\n\r\n                return m_BrinkKostenbestandEigenschappenOnderhoud;\r\n            }\r\n            set\r\n            {\r\n                m_BrinkKostenbestandEigenschappenOnderhoud = value;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// Bepalen of de mjobcontantewaarde actueel is.\r\n        /// </summary>\r\n        public bool _MjobContanteWaardeIsActueel { set\r\n            {\r\n                bool uiVerversen = !value && field;\r\n                field = value;\r\n\r\n                if (uiVerversen)\r\n                {\r\n                    // EENMALIG UI VERVERSEN.\r\n                    int index = 0;\r\n                    ResetMjobContanteWaarde(_REl, ref index);\r\n                }\r\n\r\n            }\r\n            get\r\n            {\r\n                // De MjobContanteWaarde is altijd actueel bij actief doorrekenen, anders wanneer de variable op true staat.\r\n                if (_BrinkKostenbestandEigenschappenOnderhoud?._MJO