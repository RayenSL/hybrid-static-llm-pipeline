MeetstaatKoppelingen { get => field ??= new BBewaarItemVzl<BMeetstaatKoppeling>(); private set; }\r\n\r\n        public List<IMeetstaat> _Meetstaten { get => field ??= new List<IMeetstaat>(); private set; }\r\n\r\n        public IList<IMeetstaat> _VerwijderdeMeetstaten => field ??= new List<IMeetstaat>();\r\n\r\n        public EViewKey _ViewNr { get; set; }\r\n        public string _DocumentSoort => ProjectResources.TradC1172511512714;\r\n        public string _DocumentSoortLidwoord => ProjectResources.TradC1172511512715;\r\n\r\n        public bool _KlantkortingToepassen\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_KlantkortingToepassen);\r\n                if (bgv != null)\r\n                    return bgv._Wde == BStatics.c_Ja;\r\n\r\n                _KlantkortingToepassen = false;\r\n                return false;\r\n            }\r\n            set\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_KlantkortingToepassen, EGgvTpe.Tekst, \"Klantkorting toepassen\"); //NIETVERTALEN\r\n                bgv._Wde = value ? BStatics.c_Ja : BStatics.c_Nee;\r\n            }\r\n        }\r\n\r\n        public string _OpgeslagenDoorVersie\r\n        {\r\n            get\r\n            {\r\n                BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(BBegrotingsGegeven.c_OpgeslagenDoorVersie);\r\n                if (bgv != null)\r\n                    return bgv._Wde;\r\n\r\n                return string.Empty;\r\n            }\r\n            set\r\n            {\r\n                if (!string.IsNullOrEmpty(value))\r\n                {\r\n                    BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_OpgeslagenDoorVersie, EGgvTpe.Tekst, \"Opgeslagen door versie\"); //NIETVERTALEN\r\n                    bgv._Wde = value;\r\n                }\r\n            }\r\n        }\r\n\r\n        public BRekenMeldingen RekenMeldingen { get; } = new BRekenMeldingen();\r\n\r\n        public IBegrotingBerekendHandler BegrotingBerekendHandler { get; set; } = default!;\r\n        public IMeetstaatLezer MeetstaatLezer { get; set; } = default!;\r\n        public bool? MiddelBeHoudenBijGeneriekClipboard { get; set; }\r\n        public BOpdrachtContext? OpdrachtContext { get; set; }\r\n\r\n        #region Project Begroting informatie\r\n        public int _Frequentie { get; set; }\r\n        public int _InvoegIndicatie { get; set; }\r\n        public int _ActualisatieIndicatie { get; set; }\r\n        public int _TotaalIndicatie { get; set; }\r\n        public int _ProjectId { get; set; }\r\n        public double _ProjectTotaal\r\n        {\r\n            get\r\n            {\r\n                double projectTotaal = 0.0;\r\n                if (_InvoegIndicatie > 0)\r\n                {\r\n                    projectTotaal = _BgrBto.Waarde * _Frequentie;\r\n                }\r\n                return projectTotaal;\r\n            }\r\n        }\r\n        #endregion Project Begroting informatie\r\n\r\n        #endregion\r\n\r\n        #region Property-achtige memberfuncties\r\n\r\n        public BBedrag GeefXtoKst(EXto xto, EKst kst)\r\n        {\r\n            return _XtoKst[xto, kst];\r\n        }\r\n        public void LeesMiddelFunctie(LeesMiddelDlgte dlgte)\r\n        {\r\n            m_LeesMiddel = dlgte;\r\n        }\r\n        public void LeesMetingFunctie(LeesMetingDlgte dlgte)\r\n        {\r\n            m_LeesMeting = dlgte;\r\n        }\r\n        public void LeesMetingGuidFunctie(LeesMetingGuidDlgte dlgte)\r\n        {\r\n            m_LeesMetingGuid = dlgte;\r\n        }\r\n        public void VraagKopieerKoppelingFunctie(VraagKopieerKoppelingDlgte dlgte)\r\n        {\r\n            m_VraagKopieerKoppeling = dlgte;\r\n        }\r\n        internal VraagKopieerKoppelingDlgte? VraagKopieerKoppelingFunctie()\r\n        {\r\n            return m_VraagKopieerKoppeling;\r\n        }\r\n\r\n        public int GeefNieuwId()\r\n        {\r\n            m_MaxId ??= _maxIdBepaler.BepaalMaxId(this);\r\n\r\n            m_MaxId += 1;\r\n            return m_MaxId.Value;\r\n        }\r\n        /// <summary>Bepaal of de begroting meerdere valuta's (naast de ingestelde basisvaluta) in gebruik heeft\r\n        /// </summary>\r\n        /// <param name=\"basisValutaId\">De id van de basisvaluta (de algemene valuta van de begroting)</param>\r\n        /// <returns>true indien er naast de basisvaluta nog andere valuta's gebruikt worden anders false</returns>\r\n        public bool HeeftMeerdereValuta()\r\n        {\r\n            bool heeftMeerdereValuta = false;\r\n            foreach (BMiddel middel in _Mid)\r\n            {\r\n                if (middel._VltId != _VltId)\r\n                {\r\n                    heeftMeerdereValuta = true;\r\n                    break;\r\n                }\r\n            }\r\n            return heeftMeerdereValuta;\r\n        }\r\n        /// <summary>Bepaal of een valuta in gebruik is in de begroting\r\n        /// </summary>\r\n        /// <param name=\"valutaId\">De id van de valuta welke bepaald moet worden</param>\r\n        /// <returns>true indien de valutaid in een middel gebruikt wordt of als het de basisvaluta is anders false</returns>\r\n        public bool IsValutaInGebruik(int valutaId)\r\n        {\r\n            bool valutaInGebruik = false;\r\n\r\n            if (valutaId == _VltId)\r\n            {\r\n                valutaInGebruik = true; // De basisvaluta is altijd in gebruik en mag niet verwijderd worden\r\n            }\r\n            else\r\n            {\r\n                foreach (BMiddel middel in _Mid)\r\n                {\r\n                    if (middel._VltId == valutaId)\r\n                    {\r\n                        valutaInGebruik = true;\r\n                        break;\r\n                    }\r\n                }\r\n            }\r\n            return valutaInGebruik;\r\n        }\r\n\r\n        public BBedrag GeefStdUurloon()\r\n        {\r\n            BUurloonBVzl ulnVzl = (BUurloonBVzl)_REl._Uln;\r\n            return ulnVzl.GeefUurTarief(string.Empty, true);\r\n        }\r\n\r\n        /// <summary>\r\n        ///Geef het hoogste element-niveau uit de begroting.\r\n        /// </summary>\r\n        public int GeefHoogsteElNiveau()\r\n        {\r\n            return _Stu.HoogsteEltNiveau();\r\n        }\r\n\r\n        /// <summary>\r\n        /// Geef het hoogste element-niveau uit een selectie van de begroting.\r\n        /// </summary>\r\n        /// <returns></returns>\r\n        public int GeefHoogsteElNiveau(BSelectie selectie)\r\n        {\r\n            return _Stu.HoogsteEltNiveau(selectie);\r\n        }\r\n\r\n        public void UiVerverst(ref int viewVersie)\r\n        {\r\n            viewVersie = m_Versie;\r\n            m_Versie++;\r\n        }\r\n        public void UserInterface(IUserInterface interfaceWaarde)\r\n        {\r\n            _UserInterface = interfaceWaarde;\r\n        }\r\n        public bool ControleerOpVastPrijsIndicatie()\r\n        {\r\n            bool returnValue = false;\r\n            IList<IBegrotingsRegel> elts = _Stu.GeefBgrRegels((int)EOnderbouwing.Element);\r\n            if (elts.Where(item => ((BElement)item)._VastPrijs == true).ToList().Count > 0)\r\n                returnValue = true;\r\n            return returnValue;\r\n        }\r\n        public bool HeeftKostenbestandOnderhoud()\r\n        {\r\n            return m_BrinkKostenbestandEigenschappenOnderhoud != null &&\r\n                   m_BrinkKostenbestandEigenschappenOnderhoud._KostenbestandId != Guid.Empty &&\r\n                   m_BrinkKostenbestandEigenschappenOnderhoud._KostenbestandId != null;\r\n        }\r\n\r\n        #endregion\r\n\r\n        #region Constructor\r\n        public BBegroting(string naam, BDocValuta basisValuta, IMaxIdBepaler maxIdBepaler)\r\n        {\r\n            _DocumentNaam = string.IsNullOrWhiteSpace(naam)\r\n                ? $\"{ProjectResources.TradC1172511512714}{BStatics.c_Spatie}{++m_NaamNummer}\"\r\n                : naam.SaneerTekst();\r\n\r\n            Debug.Assert(basisValuta._ValutaVzl != null, \"basisValuta._ValutaVzl is null\");\r\n            Debug.Assert(basisValuta._ValutaVzl[0] == basisValuta, \"basisValuta._ValutaVzl[0] is niet basisValuta\");\r\n\r\n            BegrotingsValuta = basisValuta._ValutaVzl;\r\n            m_BasisValuta = basisValuta;\r\n            _maxIdBepaler = maxIdBepaler;\r\n\r\n            NieuweBegroting();\r\n        }\r\n\r\n        public BBegroting(string naam, EBgrTpe tpe, double totuur, string dtm, BXtoKst xtokst, BDocValuta basisValuta, IMaxIdBepaler maxIdBepaler)\r\n        {\r\n            _DocumentNaam = naam.SaneerTekst();\r\n\r\n            Debug.Assert(BegrotingsValuta == null, \"BBegroting de ValutaVzl mag niet op deze manier gewijzigd worden\");\r\n            Debug.Assert(basisValuta._ValutaVzl != null, \"_ValutaVzl is null mag niet toegekend worden\");\r\n\r\n            BegrotingsValuta = basisValuta._ValutaVzl;\r\n            _maxIdBepaler = maxIdBepaler;\r\n\r\n            Debug.Assert(m_BasisValuta == null, \"BBegroting de basisvaluta mag niet op deze manier gewijzigd worden\");\r\n            Debug.Assert(basisValuta != null, \"basisValuta is null mag niet toegekend worden\");\r\n\r\n            m_BasisValuta = basisValuta;\r\n            ZetBegrotingType(tpe);\r\n            m_TotUur = totuur;\r\n            m_Dtm = dtm;\r\n            m_XtoKst = xtokst;\r\n\r\n            m_Mid = new BMiddelen(this);\r\n            m_Bgv = new BBegrotingsGegevenVzl();\r\n            m_Ggv = new BGebruikersGegevenVzl();\r\n\r\n            m_RawInfo = new BRawInfo(m_Bgv);\r\n            m_RawInfo.ZetRawBegroting(m_Tpe == EBgrTpe.Raw);\r\n            _OpdrachtVzl = new BOpdrachtVzl(this, 0);\r\n\r\n            m_Umc = -1;            // -1: onbepaald, moet nog worden opgezocht in m_Bgv\r\n        }\r\n\r\n        public void Instellen(string naam, EBgrTpe tpe, double totuur, string dtm, BXtoKst xtokst, BDocValuta basisValuta)\r\n        {\r\n            _DocumentNaam = naam.SaneerTekst();\r\n            ZetBegrotingType(tpe);\r\n            m_TotUur = totuur;\r\n            m_Dtm = dtm;\r\n            m_XtoKst = xtokst;\r\n\r\n            InstellenBasisValuta(basisValuta);\r\n        }\r\n\r\n        private void InstellenBasisValuta(BDocValuta basisValuta)\r\n        {\r\n            if (basisValuta == null || BegrotingsValuta.Count == 0)\r\n                return;\r\n\r\n            m_BasisValuta = ((BDocValuta)BegrotingsValuta[0]).GeefValutaDeco(basisValuta._Aanduiding, false) as BDocValuta;\r\n        }\r\n\r\n        public IBegroting KopierenExclusiefRegels()\r\n        {\r\n            BBegroting orig = this;\r\n\r\n            BDocValuta docValuta = BDocValuta.MaakValuta(orig.BegrotingsValuta, orig._BasisValuta?._VltId ?? 0, orig._BasisValuta?._Aanduiding, orig._BasisValuta?._Koers ?? 0, orig._BasisValuta?._Omschrijving, orig._BasisValuta?._Teken, orig._BasisValuta?._Datum ?? default);\r\n            foreach (BValutaDeco valuta in docValuta._ValutaVzl)\r\n            {\r\n                valuta.ZetMutatieStatus(BewaarItemMutatieStatus.Nieuw);\r\n            }\r\n\r\n            BBegroting kopie = new BBegroting(orig._DocumentNaam, orig.m_Tpe, orig.m_TotUur, _statics.GeefHuidigeTijd(),\r\n                new BXtoKst(orig._VltId, docValuta._ValutaVzl), docValuta, new BegrotingMaxIdBepaler());\r\n            kopie.m_Oms = orig.m_Oms;\r\n            kopie.m_Umc = orig.m_Umc;\r\n\r\n            kopie._Bbd = new BBegrotingBlad(kopie, orig._Bbd);\r\n            kopie._OpdrachtVzl = new BOpdrachtVzl(kopie, 0);\r\n            kopie.m_Bgv = new BBegrotingsGegevenVzl(orig.m_Bgv);\r\n            kopie.m_Ggv = new BGebruikersGegevenVzl(orig.m_Ggv);\r\n            kopie.m_Stu = new BStructuur(kopie);\r\n            kopie.VasttotaalId = 0;    // Nog geen sjoemelpost aangewezen\r\n\r\n            // Rootelement aanmaken:\r\n            BElement rootEl = new(c_RElId, kopie._VltId, kopie);\r\n            rootEl.WijzigHoeveelheid(1.0);\r\n            rootEl.WijzigString(BBegrotingsRegel.EGegeven.oms, orig._REl._Oms, out _);\r\n            BStructuurRegel stuRegel = new BStructuurRegel(rootEl, 0);\r\n            kopie._Stu.Toevoegen(stuRegel);\r\n\r\n            // Standaard uurloon overnemen\r\n            BUurloonBVzl ulnVzlOrig = (BUurloonBVzl)orig._REl._Uln;\r\n            BUurloonBVzl ulnVzl = (BUurloonBVzl)rootEl._Uln;\r\n            ulnVzl.KopieerUurlonen(ulnVzlOrig, docValuta._ValutaVzl);\r\n\r\n            return kopie;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Bij het aanmaken van een nieuwe begroting wordt valutaID op default gezet. \r\n        /// Deze functie zet valuta op de gewenste waarde\r\n        /// </summary>\r\n        /// <param name=\"vltid\">ID van de gewenste begrotingvaluta</param>\r\n        private void ZetValuta(int vltid)\r\n        {\r\n            m_XtoKst = new BXtoKst(vltid, BegrotingsValuta);\r\n            _REl.ZetValuta(vltid, BegrotingsValuta);\r\n        }\r\n        private void NieuweBegroting()\r\n        {\r\n            m_XtoKst = new BXtoKst(_VltId, BegrotingsValuta);\r\n            m_Tpe = EBgrTpe.Traditioneel;\r\n            m_Dtm = _statics.GeefHuidigeTijd();\r\n            m_Oms = string.Empty;\r\n\r\n            // Structuur aanmaken - komt nu niet uit de database\r\n            m_Stu = new BStructuur(this);\r\n\r\n            // Rootelement aanmaken:\r\n            BElement rootEl = new BElement(c_RElId, _VltId, this);\r\n            rootEl.WijzigHoeveelheid(1.0);\r\n            BStructuurRegel stuRegel = new BStructuurRegel(rootEl, 0);\r\n            _Stu.Toevoegen(stuRegel);\r\n\r\n            // Gesorteerde lijst met middelen aanmaken\r\n            // Tevens (lege) lijst met verzamelposten, uurlonen en gebruikergegevens maken\r\n            m_Mid = new BMiddelen(this);\r\n            m_Bgv = new BBegrotingsGegevenVzl();\r\n            m_Ggv = [];\r\n            m_RawInfo = new BRawInfo(m_Bgv);\r\n\r\n            const double StandaardUurTarief = 40.0;\r\n            BUurloonB standaardUurloon = new BUurloonB(string.Empty, new BBedrag(0, StandaardUurTarief), 0.00);\r\n            standaardUurloon._Oms = ProjectResources.StandaardUurloon;\r\n            _REl?._Uln.ToevoegenUurloon(standaardUurloon);\r\n\r\n            // De set-functie van _Umc gebruikt m_Bgv, daarom moet\r\n            // dit na het aanmaken van de BBegrotingsGegevenVzl komen.\r\n            _Umc_Private = false;\r\n\r\n            _VastPrijsToepassen = false;\r\n            _BtwToepassen = false;\r\n            _VasteHoeveelheidIndicatieToepassen = false;\r\n\r\n            // Tbv UNDO\r\n            _OpdrachtVzl = new BOpdrachtVzl(this, 0);\r\n\r\n            // De set-functie van property _Bbd gebruikt m_OpdrachtVzl, daarom moet\r\n            // dit na het aanmaken van de BOpdrachtVzl komen.\r\n            _Bbd = new BBegrotingBlad(this);\r\n            BegrotingspostenToepassen = false;                     // false: begrotingblad werkt NIET met begrotingsposten (default)\r\n            _Bbd._BgrPostToepassen = BegrotingspostenToepassen;    // mededelen aan begrotingblad\r\n        }\r\n        #endregion\r\n\r\n        #region Opdrachten algemeen\r\n        /// <summary>\r\n        /// Is er iets gewijzigd in de begroting (sinds de laatste aanroep van WijzigingenOpgeslagen())?\r\n        /// </summary>\r\n        /// <returns>true indien wijzigingen zijn</returns>\r\n        public bool IsGewijzigd()\r\n        {\r\n            return _OpdrachtVzl.IsGewijzigd() || Documenten.HeeftGewijzigdeDocumenten();\r\n        }\r\n        public int GeefToestand()\r\n        {\r\n            return _OpdrachtVzl.GeefToestand();\r\n        }\r\n        /// <summary>\r\n        /// De (nieuwe of gewijzigde) begroting is opgeslagen.\r\n        /// Uitgevoerde opdrachten kunnen niet meer ongedaan gemaakt worden.\r\n        /// </summary>\r\n        public void Opgeslagen()\r\n        {\r\n            _OpdrachtVzl.Wissen(true);   // true: wijzigingen tot nu toe zijn opgeslagen\r\n        }\r\n        /// <summary>\r\n        /// Er is een actie geweest waarvoor geen UNDO is geprogrammeerd\r\n        /// Uitgevoerde opdrachten kunnen niet meer ongedaan gemaakt worden.\r\n        /// </summary>\r\n        public void OpdrachtenVergeten()\r\n        {\r\n            _OpdrachtVzl.Wissen(false);   // false: wijzigingen tot nu toe zijn niet opgeslagen\r\n        }\r\n        public void GewijzigdGeenOpdracht()\r\n        {\r\n            _OpdrachtVzl.Gewijzigd();     // Er is iets buiten de opdrachten om gewijzigd (bijv. opmaak)\r\n        }\r\n        public void RegistreerOpdrachten(bool registreren)\r\n        {\r\n            m_Snel = !registreren;\r\n            if (registreren)\r\n            {\r\n                _OpdrachtVzl.Wissen(false);\r\n                Rekenen(ERekendiepte.Volledig);\r\n            }\r\n            else\r\n            {\r\n                _OpdrachtVzl.Wissen(false);\r\n            }\r\n            _OpdrachtVzl._Registreer = registreren;\r\n        }\r\n        public void OpdrachtAanmelden(BOpdracht opdracht)\r\n        {\r\n            opdracht._ViewNr = _ViewNr;\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n        }\r\n        public void OpdrachtUitvoeren(BOpdracht opdracht, bool uitvoeren)\r\n        {\r\n            opdracht._ViewNr = _ViewNr;\r\n            if (uitvoeren)\r\n                _OpdrachtVzl.Uitvoeren(opdracht);\r\n            else\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n        }\r\n        public bool OpdrachtUitvoeren(BOpdracht opdracht)\r\n        {\r\n            EViewKey viewnr = _ViewNr;\r\n\r\n            // Aan de hand van de base class van het type opdracht moet het correcte view nr door-gegeven worden.\r\n            if (opdracht is MeetstaatOpdrachtBase)\r\n            {\r\n                //EBegrotingControl.MeetGridInMeetstaatView (ik ben tot de conclusie gekomen dat hiermee niks hoeft te doen\r\n                //omdat als het meetstaat zwevend is deze overal zwevend blijft. js\r\n                if (viewnr == EViewKey.BegrGridInKlassiekeView)\r\n                {\r\n                    opdracht._ViewNr = EViewKey.MeetGridInKlassiekView;\r\n                }\r\n                else\r\n                {\r\n                    //if (viewnr == (int)EBegrotingControl.BegrGridInVerkennerView)\r\n                    //{\r\n                    //    opdracht._ViewNr = (int)EBegrotingControl.MeetGridInVerkennerView;\r\n                    //}\r\n                    //else\r\n                    //{\r\n                    opdracht._ViewNr = _ViewNr;\r\n                    //}\r\n                }\r\n            }\r\n            else\r\n            {\r\n                opdracht._ViewNr = _ViewNr;\r\n            }\r\n            return _OpdrachtVzl.Uitvoeren(opdracht);\r\n        }\r\n        public bool GroepeerOpdrachten()\r\n        {\r\n            bool nieuweGroepeerOpdracht = false;\r\n            if (!m_GroepeerOpdrachten)\r\n            {\r\n                _OpdrachtVzl.GroepeerOpdrachten();\r\n                m_GroepeerOpdrachten = true;\r\n                nieuweGroepeerOpdracht = true;\r\n            }\r\n            return nieuweGroepeerOpdracht;\r\n        }\r\n        public void GroepeerOpdrachten(string omschrijving)\r\n        {\r\n            GroepeerOpdrachten(_ViewNr, omschrijving);\r\n        }\r\n        public BOpdracht? GroepeerOpdrachten(EViewKey viewNr, string omschrijving)\r\n        {\r\n            BOpdracht? opdracht = _OpdrachtVzl.GroepeerOpdrachten(omschrijving);\r\n            m_GroepeerOpdrachten = false;\r\n            if (opdracht != null)\r\n            {\r\n                if (viewNr >= 0)\r\n                    opdracht.SetView(viewNr);\r\n                Rekenen(ERekendiepte.Wijzigingen);\r\n            }\r\n            return opdracht;\r\n        }\r\n        #endregion   // Opdrachten algemeen\r\n\r\n        #region Mutatiestatus\r\n\r\n        public void ZetMutatiestatusOngewijzigd()\r\n        {\r\n            if (_Stu != null)\r\n            {\r\n                int aantalRegels = _Stu._Aantal;\r\n                for (int rglNr = 0; rglNr < aantalRegels; rglNr++)\r\n                {\r\n                    BStructuurRegel stuRegel = _Stu[rglNr];\r\n                    if (stuRegel._Regel == null)\r\n                    {\r\n                        continue;\r\n                    }\r\n\r\n                    stuRegel._Regel.ZetMutatieStatus(BewaarItemMutatieStatus.Ongewijzigd);\r\n                    stuRegel._Regel._Meting?.ZetMutatieStatus(BewaarItemMutatieStatus.Ongewijzigd);\r\n\r\n                }\r\n                UittrekstaatKoppelingen.ZetAlleStatussen(BewaarItemMutatieStatus.Ongewijzigd); //TODO_US: line was in loop above, seems odd, test if this is fine here.\r\n            }\r\n\r\n            foreach (BMiddel middel in _Mid._Lijst)\r\n            {\r\n                middel.ZetMutatieStatus(BewaarItemMutatieStatus.Ongewijzigd);\r\n            }\r\n\r\n            foreach (BMeetstaat meetstaat in _Meetstaten)\r\n            {\r\n                meetstaat.ZetMutatieStatus(BewaarItemMutatieStatus.Ongewijzigd);\r\n                foreach (BMeetstaatRegel meetstaatRegel in meetstaat._Regels)\r\n                {\r\n                    meetstaatRegel._Meting?.ZetMutatieStatus(BewaarItemMutatieStatus.Ongewijzigd);\r\n                }\r\n            }\r\n\r\n            foreach (IMeetstaatModel model in _MeetstaatModelVzl._Modellen)\r\n            {\r\n                model.ZetMutatieStatus(BewaarItemMutatieStatus.Ongewijzigd);\r\n            }\r\n\r\n            foreach (BUurloonB uurloonB in GeefUurloonBVzl())\r\n            {\r\n                uurloonB.ZetMutatieStatus(BewaarItemMutatieStatus.Ongewijzigd);\r\n            }\r\n\r\n            foreach (BValutaDeco begrotingsValuta in BegrotingsValuta)\r\n            {\r\n                begrotingsValuta.ZetMutatieStatus(BewaarItemMutatieStatus.Ongewijzigd);\r\n            }\r\n\r\n            _MeetstaatKoppelingen.MutatiesVerwerkt();\r\n\r\n            Documenten.ZetMutatieStatus(BewaarItemMutatieStatus.Ongewijzigd);\r\n        }\r\n        #endregion  // Mutatiestatus3\r\n\r\n        #region Functies die opdrachten aanmaken\r\n        /// <summary>\r\n        /// Indexeer de begroting aan de hand van de gegevens uit de registry\r\n        /// De begroting wordt opnieuw doorgerekend\r\n        /// </summary>\r\n        ///\r\n        public BOpdracht? Indexeren(BSelectie selectie, IFCTabel tabel, bool klassiek)\r\n        {\r\n            var opdracht = new IndexerenOpdracht(this, selectie, tabel, klassiek);\r\n            if (opdracht.Uitvoeren(null))\r\n            {\r\n                Rekenen(ERekendiepte.Volledig);\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n                return opdracht;\r\n            }\r\n            return null;\r\n        }\r\n        public BOpdracht? KopieerBegrotingsRegels(IBegroting bgr, int stuIndexOrig, int aantal, int stuIndexDoel, BOpdracht? opdracht, bool controleerBimMetingen) // SGB_SAMENVOEGEN\r\n        {\r\n            return KopieerBegrotingsRegels(bgr, stuIndexOrig, aantal, stuIndexDoel, false, opdracht, false, controleerBimMetingen);\r\n        }\r\n        /// <summary>\r\n        /// Kopieer een of meerdere begrotingsregels\r\n        /// </summary>\r\n        /// <param name=\"bgr\">De begroting waar de originele regels staan (mag ook de huidige begroting zijn)</param>\r\n        /// <param name=\"stuIndexOrig\">De index van het structuurelement behorend bij de eerste originele regel</param>\r\n        /// <param name=\"aantal\">Het aantal regels dat gekopieerd moet worden</param>\r\n        /// <param name=\"stuIndexDoel\">De bestemming in de huidige begroting voor de gekopieerde regels</param>\r\n        public BOpdracht? KopieerBegrotingsRegels(IBegroting bgr, int stuIndexOrig, int aantal, int stuIndexDoel)\r\n        {\r\n            return KopieerBegrotingsRegels(bgr, stuIndexOrig, aantal, stuIndexDoel, false, null, false, true);\r\n        }\r\n        public BOpdracht? KopieerBegrotingsRegels(IBegroting bgr, int stuIndexOrig, int aantal, int stuIndexDoel, bool verwerkProductieFactor)\r\n        {\r\n            return KopieerBegrotingsRegels(bgr, stuIndexOrig, aantal, stuIndexDoel, false, null, verwerkProductieFactor, true);\r\n        }\r\n        /// <summary>\r\n        /// Kopieer een of meerdere begrotingsregels\r\n        /// </summary>\r\n        /// <param name=\"bgr\">De begroting waar de originele regels staan (mag ook de huidige begroting zijn)</param>\r\n        /// <param name=\"stuIndexOrig\">De index van het structuurelement behorend bij de eerste originele regel</param>\r\n        /// <param name=\"aantal\">Het aantal regels dat gekopieerd moet worden</param>\r\n        /// <param name=\"stuIndexDoel\">De bestemming in de huidige begroting voor de gekopieerde regels</param>\r\n        public BOpdracht? KopieerBegrotingsRegels(IBegroting bgr, int stuIndexOrig, int aantal, int stuIndexDoel, bool bbdSectie, ref BMeetstaat.EKopieerKoppeling kopieerKoppeling)\r\n        {\r\n            Debug.Assert(m_Stu != null, \"BBegroting.KopieerBegrotingsRegels() - geen structuurlijst\");\r\n            Debug.Assert(bgr._Stu != null, \"BBegroting.KopieerBegrotingsRegels() - geen structuurlijst\");\r\n            Debug.Assert(stuIndexDoel > 0 && stuIndexDoel <= _Stu._Aantal, \"BBegroting.KopieerBegrotingsRegels() - doel-index verkeerd\");\r\n            Debug.Assert(stuIndexOrig > 0 && stuIndexOrig < bgr._Stu._Aantal, \"BBegroting.KopieerBegrotingsRegels() - orig-index verkeerd\");\r\n            Debug.Assert(aantal > 0 && stuIndexOrig + aantal <= bgr._Stu._Aantal, \"BBegroting.KopieerBegrotingsRegels() - aantal verkeerd\");\r\n\r\n            if (aantal > 0)\r\n            {\r\n                BSelectie selectie = new BSelectie(stuIndexOrig, stuIndexOrig + aantal);\r\n                KopieerBegrotingRegelsOpdracht opdracht = new KopieerBegrotingRegelsOpdracht(this, bgr, selectie, bbdSectie);\r\n                opdracht.StuIndexDoel = stuIndexDoel;\r\n                if (kopieerKoppeling != BMeetstaat.EKopieerKoppeling.Onbekend)\r\n                    opdracht.KopieerKoppeling = kopieerKoppeling;\r\n\r\n                if (KopieerBegrotingsRegels(opdracht) != null)\r\n                {\r\n                    if (kopieerKoppeling == BMeetstaat.EKopieerKoppeling.Onbekend &&\r\n                        (opdracht.MeetstaatGevondenKlassiek || opdracht.MeetstaatGevondenBimOnline || opdracht.MeetstaatGevondenIbisMeten))\r\n                        kopieerKoppeling = opdracht.KopieerKoppeling;\r\n                    return opdracht;\r\n                }\r\n            }\r\n            return null;\r\n        }\r\n\r\n        public BOpdracht? KopieerBegrotingsRegels(IBegroting bgr, int stuIndexOrig, int aantal, int stuIndexDoel, bool bbdSectie, BOpdracht? vorigeOpdracht,\r\n           bool verwerkProductieFactor, bool controleerBimMetingen)  // SGB_SAMENVOEGEN\r\n        {\r\n            Debug.Assert(m_Stu != null, \"BBegroting.KopieerBegrotingsRegels() - geen structuurlijst\");\r\n            Debug.Assert(bgr._Stu != null, \"BBegroting.KopieerBegrotingsRegels() - geen structuurlijst\");\r\n            Debug.Assert(stuIndexDoel >= 0 && stuIndexDoel <= _Stu._Aantal, \"BBegroting.KopieerBegrotingsRegels() - doel-index verkeerd\");\r\n            Debug.Assert(stuIndexOrig >= 0 && stuIndexOrig < bgr._Stu._Aantal, \"BBegroting.KopieerBegrotingsRegels() - orig-index verkeerd\");\r\n            Debug.Assert(aantal > 0 && stuIndexOrig + aantal <= bgr._Stu._Aantal, \"BBegroting.KopieerBegrotingsRegels() - aantal verkeerd\");\r\n\r\n            if (aantal > 0)\r\n            {\r\n                var selectie = new BSelectie(stuIndexOrig, stuIndexOrig + aantal);\r\n                var opdracht = new KopieerBegrotingRegelsOpdracht(this, bgr, selectie, bbdSectie, vorigeOpdracht, verwerkProductieFactor);\r\n                opdracht.StuIndexDoel = stuIndexDoel;\r\n                opdracht.ControleerBimMetingen = controleerBimMetingen;\r\n                return KopieerBegrotingsRegels(opdracht);\r\n            }\r\n            return null;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Kopieer een of meerdere begrotingsregels\r\n        /// </summary>\r\n        /// <param name=\"bgr\">De begroting waar de originele regels staan (mag ook de huidige begroting zijn)</param>\r\n        /// <param name=\"selectie\">De (evt. discontinue) selectie van begrotingsregels in het origineel</param>\r\n        /// <param name=\"stuIndexDoel\">De bestemming in de huidige begroting voor de gekopieerde regels</param>\r\n        /// <param name=\"eltId\">ID van het element waarheen de regels gekopieerd moeten worden.\r\n        /// Zet deze op -1 als de stuIndexDoel bekend is</param>\r\n        public BOpdracht? KopieerBegrotingsRegels(IBegroting bgr, BSelectie selectieOrig, int stuIndexDoel, int eltId)\r\n        {\r\n            return KopieerBegrotingsRegels(bgr, selectieOrig, stuIndexDoel, eltId, false, stil: false);\r\n        }\r\n        public BOpdracht? KopieerBegrotingsRegels(IBegroting bgr, BSelectie selectieOrig, int stuIndexDoel, int eltId, bool bbdSectie, bool stil)\r\n        {\r\n            Debug.Assert(m_Stu != null, \"BBegroting.KopieerBegrotingsRegels() - geen structuurlijst\");\r\n            Debug.Assert(bgr._Stu != null, \"BBegroting.KopieerBegrotingsRegels() - geen structuurlijst\");\r\n            // Debug.Assert((stuIndexDoel > 0 && stuIndexDoel <= _Stu._Aantal) || eltId >= BBegroting.c_RElId, \"BBegroting.KopieerBegrotingsRegels() - doel-index of element-id verkeerd\");\r\n            //js volgens mij vervalt deze debug assert\r\n            KopieerBegrotingRegelsOpdracht opdracht = new KopieerBegrotingRegelsOpdracht(this, bgr, selectieOrig, bbdSectie)\r\n            {\r\n                StuIndexDoel = stuIndexDoel,\r\n                PrtIdDoel = eltId,\r\n                Stil = stil\r\n            };\r\n            return KopieerBegrotingsRegels(opdracht);\r\n        }\r\n        /// <summary>\r\n        /// Kopieer een of meerdere begrotingsregels naar het eind van de begroting\r\n        /// </summary>\r\n        /// <param name=\"bgrOrig\">De begroting waar de originele regels staan (mag ook de huidige begroting zijn)</param>\r\n        /// <param name=\"stuIndicesOrig\">Een lijst met structuurlijstindices van de originele begroting (volgorde is relevant)</param>\r\n        /// <param name=\"stuIndexDoel\">De bestemming in de huidige begroting voor de gekopieerde regels</param>\r\n        /// <param name=\"eltId\">ID van het element waarheen de regels gekopieerd moeten worden.\r\n        /// Zet deze op -1 als de stuIndexDoel bekend is</param>\r\n        public BOpdracht? KopieerBegrotingsRegels(IBegroting bgrOrig, IList<int> stuIndicesOrig, int stuIndexDoel, int eltId, bool bbdSectie)\r\n        {\r\n            Debug.Assert(m_Stu != null, \"BBegroting.KopieerBegrotingsRegels() - geen structuurlijst\");\r\n            Debug.Assert(bgrOrig._Stu != null, \"BBegroting.KopieerBegrotingsRegels() - geen structuurlijst\");\r\n            Debug.Assert((stuIndexDoel > 0 && stuIndexDoel <= _Stu._Aantal) || eltId >= BBegroting.c_RElId, \"BBegroting.KopieerBegrotingsRegels() - doel-index of element-id verkeerd\");\r\n\r\n            BSelectie selectie = new BSelectie();\r\n            foreach (int stuIndex in stuIndicesOrig)\r\n            {\r\n                selectie.Toevoegen(stuIndex);\r\n            }\r\n\r\n            KopieerBegrotingRegelsOpdracht opdracht = new KopieerBegrotingRegelsOpdracht(this, bgrOrig, selectie, bbdSectie, stuIndicesOrig);\r\n            opdracht.StuIndexDoel = stuIndexDoel;\r\n            opdracht.PrtIdDoel = eltId;\r\n            return KopieerBegrotingsRegels(opdracht);\r\n        }\r\n        /// <summary>\r\n        /// Kopieer een of meerdere begrotingsregels\r\n        /// </summary>\r\n        /// <param name=\"opdracht\">Opdrachtobject met gegevens die nodig zijn om een aantal regels te kopi?ren</param>\r\n        public BOpdracht? KopieerBegrotingsRegels(KopieerBegrotingRegelsOpdracht opdracht)\r\n        {\r\n            if (!opdracht.Uitvoeren(null))\r\n                return null;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n            return opdracht;\r\n        }\r\n\r\n        public bool VervangMiddel(BVervangMiddel vervangOpdracht)\r\n        {\r\n            if (!Uitvoeren(vervangOpdracht))\r\n                return false;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (vervangOpdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(vervangOpdracht);\r\n            }\r\n            return true;\r\n        }\r\n        /// <summary>\r\n        /// Kopieer een of meerdere begrotingsregels naar een UMC begroting\r\n        /// </summary>\r\n        /// <param name=\"umcRefOpdracht\">Opdrachtobject met gegevens die nodig zijn om een aantal regels te kopi?ren</param>\r\n        public BOpdracht? KopieerBegrotingsRegels(KopieerBegrotingRegelsUMCRefOpdracht umcRefOpdracht)\r\n        {\r\n            if (!umcRefOpdracht.Uitvoeren(null!))\r\n                return null;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (umcRefOpdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(umcRefOpdracht);\r\n            }\r\n            return umcRefOpdracht;\r\n        }\r\n        /// <summary>\r\n        /// Kopieer een of meerdere begrotingsregels vanuit het clipboard\r\n        /// </summary>\r\n        /// <param name=\"opdracht\">Opdrachtobject met gegevens die nodig zijn om een aantal regels te kopi?ren</param>\r\n        public bool PlakBegrotingsRegels(BPlakBgrRegels opdracht)\r\n        {\r\n            if (opdracht == null) return false;\r\n\r\n            BPlakBgrRegelsUMCRef? umcRefOpdracht = opdracht as BPlakBgrRegelsUMCRef;\r\n            if (umcRefOpdracht != null)\r\n            {\r\n                if (!Uitvoeren(umcRefOpdracht))\r\n                    return false;\r\n            }\r\n            else\r\n            {\r\n                if (!Uitvoeren(opdracht))\r\n                    return false;\r\n            }\r\n\r\n            _Context = opdracht._Context;\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n                if (umcRefOpdracht != null)\r\n                    _OpdrachtVzl.Aanmelden(umcRefOpdracht);\r\n                else\r\n                    _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Kopieer een of meerdere begrotingsregels vanuit het clipboard\r\n        /// </summary>\r\n        /// <param name=\"opdracht\">Opdrachtobject met gegevens die nodig zijn om een aantal regels te kopi?ren</param>\r\n        public bool PlakBegrotingsRegel(BPlakBgrRegelsUMCRef opdracht)\r\n        {\r\n            if (!Uitvoeren(opdracht))\r\n                return false;\r\n\r\n            _Context = opdracht._Context;\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n            return true;\r\n        }\r\n        /// <summary>\r\n        /// Maak een nieuwe begrotingsregel aan van dezelfde soort als op de aangegeven plaats in de structuur\r\n        /// </summary>\r\n        /// <param name=\"stuIndex\">Index van structuurelement wat dient als origineel en plaatsbepaler</param>\r\n        /// <param name=\"ervoor\">true: nieuwe element invoegen voor stuIndex, anders na stuIndex</param>\r\n        /// <param name=\"klassiek\">true: voeg in als in de klassieke TRAD-5 browser</param>\r\n        /// <param name=\"onderbouwing\">true: inndien huidige regel een leeg element is maak een kostenpost aan</param>\r\n        /// <param name=\"speciaal\">true: maak een kostenpost aan, false: nieuwe regelsoort is de regelsoort van de huidige regel</param>\r\n        public BOpdracht MaakBegrotingsRegel(int stuIndex, bool ervoor, bool klassiek, bool onderbouwing, bool speciaal)\r\n        {\r\n            Debug.Assert(m_Stu != null);\r\n            Debug.Assert(stuIndex >= 0);\r\n\r\n            var opdracht = new MaakBegrotingRegelOpdracht(this, stuIndex, ervoor, klassiek, onderbouwing, speciaal);\r\n\r\n\r\n            if (!opdracht.Uitvoeren(null))\r\n                return opdracht;\r\n            _Context = opdracht._Context;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n            return opdracht;\r\n        }\r\n        public BOpdracht MaakKostenpostRegel(int stuIndex, bool ervoor)\r\n        {\r\n            Debug.Assert(m_Stu != null);\r\n            Debug.Assert(stuIndex >= 0);\r\n\r\n            var opdracht = new MaakBegrotingRegelOpdracht(this, stuIndex, ervoor);\r\n\r\n            if (!opdracht.Uitvoeren(null))\r\n                return opdracht;\r\n            _Context = opdracht._Context;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n            return opdracht;\r\n        }\r\n\r\n        /// <summary>Verwerk de kostenbestand gegevens\r\n        /// </summary>\r\n        /// <param name=\"stuIndex\">Index van structuurelement wat dient als origineel en plaatsbepaler</param>\r\n        /// <param name=\"maakKtp\">true: maak een kostenpost aan, false: nieuwe regelsoort is de regelsoort van de huidige regel</param>\r\n        /// <summary>\r\n        /// Maak een nieuw element aan bij een gegeven element\r\n        /// </summary>\r\n        /// <param name=\"parentId\">ID van het element dat optreedt als parent</param>\r\n        public BOpdracht MaakSubElement(int parentId)\r\n        {\r\n            Debug.Assert(m_Stu != null);\r\n\r\n            int stuIndex = _Stu.ZoekElement(parentId);\r\n            MaakSubElementOpdracht opdracht = new MaakSubElementOpdracht(this, stuIndex);\r\n            if (!opdracht.Uitvoeren(null!))\r\n                return opdracht;\r\n            //this._Context = opdracht._Context;\r\n\r\n            OpdrachtAanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        /// <summary>\r\n        /// Wijzig het onderbouwingstype van een begrotingsregel\r\n        /// </summary>\r\n        /// <param name=\"stuIndex\">Index van structuurelement behorend bij de begrotingsregel</param>\r\n        /// <param name=\"naarType\">Het nieuwe onderbouwingstype</param>\r\n        /// <param name=\"klassiek\">Bepaalt wat er met de onderbouwing moet gebeuren als het huidige onderbouwingstype element is</param>\r\n        /// <returns>true indien het onderbouwingstype is gewijzigd</returns>\r\n        public BOpdracht? OmzettenBegrotingsRegel(int stuIndex, EOnderbouwing naarType, bool klassiek)\r\n        {\r\n            Debug.Assert(m_Stu != null, \"Geen structuurlijst in de begroting\");\r\n            Debug.Assert(stuIndex >= 0, \"Verkeerde structuurlijstindex: te laag\");\r\n            Debug.Assert(stuIndex < _Stu._Aantal, \"Verkeerde structuurlijstindex: te hoog\");\r\n\r\n            if (stuIndex <= 0)  // rootelement mag niet worden omgezet\r\n                return null;\r\n\r\n            OmzettenBegrotingRegelOpdracht opdracht = new OmzettenBegrotingRegelOpdracht(this, stuIndex, klassiek, naarType, string.Empty);\r\n\r\n            if (!opdracht.Uitvoeren(null))\r\n                return null;\r\n            _Context = opdracht._Context;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n            return opdracht;\r\n        }\r\n        /// <summary>\r\n        /// Verplaats een regel in de onderbouwing van een element\r\n        /// </summary>\r\n        /// <param name=\"stuIndex\">Index in de structuurlijst van de begrotingsregel die verplaatst moet worden</param>\r\n        /// <param name=\"naarVoren\">true: verplaats de regel naar voren - indien mogelijk</param>\r\n        /// <returns>true indien er een verplaatsing heeft plaatsgevonden</returns>\r\n        public bool VerplaatsOnderbouwing(int stuIndex, bool naarVoren, EViewKey viewNr, bool alsElement)\r\n        {\r\n            int stuIndexDoel;\r\n            int startIndex;\r\n            int count;\r\n            // Bepaal welke regels verplaatst moeten worden en\r\n            // waarheen de selectie verplaatst moet worden\r\n            if (naarVoren)\r\n            {\r\n                int eindeSelectie = _Stu.EindeOnderbouwing(stuIndex) + 1;\r\n                startIndex = stuIndex;\r\n                count = eindeSelectie-startIndex;\r\n                if (alsElement)\r\n                {\r\n                    if (!_Stu.GeefVorigSubElement(stuIndex, out stuIndexDoel))\r\n                        return false;\r\n                }\r\n                else\r\n                {\r\n                    if (!_Stu.GeefVorigeOnderbouwing(stuIndex, out stuIndexDoel))\r\n                        return false;\r\n                }\r\n            }\r\n            else\r\n            {\r\n                int bStuIndex;\r\n                if (alsElement)\r\n                {\r\n                    if (!_Stu.GeefVolgendSubElement(stuIndex, out bStuIndex))\r\n                        return false;\r\n                }\r\n                else\r\n                {\r\n                    if (!_Stu.GeefVolgendeOnderbouwing(stuIndex, out bStuIndex))\r\n                        return false;\r\n                }\r\n\r\n                int eindeSelectie = _Stu.EindeOnderbouwing(bStuIndex) + 1;\r\n                startIndex = bStuIndex;\r\n                count = eindeSelectie - startIndex;\r\n                stuIndexDoel = stuIndex;\r\n            }\r\n            int prtId = _Stu[stuIndex]._PrtId;\r\n\r\n            // Geef opdracht tot verplaatsing door VerplaatsBegrotingsRegelsSequentieel // bug 3592\r\n            BOpdracht? opdracht = VerplaatsBegrotingsRegelsSequentieel(startIndex, count, stuIndexDoel, prtId);\r\n            if (opdracht == null)\r\n                return false;\r\n\r\n            _Context = opdracht._Context;\r\n            opdracht.SetView(viewNr);\r\n            return true;\r\n        }\r\n        /// <summary>\r\n        /// Verplaats een of meerdere begrotingsregels\r\n        /// </summary>\r\n        /// <param name=\"selectie\">De (evt. discontinue) selectie van begrotingsregels in het origineel</param>\r\n        /// <param name=\"stuIndexDoel\">De bestemming van de regels die verplaatst moeten worden</param>\r\n        /// <param name=\"eltId\">ID van het element waarheen de regels verplaatst moeten worden</param>\r\n        /// <returns>true indien er een verplaatsing heeft plaatsgevonden</returns>\r\n        public BOpdracht? VerplaatsBegrotingsRegels(BSelectie selectieOrig, int stuIndexDoel, int eltId)\r\n        {\r\n            Debug.Assert(m_Stu != null, \"BBegroting.VerplaatsBegrotingsRegels() - geen structuurlijst\");\r\n            //Debug.Assert(eltId > 0 || (stuIndexDoel > 0 && stuIndexDoel <= _Stu._Aantal), \"BBegroting.VerplaatsBegrotingsRegels() - doel-index of element-ID verkeerd\");\r\n\r\n            VerplaatsBegrotingRegelsOpdracht opdracht = new VerplaatsBegrotingRegelsOpdracht(this, selectieOrig);\r\n\r\n            //BBegrotingSelectie bs = new BBegrotingSelectie(this, selectieOrig);\r\n            //BPlakBgrRegels opdracht = new BPlakBgrRegels(bs);\r\n            opdracht.StuIndexDoel = stuIndexDoel;\r\n            opdracht.PrtIdDoel = eltId;\r\n\r\n\r\n            if (!opdracht.Uitvoeren(null!))\r\n                return null;\r\n            _Context = opdracht._Context;\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n\r\n            return opdracht;\r\n        }\r\n        /// <summary>\r\n        /// Verplaats een of meerdere begrotingsregels sequentieel t.b.v bewerkingen\r\n        /// Let op! Dit is niet de functie verplaatsen van de regel met drag in de begroting\r\n        /// </summary>\r\n        /// <param name=\"selectie\">De (evt. discontinue) selectie van begrotingsregels in het origineel</param>\r\n        /// <param name=\"stuIndexDoel\">De bestemming van de regels die verplaatst moeten worden</param>\r\n        /// <param name=\"eltId\">ID van het element waarheen de regels verplaatst moeten worden</param>\r\n        /// <returns>true indien er een verplaatsing heeft plaatsgevonden</returns>\r\n        public BOpdracht? VerplaatsBegrotingsRegelsSequentieel(int startIndex, int count, int newStartIndex, int eltId)\r\n        {\r\n            Debug.Assert(m_Stu != null, \"BBegroting.VerplaatsBegrotingsRegelsSequentieel() - geen structuurlijst\");\r\n            Debug.Assert(eltId > 0 || (newStartIndex > 0 && newStartIndex <= _Stu._Aantal), \"BBegroting.VerplaatsBegrotingsRegels() - doel-index of element-ID verkeerd\");\r\n\r\n            var opdracht = new VerplaatsBegrotingRegelsSequentieelOpdracht(this, startIndex, count, newStartIndex);\r\n\r\n            //BBegrotingSelectie bs = new BBegrotingSelectie(this, selectieOrig);\r\n            //BPlakBgrRegels opdracht = new BPlakBgrRegels(bs);\r\n            opdracht.PrtIdDoel = eltId;\r\n            if (!opdracht.Uitvoeren(null!)) return null;\r\n            _Context = opdracht._Context;\r\n\r\n            _Stu._VolgordeOfHierarchieWijziging = true;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n            return opdracht;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Verwijderen van de begrotingsregel zonder het aanmelden van de opdracht\r\n        /// Alleen de EBgrRegelVerwijderen.NieuweStijl.\r\n        /// opdracht niet actief: opdracht niet opnemen in de verwijderlijst\r\n        /// Dus ook geen undo functionaliteit\r\n        /// </summary>\r\n        /// <param name=\"stuIndex\"></param>\r\n        /// <returns></returns>\r\n        public BOpdracht VerwijderBegrotingsRegel(int stuIndex, bool opdrachtNietActief, bool koppelingNietVerwijderen)\r\n        {\r\n            Debug.Assert(m_Stu != null, \"Geen structuurlijst\");\r\n\r\n            VerwijderBegrotingRegelOpdracht opdracht = new VerwijderBegrotingRegelOpdracht(this, stuIndex, EBgrRegelVerwijderen.NieuweStijl);\r\n            opdracht.NietActief = opdrachtNietActief;//opdracht niet opnemen in de verwijderlijst\r\n            opdracht.KoppelingNietVerwijderen = koppelingNietVerwijderen;\r\n            //koppelingNietVerwijderen;//opdracht niet opnemen in de verwijderlijst\r\n            if (opdracht.NietActief)\r\n                opdracht.AantalVerwijderd = 0;\r\n\r\n            if (opdracht.Uitvoeren(null!) && !m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n            }\r\n            return opdracht;\r\n        }\r\n        /// <summary>\r\n        /// Verwijder een regel uit de begroting\r\n        /// </summary>\r\n        /// <param name=\"stuIndex\">Index van structuurelement behorend bij de begrotingsregel</param>\r\n        /// <param name=\"methode\">Bepaalt wat er met de onderbouwing van een verwijderd element moet gebeuren</param>\r\n        public BOpdracht VerwijderBegrotingsRegel(int stuIndex, EBgrRegelVerwijderen methode)\r\n        {\r\n            Debug.Assert(m_Stu != null, \"Geen structuurlijst\");\r\n\r\n            VerwijderBegrotingRegelOpdracht opdracht = new VerwijderBegrotingRegelOpdracht(this, stuIndex, methode);\r\n\r\n            if (opdracht.Uitvoeren(null) && !m_Snel)\r\n            {\r\n                _Context = opdracht._Context;\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n            return opdracht;\r\n        }\r\n        public bool VerwijderKtpMiddel(BKostenpost kostenpost, bool undo)\r\n        {\r\n            // ga na of kostenpost._Middel nog ergens gebruikt wordt\r\n            BMiddel middel = kostenpost._Middel;\r\n            if (!_Umc ||                                        // geen unieke middelencodering?\r\n               string.IsNullOrEmpty(middel._MidCde) ||         // lege middelcode\r\n               !_Stu.ZoekMiddel(middel._Id, kostenpost._Id))   // geen andere kostenposten die dit middel toepassen\r\n            {\r\n                // de kostenpost had z'n eigen middel\r\n                return _Mid.MiddelVerwijderen(middel, undo);    // dit heeft geen consequenties voor andere kostenposten\r\n            }\r\n            return false;\r\n        }\r\n        /// <summary>\r\n        /// Verwijder de Einde pagina markering van alle begrotingsregels\r\n        /// </summary>\r\n        /// <returns>Een BOpdracht-object indien er iets gewijzigd is</returns>\r\n        public BOpdracht? VerwijderNieuwePagina()\r\n        {\r\n            BVerwijderNieuwePagina opdracht = new BVerwijderNieuwePagina();\r\n            if (Uitvoeren(opdracht))\r\n            {\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n                return opdracht;\r\n            }\r\n            return null;\r\n        }\r\n        /// <summary>\r\n        /// Wijzig het type van de begroting: Traditioneel, Elementen, Onderhoud of Raw\r\n        /// De begroting wordt opnieuw doorgerekend\r\n        /// </summary>\r\n        public BOpdracht? WijzigBgrTpe(EBgrTpe tpe)\r\n        {\r\n            if (m_Tpe == tpe)\r\n                return null;\r\n\r\n            BWijzigBgrTpe opdracht = new BWijzigBgrTpe(m_Tpe, tpe);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        /// <summary>\r\n        /// Wijzig de omschrijving van de begroting\r\n        /// </summary>\r\n        public BOpdracht? WijzigBgrOms(string oms)\r\n        {\r\n            if (m_Oms == oms)\r\n                return null;\r\n            BWijzigBgrOms opdracht = new BWijzigBgrOms(m_Oms, oms);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        public BOpdracht? WijzigKostenbestand(string kostenbestandEigenschappen, bool nieuwbouw)\r\n        {\r\n            string orgKostenbestandEigenschappen = nieuwbouw ? _KostenbestandEigenschappenNieuwbouw : _KostenbestandEigenschappenOnderhoud;\r\n\r\n            if (orgKostenbestandEigenschappen == kostenbestandEigenschappen)\r\n                return null;\r\n\r\n            BWijzigKostenbestand opdracht = new BWijzigKostenbestand(orgKostenbestandEigenschappen, kostenbestandEigenschappen, nieuwbouw);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        public BOpdracht? WijzigKostenbestandParameters(string kostenbestandParaneters)\r\n        {\r\n            if (kostenbestandParaneters == _KostenbestandOnderhoudParameters)\r\n                return null;\r\n\r\n            BWijzigKostenbestandParameters opdracht = new BWijzigKostenbestandParameters(_KostenbestandOnderhoudParameters, kostenbestandParaneters);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        /// <summary>Wijzig de tekst van het raw voorblad\r\n        /// </summary>\r\n        public BOpdracht? WijzigRawInschrijfbiljet(string inschrijfbiljetTekst)\r\n        {\r\n            if (_RawInschrijfBiljet == inschrijfbiljetTekst)\r\n                return null;\r\n            BWijzigRawInschrijfbiljet opdracht = new BWijzigRawInschrijfbiljet(_RawInschrijfBiljet, inschrijfbiljetTekst);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        /// <summary>Wijzig de tekst van het raw voorblad\r\n        /// </summary>\r\n        public BOpdracht? WijzigRawVoorblad(string voorbladTekst)\r\n        {\r\n            if (_RawVoorblad == voorbladTekst)\r\n                return null;\r\n            BWijzigRawVoorblad opdracht = new BWijzigRawVoorblad(_RawVoorblad, voorbladTekst);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        /// <summary>Wijzig de Referentie Elementen van de begroting\r\n        /// </summary>\r\n        public BOpdracht? WijzigBgrRefElt(string refEltNieuw)\r\n        {\r\n            string refEltOud = _ElementenBoekNaam;\r\n\r\n            if (refEltOud == refEltNieuw)\r\n                return null;\r\n\r\n            BWijzigBgrRefElt opdracht = new BWijzigBgrRefElt(refEltOud, refEltNieuw);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        /// <summary>Wijzig de Referentie Prijzen van de begroting\r\n        /// </summary>\r\n        public BOpdracht? WijzigBgrRefPrz(string? refPrzOud, string? refPrzNieuw)\r\n        {\r\n            string prijzenboekOud = string.IsNullOrEmpty(refPrzOud) ? _PrijzenBoekNaam : refPrzOud;\r\n            string prijzenboekNieuw = refPrzNieuw ?? string.Empty;\r\n\r\n            if (string.Compare(prijzenboekOud, prijzenboekNieuw, StringComparison.OrdinalIgnoreCase) == 0)  // Geen wijziging?\r\n                return null;\r\n\r\n            var opdracht = new BWijzigBgrRefPrz(prijzenboekOud, prijzenboekNieuw);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        /// <summary>Wijzig de Referentie Leverancier Prijzen van de begroting\r\n        /// </summary>\r\n        public BOpdracht? WijzigBgrRefLevPrz(string refLevPrzNieuw)\r\n        {\r\n            string refLevPrzOud = _LevPrijzenBoekNaam;\r\n\r\n            if (refLevPrzOud == refLevPrzNieuw)\r\n            {\r\n                return null;\r\n            }\r\n            BWijzigBgrRefLevPrz opdracht = new BWijzigBgrRefLevPrz(refLevPrzOud, refLevPrzNieuw);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        /// <summary>\r\n        /// Wijzig een gegeven van de begroting\r\n        /// </summary>\r\n        public BOpdracht? WijzigGebruikersGegeven(string naam, string waarde)\r\n        {\r\n            GebruikersGegevenWijzigenOpdracht? opdracht = null;\r\n\r\n            // Is het een bestaand gebruikersgegeven?\r\n            BGebruikersGegeven? gebruikersGegeven = _Ggv.GeefGebruikersGegeven(naam);\r\n            if (gebruikersGegeven != null &&\r\n               gebruikersGegeven._Wde != waarde)\r\n            {\r\n                opdracht = new GebruikersGegevenWijzigenOpdracht(this, naam, gebruikersGegeven._Wde, waarde);\r\n                _OpdrachtVzl.Uitvoeren(opdracht);\r\n            }\r\n            return opdracht;\r\n        }\r\n\r\n        public BOpdracht? WijzigGebruikersGegevenRglnr(string naam, int richting)\r\n        {\r\n            GebruikersGegevenWijzigenOpdracht? opdracht = null;\r\n\r\n            // Is het een bestaand gebruikersgegeven?\r\n            BGebruikersGegeven? gebruikersGegeven = _Ggv.GeefGebruikersGegeven(naam);\r\n            if (gebruikersGegeven != null)\r\n            {\r\n                opdracht = new GebruikersGegevenWijzigenOpdracht(this, naam, richting);\r\n                _OpdrachtVzl.Uitvoeren(opdracht);\r\n            }\r\n            return opdracht;\r\n        }\r\n\r\n        public BOpdracht? WijzigGebruikersGegevenCategorie(string? oudeNaam, string? nieuweNaam)\r\n        {\r\n            if (oudeNaam == null || nieuweNaam == null)\r\n                return null;\r\n\r\n            oudeNaam = oudeNaam.Trim();\r\n            nieuweNaam = nieuweNaam.Trim();\r\n            if (string.IsNullOrEmpty(oudeNaam) || string.IsNullOrEmpty(nieuweNaam) || string.Compare(oudeNaam, nieuweNaam, StringComparison.OrdinalIgnoreCase) == 0)\r\n                return null;\r\n\r\n            GebruikersGegevenWijzigCategorieOpdracht opdracht = new GebruikersGegevenWijzigCategorieOpdracht(this, oudeNaam, nieuweNaam);\r\n            _OpdrachtVzl.Uitvoeren(opdracht);\r\n            return opdracht;\r\n        }\r\n\r\n        public BOpdracht WijzigInUitKlappen(int actieveIndex, bool inklappen)\r\n        {\r\n            // Maak een opdracht die deze situatie kan instellen\r\n            BWijzigInklapStatusBgrRegel opdracht = new BWijzigInklapStatusBgrRegel(actieveIndex, inklappen);\r\n            OpdrachtUitvoeren(opdracht);\r\n            return opdracht;\r\n        }\r\n        /// <summary>\r\n        /// Voeg een gegeven toe aan de begroting\r\n        /// </summary>\r\n        public BOpdracht? ToevoegenGebruikersGegeven(BGebruikersGegeven gegeven)\r\n        {\r\n            var opdracht = new GebruikersGegevenToevoegenOpdracht(this, gegeven);\r\n            if (opdracht.Uitvoeren(null!))\r\n            {\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n                return opdracht;\r\n            }\r\n            return null;\r\n        }\r\n        /// <summary>\r\n        /// Verwijder een gegeven uit de begroting\r\n        /// </summary>\r\n        public BOpdracht? VerwijderenGebruikersGegeven(BGebruikersGegeven gegeven)\r\n        {\r\n            var opdracht = new GebruikersGegevenVerwijderenOpdracht(this, gegeven);\r\n            return _OpdrachtVzl.Uitvoeren(opdracht) ? opdracht : null;\r\n        }\r\n        public BOpdracht WijzigBbdBgrPostToepassen(bool toepassen)\r\n        {\r\n            BWijzigBbdBgrPostToepassen opdracht = new BWijzigBbdBgrPostToepassen(toepassen);\r\n            _OpdrachtVzl.Uitvoeren(opdracht);\r\n            return opdracht;\r\n        }\r\n        //public BOpdracht WijzigRevisieNummer(string revisie)\r\n        //{\r\n\r\n        //    this.IsGewijzigd();\r\n        //    BWijzigRevisieNummer opdracht = new BWijzigRevisieNummer(revisie);\r\n        //    _OpdrachtVzl.Uitvoeren(opdracht);\r\n        //    return opdracht;\r\n        //}\r\n        public BOpdracht WijzigVastPrijsToepassen(bool toepassen)\r\n        {\r\n            // Als er geen vastprijs gebruikt mag worden de bestaande verwijderen uit de begroting.\r\n            if (!toepassen)\r\n            {\r\n                VerwijderenVastPrijsIndicatie();\r\n            }\r\n\r\n            BWijzigVastPrijsToepassen opdracht = new BWijzigVastPrijsToepassen(toepassen);\r\n            _OpdrachtVzl.Uitvoeren(opdracht);\r\n            return opdracht;\r\n        }\r\n        public BOpdracht WijzigBtwToepassen(bool toepassen)\r\n        {\r\n            // Als er geen btw gebruikt mag worden de bestaande verwijderen uit de begroting.\r\n            if (!toepassen)\r\n            {\r\n                // TODO: Nog interesante dingen doen.\r\n                // Melding in het logboek welke btw soorten er gebruikt worden.\r\n            }\r\n\r\n            BWijzigBtwToepassen opdracht = new BWijzigBtwToepassen(toepassen);\r\n            _OpdrachtVzl.Uitvoeren(opdracht);\r\n            return opdracht;\r\n        }\r\n        public BOpdracht WijzigVasteHoeveelheidIndicatie(bool toepassen)\r\n        {\r\n            // Als er geen vaste hoeveelheid indicatie gebruikt gaat worden.\r\n            if (!toepassen)\r\n            {\r\n                // TODO: Nog interesante dingen doen.\r\n            }\r\n\r\n            BWijzigVasteHoeveelheidIndicatie opdracht = new BWijzigVasteHoeveelheidIndicatie(toepassen);\r\n            _OpdrachtVzl.Uitvoeren(opdracht);\r\n            return opdracht;\r\n        }\r\n        public BOpdracht WijzigKlantkortingToepassen(bool toepassen)\r\n        {\r\n            BWijzigKlantkortingToepassen opdracht = new BWijzigKlantkortingToepassen(toepassen);\r\n            _OpdrachtVzl.Uitvoeren(opdracht);\r\n            return opdracht;\r\n        }\r\n        public BOpdracht WijzigElementenOp0(bool toepassen)\r\n        {\r\n            BWijzigElementenOp0 opdracht = new BWijzigElementenOp0(toepassen);\r\n            _OpdrachtVzl.Uitvoeren(opdracht);\r\n            return opdracht;\r\n        }\r\n\r\n        public BOpdracht WijzigAfgerondRekenen(BAfgerondRekenen ar)\r\n        {\r\n            BWijzigAfgerondRekenen opdracht = new BWijzigAfgerondRekenen(ar, _AfgerondRekenen);\r\n            _OpdrachtVzl.Uitvoeren(opdracht);\r\n            return opdracht;\r\n        }\r\n        /// <summary>\r\n        /// Wijzig het vast totaal van de begroting\r\n        /// </summary>\r\n        public BOpdracht? WijzigBgrVtt(BBedrag val)\r\n        {\r\n            if (BBedrag.Gelijk(_VstTot, val, m_BasisValuta!._ValutaVzl))\r\n                return null;\r\n\r\n            BWijzigVttBedrag opdracht = new BWijzigVttBedrag(_VstTot, val);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n\r\n            return opdracht;\r\n        }\r\n        /// <summary>\r\n        /// Wijzig UMC zonder dat dubbele codes gebruikt worden\r\n        /// </summary>\r\n        /// <param name=\"umc\"></param>\r\n        /// <returns></returns>\r\n        public BOpdracht? WijzigBgrUmc(bool umc)\r\n        {\r\n            return WijzigBgrUmc(umc, out _);\r\n        }\r\n        /// <summary>\r\n        /// Wijzig UMC met gebruik van dubbele codes lijst.\r\n        /// </summary>\r\n        /// <param name=\"umc\"></param>\r\n        /// <param name=\"dubbeleCodes\"></param>\r\n        /// <returns></returns>\r\n        public BOpdracht? WijzigBgrUmc(bool umc, out IList<string>? dubbeleCodes)\r\n        {\r\n            BWijzigUmc opdracht = new BWijzigUmc(umc);\r\n            dubbeleCodes = null;\r\n\r\n            if (!Uitvoeren(opdracht))\r\n            {\r\n                dubbeleCodes = opdracht.DubbeleCodes;\r\n                return null;\r\n            }\r\n            if (umc) //bug 3815\r\n            {\r\n                // Er kunnen dubbele middelcodes voorkomen die wel voldoen aan\r\n                // de voorwaarden van UMC. Comprimeer de middelen\r\n                _Mid.Comprimeren(out List<BMiddelen.BVervangenMiddel> vervangenMiddelen);\r\n\r\n                int stuIndex = -1;\r\n                int middelId;\r\n                int vervangIndex;\r\n                BMiddelen.BVervangenMiddel zoekVervangendMiddel = new BMiddelen.BVervangenMiddel();\r\n                BMiddel vervangendMiddel;\r\n\r\n                // Doorloop de kostenposten en vervang de verwijderde middelen door de overgebleven.\r\n                var kostenpost = (BKostenpost?)_Stu.GeefVolgendeBgrRegel(EOnderbouwing.Kostenpost, ref stuIndex);\r\n                while (kostenpost != null)\r\n                {\r\n                    middelId = kostenpost?._Middel?._Id ?? 0;\r\n                    zoekVervangendMiddel.m_MiddelId = middelId;\r\n\r\n                    vervangenMiddelen.Sort();\r\n                    vervangIndex = vervangenMiddelen.BinarySearch(zoekVervangendMiddel);\r\n\r\n                    if (vervangIndex >= 0)\r\n                    {\r\n                        vervangendMiddel = vervangenMiddelen[vervangIndex].m_VervangendMiddel;\r\n                        kostenpost?.WijzigMiddel(vervangendMiddel, true);\r\n                    }\r\n\r\n                    kostenpost = (BKostenpost?)_Stu.GeefVolgendeBgrRegel(EOnderbouwing.Kostenpost, ref stuIndex);\r\n                }\r\n            }\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n\r\n            return opdracht;\r\n        }\r\n        public BOpdracht? WijzigIntegerBgrRegel(int stuIndex, BBegrotingsRegel.EGegeven gegevenNr, int waarde)\r\n        {\r\n            IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n            BOpdracht? opdracht = bgrRegel?.MaakWijzigIntegerOpdracht(stuIndex, gegevenNr, waarde);\r\n            if (opdracht == null)\r\n                return null;\r\n\r\n            if (!opdracht.Uitvoeren(this))\r\n                return null;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht?._Rekenen == true)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                if (opdracht != null)\r\n                    _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n            if (opdracht != null)\r\n            {\r\n                opdracht._RegelNummer = stuIndex;\r\n                _Context = opdracht._Context;\r\n            }\r\n\r\n            return opdracht;\r\n        }\r\n        public BOpdracht? WijzigDatumBgrRegel(int stuIndex, BBegrotingsRegel.EGegeven gegevenNr, DateTime waarde)\r\n        {\r\n            IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n            BOpdracht? opdracht = bgrRegel?.MaakWijzigDatumOpdracht(stuIndex, gegevenNr, waarde);\r\n            if (opdracht == null)\r\n                return null;\r\n\r\n            if (!opdracht.Uitvoeren(this))\r\n                return null;\r\n\r\n            if (opdracht != null)\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n\r\n            opdracht?._RegelNummer = stuIndex;\r\n            _Context = opdracht?._Context;\r\n\r\n            return opdracht;\r\n        }\r\n\r\n        public void WijzigGuidBgrRegel(int stuIndex, BBegrotingsRegel.EGegeven gegevenNr, Guid waarde)\r\n        {\r\n            IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n            BOpdracht? opdracht = bgrRegel?.MaakWijzigGuidOpdracht(stuIndex, gegevenNr, waarde);\r\n            if (opdracht == null)\r\n                return;\r\n\r\n            if (!opdracht.Uitvoeren(this))\r\n                return;\r\n\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n\r\n            opdracht._RegelNummer = stuIndex;\r\n            _Context = opdracht._Context;\r\n        }\r\n\r\n        public BOpdracht? AanvullenUnetoVNINormen(int stuIndexDoel, int stuIndexRef, IBegroting referentie, EUurnrmtpe uurNormType)\r\n        {\r\n            IBegrotingsRegel? bgrRegel = _Stu[stuIndexDoel]._Regel;\r\n            BOpdracht? opdracht = bgrRegel?.MaakAanvullenUnetoVNINormenOpdracht(this, stuIndexDoel, stuIndexRef, referentie, uurNormType);\r\n\r\n            if (opdracht?.Uitvoeren(this) != true)\r\n                return null;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht?._Rekenen == true)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                if (opdracht != null)\r\n                    _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n\r\n            if (opdracht != null)\r\n            {\r\n                opdracht._RegelNummer = stuIndexDoel;\r\n                _Context = opdracht._Context;\r\n            }\r\n\r\n            return opdracht;\r\n        }\r\n        public BOpdracht? WijzigDoubleBgrRegel(int stuIndex, BBegrotingsRegel.EGegeven gegevenNr, double waarde, bool uitMeting)\r\n        {\r\n            IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n            BOpdracht? opdracht = bgrRegel?.MaakWijzigDoubleOpdracht(stuIndex, gegevenNr, waarde, uitMeting);\r\n\r\n            if (opdracht == null)\r\n                return null;\r\n\r\n            if (!opdracht.Uitvoeren(this))\r\n                return null;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (gegevenNr == BBegrotingsRegel.EGegeven.hvh ||\r\n                    gegevenNr == BBegrotingsRegel.EGegeven.postprijs ||\r\n                    gegevenNr == BBegrotingsRegel.EGegeven.enhprs ||\r\n                    gegevenNr == BBegrotingsRegel.EGegeven.fachvh ||\r\n                    gegevenNr == BBegrotingsRegel.EGegeven.prodfactor)\r\n                {\r\n                    if (_BrinkKostenbestandEigenschappenOnderhoud?._MJOBActiefBerekenen == true)\r\n                    {\r\n                        // Direct de regel berekenen.\r\n                        RekenenMjobContanteWaardeInvestering(bgrRegel);\r\n                    }\r\n                    else\r\n                    {\r\n                        // Parameter op false zetten.\r\n                        _MjobContanteWaardeIsActueel = false;\r\n                    }\r\n                }\r\n\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n\r\n            opdracht._RegelNummer = stuIndex;\r\n            _Context = opdracht._Context;\r\n\r\n            return opdracht;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Wijzig de middelcode van een kostenpost\r\n        /// </summary>\r\n        /// <param name=\"kostenpost\">De kostenpost waarvan de middelcode/calculatiecode moet wijzigen</param>\r\n        /// <param name=\"midcde\">De nieuwe middelcode</param>\r\n        /// <param name=\"rekenen\">true: de begroting moet opnieuw worden doorgerekend</param>\r\n        /// <returns>true: de middelcode van de kostenpost is gewijzigd</returns>\r\n        public BOpdracht? WijzigMidCde(BKostenpost kostenpost, string? midcde, out bool rekenen)\r\n        {\r\n            rekenen = false;\r\n            if (_VttId == kostenpost._Id && _Umc)\r\n                return null;\r\n\r\n            int stuIndex = _Stu.ZoekKostenpost(kostenpost._Id);\r\n            BWijzigMiddelCode opdracht = new BWijzigMiddelCode(stuIndex, midcde);\r\n            if (!Uitvoeren(opdracht))\r\n                return null;\r\n\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            rekenen = opdracht._Rekenen;\r\n\r\n            opdracht._RegelNummer = stuIndex;\r\n            _Context = opdracht._Context;\r\n\r\n            return opdracht;\r\n        }\r\n        /// <summary>\r\n        /// Wijzig de middelcode van een middel\r\n        /// </summary>\r\n        /// <param name=\"middel\">Het middel waarvan de middelcode moet wijzigen</param>\r\n        /// <param name=\"midcde\">De nieuwe middelcode</param>\r\n        /// <returns>De opdracht waardoor de wijziging is uitgevoerd</returns>\r\n        public BOpdracht? WijzigMidCde(BMiddel middel, string midcde)\r\n        {\r\n            BWijzigMiddelCodeExcl opdracht = new BWijzigMiddelCodeExcl(middel, midcde);\r\n            if (!Uitvoeren(opdracht))\r\n                return null;\r\n\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n        public BOpdracht? WijzigNiveauBgrRegel(int stuIndex, bool hoger)\r\n        {\r\n            BSelectie selectie = new BSelectie(stuIndex, stuIndex + 1);\r\n            return WijzigNiveauBgrRegel(selectie, hoger);\r\n        }\r\n\r\n        public BOpdracht? WijzigNiveauBgrRegel(BSelectie selectie, bool hoger)\r\n        {\r\n            BOpdracht opdracht;\r\n            if (hoger)\r\n            {\r\n                BVerhoogNiveauBgrRegel verhoogNiveauOpdracht = new BVerhoogNiveauBgrRegel(selectie);\r\n                if (selectie.GeefAantal() <= 1)\r\n                    verhoogNiveauOpdracht.VerhoogNiveau = _optieNiveauWisseling.IsMeedegraderenGewenst();\r\n                opdracht = verhoogNiveauOpdracht;\r\n            }\r\n            else\r\n            {\r\n                opdracht = new BVerlaagNiveauBgrRegel(selectie);\r\n            }\r\n\r\n            if (!opdracht.Uitvoeren(this))\r\n                return null;\r\n\r\n            MoetRekenen = true;     // herberekening is noodzakelijk\r\n            if (!m_Snel)\r\n            {\r\n                Rekenen(ERekendiepte.Wijzigingen);\r\n                if (opdracht != null)\r\n                    _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n            if (opdracht != null)\r\n                _Context = opdracht._Context;\r\n            return opdracht;\r\n        }\r\n\r\n        public BOpdracht? WijzigRawGegeven(BRawInfo.ERawGegeven gegeven, object? waardeNieuw, object? waardeOud)\r\n        {\r\n            if (waardeNieuw == null || waardeOud == null) return null;\r\n            BWijzigRawGegeven opdracht = new BWijzigRawGegeven(gegeven, waardeNieuw, waardeOud);\r\n            _OpdrachtVzl.Uitvoeren(opdracht);\r\n            return opdracht;\r\n        }\r\n\r\n        public BOpdracht? WijzigStringBgrRegel(bool klassiek, int stuIndex, BBegrotingsRegel.EGegeven gegevenNr, string waarde, IOpdrachtValidator? opdrachtValidator, out bool lokaal)\r\n        {\r\n            BOpdracht? opdracht = null;\r\n            lokaal = true;\r\n            IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n            if (bgrRegel == null)\r\n                return null;\r\n            BKostenpost? ktp = bgrRegel as BKostenpost;\r\n\r\n            if (gegevenNr == BBegrotingsRegel.EGegeven.stk)\r\n            {\r\n                bool nieuweGroepeerOpdrachtGemaakt = GroepeerOpdrachten(); // Er is een mogelijkheid dat bij deze wijzigingen groepsopdrachten gemaakt worden\r\n\r\n                if (waarde == BBegrotingsRegel.c_sAlleenOmsHoev || waarde == BBegrotingsRegel.c_sAlleenTotPrys || waarde == BBegrotingsRegel.c_sNietafdrukken)\r\n                {\r\n                    string stk = bgrRegel.GeefString(BBegrotingsRegel.EGegeven.stk, klassiek);\r\n\r\n                    if (string.IsNullOrEmpty(stk) == false && stk != BBegrotingsRegel.c_sAlleenOmsHoev && stk != BBegrotingsRegel.c_sAlleenTotPrys)\r\n                    {\r\n                        WijzigStringBgrRegel(bgrRegel, klassiek, stuIndex, gegevenNr, string.Empty, opdrachtValidator, out lokaal);\r\n                        lokaal = false;\r\n                        // Het type van de regel kan gewijzigd zijn >> opnieuw bepalen\r\n                        bgrRegel = _Stu[stuIndex]._Regel;\r\n                    }\r\n\r\n                    WijzigStringBgrRegel(bgrRegel, klassiek, stuIndex, gegevenNr, waarde, opdrachtValidator, out lokaal);\r\n                }\r\n                else if (bgrRegel.HeeftStatus(ERegelStatus.KtpCommentaar) && bgrRegel._OnderbouwingType != EOnderbouwing.Opslagpost)  // \".,-\"\r\n                {\r\n                    int statusOud = bgrRegel._Stt;\r\n                    bgrRegel.WijzigRegelStatus(ERegelStatus.Normaal);\r\n                    // Als een punt of komma stuurcode vervangen wordt door een spatie of lege string dan alle\r\n                    // statussen weer op 0 zetten (ook niet meerekenen)\r\n                    bool isLetter = false;\r\n                    if (waarde.Length > 0)\r\n                        isLetter = (ktp != null) && Char.IsLetter(waarde, 0);\r\n                    if (string.IsNullOrEmpty(waarde) || waarde == BStatics.c_Spatie || isLetter || waarde == \"?\")//NIETVERTALEN\r\n                        bgrRegel._Actief = true;\r\n                    int statusNieuw = bgrRegel._Stt;\r\n                    opdracht = new BWijzigStatusBgrRegel(stuIndex, statusOud, statusNieuw, true);\r\n                    if (opdracht != null)\r\n                    {\r\n                        opdracht.SetView(_ViewNr);\r\n                        if (opdracht != null)\r\n                            _OpdrachtVzl.Aanmelden(opdracht);\r\n                    }\r\n                    WijzigStringBgrRegel(bgrRegel, klassiek, stuIndex, gegevenNr, waarde, opdrachtValidator, out lokaal);\r\n                    lokaal = false; // tgv de wijziging in status moet deze op false gezet worden\r\n                    BgrRglGewijzigd(bgrRegel, true);\r\n                }\r\n                else\r\n                {\r\n                    WijzigStringBgrRegel(bgrRegel, klassiek, stuIndex, gegevenNr, waarde, opdrachtValidator, out lokaal);\r\n                }\r\n                // Als er een nieuwe groepeerOpdracht gemaakt is dan deze nu afsluiten\r\n                // Als er al een groepeeropdracht was dan worden de opdrachten automatisch aangemeld bij die groepeeropdracht\r\n                if (nieuweGroepeerOpdrachtGemaakt)\r\n                {\r\n                    opdracht = GroepeerOpdrachten(_ViewNr, ProjectResources.TradB24226);\r\n\r\n                    if (opdracht != null)//bug 4273\r\n                    {\r\n                        opdracht._RegelNummer = stuIndex;//comm Js de stuindex blijft hetzelfde\r\n                        _Context = opdracht._Context;\r\n                    }\r\n                }\r\n                return opdracht;\r\n            }\r\n            else if (gegevenNr == BBegrotingsRegel.EGegeven.OnderhoudsCode)\r\n            {\r\n                bool nieuweGroepeerOpdrachtGemaakt = GroepeerOpdrachten(); // Er is een mogelijkheid dat bij deze wijigingen groepsopdrachten gemaakt worden\r\n\r\n                WijzigStringBgrRegel(bgrRegel, klassiek, stuIndex, gegevenNr, waarde, opdrachtValidator, out lokaal);\r\n                if (_BrinkKostenbestandEigenschappenOnderhoud?._MJOBActiefBerekenen == true)\r\n                {\r\n                    // Direct de regel berekenen.\r\n                    RekenenMjobContanteWaardeInvestering(bgrRegel);\r\n                }\r\n                else\r\n                {\r\n                    // Parameter op false zetten.\r\n                    _MjobContanteWaardeIsActueel = false;\r\n                }\r\n\r\n                if (nieuweGroepeerOpdrachtGemaakt)\r\n                {\r\n                    opdracht = GroepeerOpdrachten(_ViewNr, ProjectResources.TradB24227);\r\n\r\n                    if (opdracht != null)\r\n                    {\r\n                        opdracht._RegelNummer = stuIndex;//comm Js de stuindex blijft hetzelfde\r\n                        _Context = opdracht._Context;\r\n                    }\r\n                }\r\n                return opdracht;\r\n            }\r\n            else\r\n            {\r\n                return WijzigStringBgrRegel(bgrRegel, klassiek, stuIndex, gegevenNr, waarde, opdrachtValidator, out lokaal);\r\n            }\r\n        }\r\n\r\n\r\n        public BOpdracht? WijzigStringBgrRegel(IBegrotingsRegel? bgrRegel, bool klassiek, int stuIndex, BBegrotingsRegel.EGegeven gegevenNr, string waarde, IOpdrachtValidator? opdrachtValidator, out bool lokaal)\r\n        {\r\n            lokaal = true;\r\n\r\n            BOpdracht? opdracht = bgrRegel?.MaakWijzigStringOpdracht(klassiek, stuIndex, gegevenNr, waarde);\r\n            if (opdracht == null)\r\n                return null;\r\n\r\n            if (opdracht is BVerhoogNiveauBgrRegel verhoogNiveauOpdracht)\r\n                verhoogNiveauOpdracht.VerhoogNiveau = _optieNiveauWisseling.IsMeedegraderenGewenst();\r\n\r\n            if (opdrachtValidator != null && !opdrachtValidator.ValideerOpdracht(opdracht))\r\n                return null;\r\n\r\n            if (!opdracht.Uitvoeren(this))\r\n                return null;\r\n\r\n            if (opdracht._Hertekenen != EHertekenen.Lokaal)\r\n                lokaal = false;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                _OpdrachtVzl.Aanmelden(opdracht);\r\n            }\r\n            opdracht._RegelNummer = stuIndex;\r\n            _Context = opdracht._Context;\r\n\r\n            return opdracht;\r\n        }\r\n\r\n        public BOpdracht? WijzigValuta(int vltId, bool alles)\r\n        {\r\n            if (_VltId == vltId && !alles)\r\n                return null;\r\n            BWijzigValuta opdracht = new BWijzigValuta(_VltId, vltId, alles, m_BasisValuta!);\r\n            Uitvoeren(opdracht);\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n\r\n        /// <summary>Wijzig het vasttotaal id van de begroting als gevolg van een opdracht\r\n        /// - Moet o.a. gedaan worden als de \"$\" stuurcode in een \"-\" gewijzigd wordt\r\n        /// </summary>\r\n        /// <param name=\"opdracht\"></param>\r\n        /// <param name=\"vttId\"></param>\r\n        internal void WijzigVttId(BWijzigStatusBgrRegel opdracht, int vttId)\r\n        {\r\n            Debug.Assert((m_VttId == 0 && vttId != 0) || (m_VttId != 0 && vttId == 0), \"Onverwachte waarde bij wijzigen vast totaal id\");\r\n            Debug.Assert(opdracht._VttKostenpostId != 0, \"Opdracht heeft geen vast totaal id wijziging in de kostenpost veroorzaakt\");\r\n            Debug.Assert(vttId == 0 || (vttId != 0 && opdracht._VttKostenpostId == vttId), \"Ongeldige waarde verschil tussen opdracht en parameter\");\r\n\r\n            m_VttId = vttId;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Wijs een kostenpost aan waarmee naar een vast totaalbedrag wordt gerekend\r\n        /// </summary>\r\n        /// <param name=\"id\">ID van de kostenpost (mag ook 0 zijn, dan wordt er niet meer naar een vast totaal gerekend)</param>\r\n        /// <returns>true: de vast-totaal-kostenpost is gewijzigd</returns>\r\n        public BOpdracht? WijzigVttId(int id)\r\n        {\r\n            int stuIndex = 0;\r\n            if (id > 0)\r\n                stuIndex = _Stu.ZoekKostenpost(id);\r\n            BWijzigVttId opdracht = new BWijzigVttId(stuIndex);\r\n            if (!Uitvoeren(opdracht))\r\n                return null;\r\n\r\n            _OpdrachtVzl.Aanmelden(opdracht);\r\n            return opdracht;\r\n        }\r\n\r\n        public BOpdracht? KopieerRefRegelData(int stuIndex, IBegrotingsRegel refRegel, IBegrotingsRegel bgrRegel)\r\n        {\r\n            Debug.Assert(m_Stu != null);\r\n            Debug.Assert(stuIndex >= 0);\r\n\r\n            KopieerReferentieRegelDataOpdracht? vorigeOpdracht = _OpdrachtVzl.GeefOpdracht() as KopieerReferentieRegelDataOpdracht;\r\n\r\n            KopieerReferentieRegelDataOpdracht opdracht = new KopieerReferentieRegelDataOpdracht(stuIndex, refRegel, bgrRegel, vorigeOpdracht);\r\n\r\n            if (!opdracht.Uitvoeren(null!))\r\n                return null;\r\n\r\n            if (!m_Snel)\r\n            {\r\n                if (opdracht._Rekenen)\r\n                    Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n                if (opdracht.MoetSamenvoegen)\r\n                {\r\n                    vorigeOpdracht?.Samenvoegen(opdracht);  // Voeg de gegevens in de vorige opdracht samen met die van de nieuwe\r\n                }\r\n                else\r\n                {\r\n                    _OpdrachtVzl.Aanmelden(opdracht);\r\n                }\r\n            }\r\n            opdracht._RegelNummer = opdracht.StuIndex;\r\n            _Context = opdracht._Context;\r\n\r\n            return opdracht;\r\n        }\r\n\r\n        #endregion\r\n\r\n        #region Functies om begrotingsregels te maken\r\n        /// <summary>\r\n        /// Maak een commentaarregel aan en voeg hem toe aan de structuur van de begroting\r\n        /// NB Dit is bedoeld voor conversie van TRAD-5 begrotingen\r\n        /// </summary>\r\n        /// <param name=\"elementId\">ID van het parentelement</param>\r\n        /// <param name=\"eindeBegroting\">true: laatste regel van de begroting, false: laatste regel van de elementonderbouwing</param>\r\n        /// <returns>De nieuwe commentaarregel</returns>\r\n        public BCommentaar? MaakCommentaar(int elementId, bool eindeBegroting)\r\n        {\r\n            // Nieuw commentaar aanmaken\r\n            BStructuurRegel stuRegel = MaakCommentaar(elementId);\r\n            if (eindeBegroting)\r\n                _Stu.Toevoegen(stuRegel);\r\n            else\r\n                _Stu.Invoegen(stuRegel, elementId, -1);  // -1: invoegpositie is einde vh element\r\n            return stuRegel._Regel as BCommentaar;\r\n        }\r\n        public BStructuurRegel MaakCommentaar(int elementId)\r\n        {\r\n            Debug.Assert(_Stu._Aantal > 0 && _Stu[0]._Regel != null, \"Geen rootelement aanwezig in begrotingsstructuur\");\r\n\r\n            // Nieuw commentaar aanmaken\r\n            BCommentaar commentaar = new(GeefNieuwId(), this);\r\n\r\n            // Wijzigingen in de structuur opnemen\r\n            var stuRegel = new BStructuurRegel(commentaar, elementId);\r\n\r\n            return stuRegel;\r\n        }\r\n        /// <summary>\r\n        /// Maak een nieuw element aan en plaats het in de begrotingsstructuur\r\n        /// </summary>\r\n        /// <param name=\"parentId\">Welk element wordt hiermee onderbouwd?</param>\r\n        /// <param name=\"invoegPositie\">Op welke plaats (1, 2, ...) in de onderbouwing komt dit element?</param>\r\n        /// <returns>Het nieuwe element</returns>\r\n        public BElement? MaakElement(int parentId, int invoegPositie)\r\n        {\r\n            Debug.Assert(m_Stu != null);\r\n\r\n            BStructuurRegel stuRegel = MaakElement(parentId);\r\n            _Stu.Invoegen(stuRegel, parentId, invoegPositie);\r\n            return stuRegel._Regel as BElement;\r\n        }\r\n        /// <summary>\r\n        /// Maak een element aan en voeg het toe aan de structuur van de begroting\r\n        /// NB Dit is bedoeld voor conversie van TRAD-5 begrotingen\r\n        /// </summary>\r\n        /// <param name=\"parentId\">ID van het parentelement</param>\r\n        /// <param name=\"eindeBegroting\">true: laatste regel van de begroting, false: laatste regel van de elementonderbouwing</param>\r\n        /// <returns>Het nieuwe element</returns>\r\n        public BElement MaakElement(int parentId, bool eindeBegroting)\r\n        {\r\n            BStructuurRegel stuRegel = MaakElement(parentId);\r\n            if (eindeBegroting)\r\n                _Stu.Toevoegen(stuRegel);\r\n            else\r\n                _Stu.Invoegen(stuRegel, parentId, -1);  // -1: invoegpositie is einde vh element\r\n            return (BElement)stuRegel._Regel!;\r\n        }\r\n        public BStructuurRegel MaakElement(int parentId)\r\n        {\r\n            var element = new BElement(GeefNieuwId(), _VltId, this);\r\n            var stuRegel = new BStructuurRegel(element, parentId);\r\n            return stuRegel;\r\n        }\r\n        /// <summary>\r\n        /// Maak een kostenpost aan en voeg hem toe aan de structuur van de begroting\r\n        /// NB Dit is bedoeld voor conversie van TRAD-5 begrotingen\r\n        /// </summary>\r\n        /// <param name=\"elementId\">ID van het parentelement</param>\r\n        /// <param name=\"eindeBegroting\">true: laatste regel van de begroting, false: laatste regel van de elementonderbouwing</param>\r\n        /// <returns>De nieuwe kostenpost</returns>\r\n        public BKostenpost? MaakKostenpost(int elementId, bool eindeBegroting)\r\n        {\r\n            // Nieuwe kostenpost aanmaken met standaarduurloon en zonder verzamelpost\r\n            BStructuurRegel stuRegel = MaakKostenpost(elementId);\r\n            if (eindeBegroting)\r\n                _Stu.Toevoegen(stuRegel);\r\n            else\r\n                _Stu.Invoegen(stuRegel, elementId, -1);  // -1: invoegpositie is einde vh element\r\n            return stuRegel._Regel as BKostenpost;\r\n        }\r\n        public BKostenpost? MaakKostenpost(int elementId, int invoegPositie)\r\n        {\r\n            // Nieuwe kostenpost aanmaken met standaarduurloon en zonder verzamelpost\r\n            BStructuurRegel stuRegel = MaakKostenpost(elementId);\r\n            _Stu.Invoegen(stuRegel, elementId, invoegPositie);\r\n            return stuRegel._Regel as BKostenpost;\r\n        }\r\n        public BStructuurRegel MaakKostenpost(int elementId)\r\n        {\r\n            Debug.Assert(_Stu._Aantal > 0 && _Stu[0]._Regel != null, \"Geen rootelement aanwezig in begrotingsstructuur\");\r\n\r\n            // Nieuwe kostenpost aanmaken met standaarduurloon en zonder verzamelpost\r\n            var kostenpost = new BKostenpost(GeefNieuwId(), string.Empty, _VltId, this);\r\n\r\n            // Nieuw middel aanmaken, aan kostenpost koppelen en in de middelenlijst opnemen\r\n            var middel = new BMiddel(GeefNieuwId(), _VltId);\r\n            middel.MiddelGewijzigd += MiddelGewijzigd;\r\n            kostenpost.WijzigMiddel(middel, false);    // rekenen is niet nodig want _Hvh == 0.0\r\n\r\n            _Mid.MiddelToevoegen(middel);\r\n\r\n            if (_ibisConfiguration?.Functions?.CreateBewakingscodeFromElement?.Value ?? false == true)\r\n            {\r\n                bool gegevensAanvullen = false;\r\n                switch (m_ActieContext)\r\n                {\r\n                    case EActieContext.ToevoegenRegelEronder:\r\n                    case EActieContext.ToevoegenRegelErvoor:\r\n                    case EActieContext.ToevoegenRegelNaEnter:\r\n                        gegevensAanvullen = true;\r\n                        break;\r\n                }\r\n                if (gegevensAanvullen)\r\n                {\r\n                    int elementIndex = _Stu.ZoekElement(elementId);\r\n                    if (elementIndex > 0)\r\n                    {\r\n                        if (_Stu[elementIndex]._Regel is BElement element)\r\n                        {\r\n                            kostenpost._BwcArb = element._BwcArb;\r\n                            kostenpost._BwcMta = element._BwcMta;\r\n                            kostenpost._BwcMte = element._BwcMte;\r\n                            kostenpost._BwcOda = element._BwcOda;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n            // Wijzigingen in de structuur opnemen\r\n            var stuRegel = new BStructuurRegel(kostenpost, elementId);\r\n            return stuRegel;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Maak een opslagpost aan en voeg hem toe aan de structuur van de begroting\r\n        /// NB Dit is bedoeld voor conversie van TRAD-5 begrotingen\r\n        /// </summary>\r\n        /// <param name=\"elementId\">ID van het parentelement</param>\r\n        /// <param name=\"eindeBegroting\">true: laatste regel van de begroting, false: laatste regel van de elementonderbouwing</param>\r\n        /// <returns>De nieuwe opslagpost</returns>\r\n        public BOpslagpost? MaakOpslagpost(int elementId, bool eindeBegroting)\r\n        {\r\n            // Nieuwe opslagpost aanmaken\r\n            BStructuurRegel stuRegel = MaakOpslagpost(elementId);\r\n            if (eindeBegroting)\r\n                _Stu.Toevoegen(stuRegel);\r\n            else\r\n                _Stu.Invoegen(stuRegel, elementId, -1);  // -1: invoegpositie is einde vh element\r\n            return stuRegel._Regel as BOpslagpost;\r\n        }\r\n        public BOpslagpost? MaakOpslagpost(int elementId, int invoegPositie)\r\n        {\r\n            BStructuurRegel stuRegel = MaakOpslagpost(elementId);\r\n            _Stu.Invoegen(stuRegel, elementId, invoegPositie);\r\n            return stuRegel._Regel as BOpslagpost;\r\n        }\r\n        public BStructuurRegel MaakOpslagpost(int elementId)\r\n        {\r\n            // Nieuwe opslagpost aanmaken\r\n            var opslagpost = new BOpslagpost(GeefNieuwId(), _VltId, this, BBegrotingsRegel.c_sStkSubOpslag);\r\n\r\n            // Wijzigingen in de structuur opnemen\r\n            var stuRegel = new BStructuurRegel(opslagpost, elementId);\r\n\r\n            return stuRegel;\r\n        }\r\n        public IEnumerable<IBegrotingsRegel> GeefSelectieBegrotingsRegels(BSelectie selectie)\r\n        {\r\n            selectie.Reset();\r\n\r\n            while (selectie.GeefVolgendeRange(out int begin, out int eind))\r\n            {\r\n                for (int rij = begin; rij < eind; rij++)\r\n                {\r\n                    BStructuurRegel stuRegel = _Stu[rij + 1];\r\n                    if (stuRegel._Regel != null)\r\n                        yield return stuRegel._Regel;\r\n                }\r\n            }\r\n        }\r\n        #endregion\r\n\r\n        #region Begrotingblad\r\n        public void BegrotingBladRekenen()\r\n        {\r\n            GeefBgrBladTabel();   // negeer returnwaarde\r\n        }\r\n        public BBgrBladTabel GeefBgrBladTabel()\r\n        {\r\n            Debug.Assert(m_Bbd != null, \"Er is nog geen begrotingsblad in het BBegroting-object\");\r\n\r\n            if (m_Bbd._MoetRekenen)\r\n                MoetRekenen = true;\r\n\r\n            Rekenen(ERekendiepte.Wijzigingen);\r\n\r\n            return m_Bbd._Tabel;\r\n        }\r\n        public BBgrBladTabel MaakBgrBladTabel()\r\n        {\r\n            return GeefBgrBladTabel();\r\n        }\r\n        public void VervangBegrotingsBlad(IBegrotingBlad Bbd)\r\n        {\r\n            m_Bbd = Bbd;\r\n        }\r\n        #endregion\r\n\r\n        #region _OpdrachtVzl.Meetstaat\r\n\r\n        public void MeetstaatVasteHoeveelheidIndicatieToepassen(IBegrotingsRegel regel)\r\n        {\r\n            if (_Tpe == EBgrTpe.Elementen && _VasteHoeveelheidIndicatieToepassen)\r\n            // if (_VasteHoeveelheidIndicatieToepassen)\r\n            {\r\n                //als de string al gewijzigd is in \"<\" hoeft deze opdracht niet uitgevoerd worden.\r\n                if (\"<\" != regel.GeefString(BBegrotingsRegel.EGegeven.dri, false))//NIETVERTALEN\r\n                {\r\n                    int stuIndex = _Stu.ZoekId(regel._Id);\r\n                    BOpdracht? opdracht = WijzigStringBgrRegel(true, stuIndex, BBegrotingsRegel.EGegeven.dri, \"<\", null, out bool lokaal); //!m_Filter\r\n                    opdracht?.Uitvoeren(this);\r\n                    _OpdrachtVzl.Aanmelden(opdracht);\r\n                }\r\n            }\r\n        }\r\n\r\n        public void VerhoogMeetstaatVersie()\r\n        {\r\n            _MeetstaatVersie = m_Versie + 1;\r\n        }\r\n        public BMeetstaat? MeetstaatToevoegen(BMeetstaatModel kopieModel, int stuIndex)\r\n        {\r\n            // Controleer de begrotingsregel\r\n            IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n            if (bgrRegel?._Koppelbaar != true)\r\n                return null;\r\n\r\n            // Als het om een algemeen meetstaatmodel gaat\r\n            // dan eerst importeren (genereert ook een opdracht!)\r\n            if (!_MeetstaatModelVzl.HeeftModel(kopieModel))\r\n            {\r\n                kopieModel = new BMeetstaatModel(-1, kopieModel, BewaarItemMutatieStatus.Nieuw);\r\n                m_MeetstaatModelVzl?.SchrijfMeetstaatModel(kopieModel, EnumConverter.VanBooleans(true, false, true), stuIndex, false);\r\n            }\r\n\r\n            MeetstaatToevoegenOpdracht toevoegenOpdracht = new MeetstaatToevoegenOpdracht(this, kopieModel, stuIndex);\r\n            toevoegenOpdracht._ViewNr = _ViewNr;\r\n            _OpdrachtVzl.Uitvoeren(toevoegenOpdracht);\r\n            return toevoegenOpdracht.Meetstaat;\r\n        }\r\n        /// <summary>\r\n        /// Meetstaat aanmaken tbv conversie\r\n        /// </summary>\r\n        /// <param name=\"model\">Het van toepassing zijnde meetstaatmodel</param>\r\n        /// <param name=\"omschrijving\">Omschrijving van de meetstaat (die anders uit de begrotingsregel komt)</param>\r\n        /// <param name=\"opmaakNaam\">Naam van de voor deze meetstaat laatst gebruikte opmaak</param>\r\n        /// <returns>De nieuwe meetstaat</returns>\r\n        public BMeetstaat CnvMeetstaatToevoegen(BMeetstaatModel model, string omschrijving, string opmaakNaam)\r\n        {\r\n            // Maak de meetstaat\r\n            BMeetstaat meetstaat = new BMeetstaat(model, true);  // true: nieuwe meetstaat\r\n            meetstaat._Id = GeefNieuwId();\r\n            meetstaat.WijzigOmschrijving(omschrijving);\r\n            meetstaat.WijzigOpmaak(opmaakNaam);\r\n            meetstaat.Begroting = this;\r\n\r\n            // Voeg de meetstaat toe aan de lijst\r\n            _Meetstaten.Add(meetstaat);\r\n\r\n            return meetstaat;\r\n        }\r\n\r\n        public bool MeetstaatKoppelen(IMeetstaat meetstaat, int stuIndex)\r\n        {\r\n            if (meetstaat._Model == null) return false;\r\n\r\n            int sgkId = meetstaat._Model._StandaardGekoppeldeKolomId;\r\n            var koppeling =\r\n               new BMeetstaatKoppeling(BewaarItemMutatieStatus.Nieuw, meetstaat._Id, sgkId, BMeetstaatRegel.c_TotaalRegelId);\r\n\r\n            return MeetstaatKoppelen(meetstaat, stuIndex, koppeling);\r\n        }\r\n\r\n        public bool MeetstaatKoppelen(int kolomNr, int regelNr, IMeetstaat meetstaat, int stuIndex)\r\n        {\r\n            // Als er geen kolom- ?n geen regelnummer bekend is dan wordt het een standaardkoppeling\r\n            if (kolomNr < 0 && regelNr < 0)\r\n                return MeetstaatKoppelen(meetstaat, stuIndex);\r\n\r\n            // Maak de koppeling\r\n            BMeetstaatKoppeling? koppeling = meetstaat.MaakKoppeling(kolomNr, regelNr);\r\n\r\n            return MeetstaatKoppelen(meetstaat, stuIndex, koppeling!);\r\n        }\r\n\r\n        private bool MeetstaatKoppelen(IMeetstaat meetstaat, int stuIndex, BMeetstaatKoppeling koppeling)\r\n        {\r\n            // Controleer de begrotingsregel\r\n            IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n            if (bgrRegel?._Koppelbaar != true)\r\n                return false;\r\n\r\n            Debug.Assert(koppeling._Nieuw, \"MeetstaatKoppelen() - nieuw id maar geen nieuwe koppeling\");\r\n            koppeling._KoppelingId = GeefNieuwId();\r\n\r\n            var opdracht = new MeetstaatKoppelenOpdracht(this, meetstaat, stuIndex, koppeling)\r\n            {\r\n                _ViewNr = _ViewNr\r\n            };\r\n            return _OpdrachtVzl.Uitvoeren(opdracht);\r\n        }\r\n\r\n        public bool MeetstaatOntkoppelen(BSelectie selectie, bool moduleMeten)\r\n        {\r\n            MeetstaatOntkoppelenOpdracht ontkoppelenOpdracht = new MeetstaatOntkoppelenOpdracht(this, selectie, moduleMeten);\r\n            ontkoppelenOpdracht._ViewNr = _ViewNr;\r\n            return _OpdrachtVzl.Uitvoeren(ontkoppelenOpdracht);\r\n        }\r\n        public bool MeetstaatHerstellen(BSelectie? selectie)\r\n        {\r\n            var opdracht = new TradMeetstaatKoppelingHerstellenOpdracht(this, selectie, _ViewNr);\r\n            return _OpdrachtVzl.Uitvoeren(opdracht);\r\n        }\r\n        public bool MeetstaatHerstellen(IMeetstaat meetstaat)\r\n        {\r\n            var opdracht = new TradMeetstaatKoppelingHerstellenOpdracht(this, meetstaat, _ViewNr);\r\n            return _OpdrachtVzl.Uitvoeren(opdracht);\r\n        }\r\n        public int GeefMeetstaatId(IBegrotingsRegel? bgrRegel)\r\n        {\r\n            if (bgrRegel == null) return -1;\r\n            if (bgrRegel._Koppelbaar)\r\n            {\r\n                BMeetstaatKoppeling? koppeling = ZoekMeetstaatKoppeling(bgrRegel._MstKid);\r\n                if (koppeling != null)\r\n                    return koppeling._MeetstaatId;\r\n            }\r\n            return -1;\r\n        }\r\n        public BMeetstaat? GeefMeetstaat(IBegrotingsRegel bgrRegel)\r\n        {\r\n            return GeefMeetstaat(bgrRegel, out BMeetstaatKoppeling? _);\r\n        }\r\n        public BMeetstaat? GeefMeetstaat(IBegrotingsRegel bgrRegel, out BMeetstaatKoppeling? koppeling)\r\n        {\r\n            if (bgrRegel._Koppelbaar)\r\n            {\r\n                koppeling = ZoekMeetstaatKoppeling(bgrRegel._MstKid);\r\n                if (koppeling != null)\r\n                    return GeefMeetstaat(koppeling._MeetstaatId);\r\n            }\r\n            else\r\n            {\r\n                koppeling = null;\r\n            }\r\n            return null;\r\n        }\r\n        public BMeetstaat? GeefMeetstaat(int meetstaatId, bool volledigInlezen)\r\n        {\r\n            if (meetstaatId != 0)\r\n            {\r\n                foreach (BMeetstaat meetstaat in _Meetstaten)\r\n                {\r\n                    if (meetstaat._Id == meetstaatId)\r\n                    {\r\n                        if (volledigInlezen)\r\n                            LeesMeetstaat(meetstaat);\r\n                        return meetstaat;\r\n                    }\r\n                }\r\n            }\r\n            return null;\r\n        }\r\n        public BMeetstaat? GeefMeetstaat(int meetstaatId)\r\n        {\r\n            return GeefMeetstaat(meetstaatId, true);\r\n            //if(m_Meetstaten != null && meetstaatId != 0)\r\n            //{\r\n            //   foreach(BMeetstaat meetstaat in m_Meetstaten)\r\n            //   {\r\n            //      if(meetstaat._Id == meetstaatId)\r\n            //      {\r\n            //         LeesMeetstaat(meetstaat);\r\n            //         return meetstaat;\r\n            //      }\r\n            //   }\r\n            //}\r\n            //return null;\r\n        }\r\n        public string LeesMeetstaat(IMeetstaat meetstaat)\r\n        {\r\n            string resultaat = string.Empty;\r\n            if (meetstaat._Leeg)\r\n            {\r\n                Debug.Assert(MeetstaatLezer != null, \"BBegroting.LeesMeetstaat() - geen MeetstaatLezer\");\r\n                resultaat = MeetstaatLezer.LeesMeetstaat(meetstaat);\r\n            }\r\n            return resultaat;\r\n        }\r\n        public bool IsModelGebruikt(IMeetstaatModel model)\r\n        {\r\n            int id = model._ModelId;\r\n            if (id <= 0)\r\n                id = -99;\r\n\r\n            foreach (BMeetstaat meetstaat in _Meetstaten)\r\n            {\r\n                if (meetstaat._Model == model || meetstaat._Model?._ModelId == id)\r\n                    return true;\r\n            }\r\n            return false;\r\n        }\r\n\r\n        public bool IsMeetstaatGekoppeld(IMeetstaat meetstaat)\r\n        {\r\n            if (_MeetstaatKoppelingen._Aantal > 0)\r\n            {\r\n                for (int index = _MeetstaatKoppelingen._Aantal - 1; index >= 0; index--)\r\n                {\r\n                    if (_MeetstaatKoppelingen[index]._MeetstaatId == meetstaat._Id)\r\n                        return true;\r\n                }\r\n            }\r\n            return false;\r\n        }\r\n        public bool IsMeetstaatRegelGekoppeld(IMeetstaatRegel meetstaatRegel, IMeetstaat meetstaat)\r\n        {\r\n            if (_MeetstaatKoppelingen._Aantal > 0 && meetstaatRegel._Id != 0)\r\n            {\r\n                BMeetstaatKoppeling koppeling;\r\n                for (int index = _MeetstaatKoppelingen._Aantal - 1; index >= 0; index--)\r\n                {\r\n                    koppeling = _MeetstaatKoppelingen[index];\r\n                    if (koppeling._MeetstaatId == meetstaat._Id &&\r\n                       koppeling._RegelId == meetstaatRegel._Id)\r\n                        return true;\r\n                }\r\n            }\r\n            return false;\r\n        }\r\n        public bool IsKolomGekoppeld(IMeetstaatModel model, int kolomId)\r\n        {\r\n            if (_MeetstaatKoppelingen._Aantal > 0)\r\n            {\r\n                BMeetstaatKoppeling koppeling;\r\n                foreach (BMeetstaat meetstaat in _Meetstaten)\r\n                {\r\n                    if (meetstaat._Model == model ||\r\n                       meetstaat._Model?._ModelId == model._ModelId)\r\n                    {\r\n                        for (int index = _MeetstaatKoppelingen._Aantal - 1; index >= 0; index--)\r\n                        {\r\n                            koppeling = _MeetstaatKoppelingen[index];\r\n                            if (koppeling._MeetstaatId == meetstaat._Id &&\r\n                               koppeling._KolomId == kolomId)\r\n                                return true;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n            return false;\r\n        }\r\n\r\n        public bool[] GekoppeldeKolommenMeetstaatRegel(IMeetstaatRegel meetstaatRegel, IMeetstaat meetstaat)\r\n        {\r\n            List<IMeetstaatKolom> kolommen = meetstaat._Model?._Kolommen ?? new List<IMeetstaatKolom>();\r\n            int ak = kolommen.Count;\r\n            bool[] kolomGekoppeld = new bool[ak];\r\n            if (_MeetstaatKoppelingen._Aantal > 0 && meetstaatRegel._Id != 0)\r\n            {\r\n                BMeetstaatKoppeling koppeling;\r\n                for (int index = _MeetstaatKoppelingen._Aantal - 1; index >= 0; index--)\r\n                {\r\n                    koppeling = _MeetstaatKoppelingen[index];\r\n                    if (koppeling._MeetstaatId == meetstaat._Id &&\r\n                       koppeling._RegelId == meetstaatRegel._Id)\r\n                    {\r\n                        int kolomNr = koppeling._KolomNr;\r\n                        if (kolomNr < 0 || kolomNr >= ak ||\r\n                           kolommen[kolomNr]._Id != koppeling._KolomId)\r\n                        {\r\n                            kolomNr = meetstaat._Model?.GeefKolomNr(koppeling._KolomId) ?? -1;\r\n                            if (kolomNr >= 0)\r\n                                koppeling._KolomNr = kolomNr;\r\n                        }\r\n                        if (kolomNr >= 0)\r\n                        {\r\n                            kolomGekoppeld[kolomNr] = true;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n            return kolomGekoppeld;\r\n        }\r\n        public int GeefAantalMeetstaten(IMeetstaatModel model)\r\n        {\r\n            int aantal = 0;\r\n            foreach (BMeetstaat meetstaat in _Meetstaten)\r\n            {\r\n                if (meetstaat._Model == model)\r\n                    aantal++;\r\n            }\r\n            return aantal;\r\n        }\r\n        public int GeefAantalKoppelingen(BMeetstaat meetstaat)\r\n        {\r\n            int aantal = 0;\r\n            if (_MeetstaatKoppelingen._Aantal > 0)\r\n            {\r\n                for (int index = _MeetstaatKoppelingen._Aantal - 1; index >= 0; index--)\r\n                {\r\n                    if (_MeetstaatKoppelingen[index]._MeetstaatId == meetstaat._Id)\r\n                        aantal++;\r\n                }\r\n            }\r\n            return aantal;\r\n        }\r\n        public bool HeeftKoppelingen(IMeetstaat meetstaat)\r\n        {\r\n\r\n            if (_MeetstaatKoppelingen._Aantal > 0)\r\n            {\r\n                //De koppeling kan afkomstig zijn uit de begroting of het begrotingsBlad\r\n                BMeetstaatKoppeling koppeling;\r\n\r\n                for (int index = _MeetstaatKoppelingen._Aantal - 1; index >= 0; index--)\r\n                {\r\n                    koppeling = _MeetstaatKoppelingen[index];\r\n                    if (koppeling._MeetstaatId == meetstaat._Id)\r\n                    {\r\n                        if (0 == koppeling._DocumentId)  // Afkomstig uit begrotingsblad\r\n                        {\r\n                            if (0 == _Bbd._Tabel._Lijst.Count)  // Lees de begrotingstabelgegevens, en reken\r\n                            {\r\n                                BegrotingBladRekenen();\r\n                            }\r\n                            foreach (BBgrBladRegel item in _Bbd._Tabel._Lijst)\r\n                            {\r\n                                if (null != item._Functie &&\r\n                                    Math.Abs(item._Functie._MstKid) == Math.Abs(koppeling._KoppelingId))  // Als de koppelingsid gelijk is\r\n                                {\r\n                                    return true;\r\n                                }\r\n                            }\r\n                        }\r\n                        else //  Afkomstig uit begroting\r\n                        {\r\n                            if (HeeftGekoppeldeBegrotingsRegel(koppeling))\r\n                                return true;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n            return false;\r\n        }\r\n        public int GeefAantalKoppelingen(IMeetstaat meetstaat, out int aantalOverschreven)\r\n        {\r\n            int aantal = 0;\r\n            aantalOverschreven = 0;\r\n\r\n            if (_MeetstaatKoppelingen._Aantal > 0)\r\n            {\r\n                //De koppeling kan afkomstig zijn uit de begroting of het begrotingsBlad\r\n                IBegrotingsRegel? bgrRegel;\r\n                BMeetstaatKoppeling koppeling;\r\n                for (int index = _MeetstaatKoppelingen._Aantal - 1; index >= 0; index--)\r\n                {\r\n                    koppeling = _MeetstaatKoppelingen[index];\r\n                    if (koppeling._MeetstaatId == meetstaat._Id)\r\n                    {\r\n                        if (0 == koppeling._DocumentId)//afkomstig uit begrotingsblad\r\n                        {\r\n                            if (0 == _Bbd._Tabel._Lijst.Count)//lees de begrotingstabel gegevens, en reken\r\n                            {\r\n                                BegrotingBladRekenen();\r\n                            }\r\n                            foreach (BBgrBladRegel item in _Bbd._Tabel._Lijst)\r\n                            {\r\n                                if (null != item._Functie)\r\n                                {\r\n                                    if (Math.Abs(item._Functie._MstKid) == Math.Abs(koppeling._KoppelingId))//als de koppelingsid gelijk is\r\n                                    {\r\n                                        aantal++;\r\n                                        Debug.Assert(item._Functie._KoppelingStatus != EKoppelingStatus.Geen, \"BBegroting.GeefAantalKoppelingen() - geen koppeling\");\r\n\r\n                                        if (item._Functie._KoppelingStatus == EKoppelingStatus.Geen)\r\n                                            aantal = 0;\r\n\r\n                                        if (item._Functie._KoppelingStatus == EKoppelingStatus.Overschreven)\r\n                                            aantalOverschreven++;\r\n                                    }\r\n                                    //break;\r\n                                }\r\n                            }\r\n                        }\r\n                        else //afkomstig uit begroting\r\n                        {\r\n                            bgrRegel = ZoekGekoppeldeBegrotingsRegel(koppeling);\r\n                            if (bgrRegel != null)\r\n                            {\r\n                                aantal++;\r\n\r\n                                Debug.Assert(bgrRegel._KoppelingStatus != EKoppelingStatus.Geen, \"BBegroting.GeefAantalKoppelingen() - geen koppeling\");\r\n\r\n                                if (bgrRegel._KoppelingStatus == EKoppelingStatus.Geen)\r\n                                    aantal = 0;\r\n\r\n                                if (bgrRegel._KoppelingStatus == EKoppelingStatus.Overschreven)\r\n                                    aantalOverschreven++;\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n            return aantal;\r\n        }\r\n\r\n        public void HoeveelhedenOvernemen(IMeetstaat meetstaat)\r\n        {\r\n            if (meetstaat == null || _MeetstaatKoppelingen._Aantal == 0)\r\n                return;\r\n\r\n            BMeetstaatKoppeling koppeling;\r\n            bool wijziging = false;\r\n\r\n            for (int index = _MeetstaatKoppelingen._Aantal - 1; index >= 0; index--)\r\n            {\r\n                koppeling = _MeetstaatKoppelingen[index];\r\n                if (koppeling._MeetstaatId != meetstaat._Id)\r\n                    continue;\r\n\r\n                double hvh = meetstaat.GeefGekoppeldeWaarde(koppeling, out bool geenWaarde);\r\n                if (geenWaarde)\r\n                    continue;\r\n\r\n                if (koppeling._DocumentId != 0)\r\n                {\r\n                    if (HoeveelhedenOvernemenBgr(meetstaat, koppeling, hvh))\r\n                        wijziging = true;\r\n\r\n                    if (_BrinkKostenbestandEigenschappenOnderhoud?._MJOBActiefBerekenen != true)\r\n                    {\r\n                        _MjobContanteWaardeIsActueel = false;\r\n                    }\r\n                }\r\n                else\r\n                {\r\n                    // Het is geen begrotingsregel: is het een begrotingblad of algemene gegevens koppeling\r\n                    if (HoeveelhedenOvernemenAlg(meetstaat, koppeling, hvh))\r\n                        wijziging = true;\r\n\r\n                    if (HoeveelhedenOvernemenBbd(meetstaat, koppeling, hvh))\r\n                        wijziging = true;\r\n                }\r\n            }\r\n\r\n            if (wijziging)\r\n            {\r\n                _OpdrachtVzl.Gewijzigd();\r\n            }\r\n        }\r\n\r\n        private bool HoeveelhedenOvernemenBgr(IMeetstaat meetstaat, BMeetstaatKoppeling koppeling, double hvh)\r\n        {\r\n            IBegrotingsRegel? bgrRegel = ZoekGekoppeldeBegrotingsRegel(koppeling);\r\n            if (bgrRegel == null)\r\n                return false;\r\n\r\n            Debug.Assert(bgrRegel._KoppelingStatus != EKoppelingStatus.Geen, \"BBegroting.HoeveelhedenOvernemen() - geen koppeling\");\r\n            if (bgrRegel._KoppelingStatus != EKoppelingStatus.Gekoppeld)\r\n                return false;\r\n\r\n            return bgrRegel.MeetstaatHoeveelheid(hvh);\r\n        }\r\n\r\n        private bool HoeveelhedenOvernemenBbd(IMeetstaat meetstaat, BMeetstaatKoppeling koppeling, double hvh)\r\n        {\r\n            return m_Bbd?.HoeveelhedenOvernemen(meetstaat, koppeling, hvh) ?? false;\r\n        }\r\n\r\n        private bool HoeveelhedenOvernemenAlg(IMeetstaat meetstaat, BMeetstaatKoppeling koppeling, double hvh)\r\n        {\r\n            bool wijziging = false;\r\n            foreach (BGebruikersGegeven ggv in m_Ggv ?? Enumerable.Empty<BGebruikersGegeven>())\r\n            {\r\n                if (ggv._Mstkid == koppeling._KoppelingId)\r\n                {\r\n                    if (ggv.WijzigDouble(hvh))\r\n                        wijziging = true;\r\n                }\r\n            }\r\n            return wijziging;\r\n        }\r\n\r\n        public string? MeetstaatVerwijderen(IMeetstaat meetstaat)\r\n        {\r\n            MeetstaatVerwijderenOpdracht verwijderenOpdracht = new MeetstaatVerwijderenOpdracht(this, meetstaat);\r\n            verwijderenOpdracht._ViewNr = _ViewNr;\r\n            _OpdrachtVzl.Uitvoeren(verwijderenOpdracht);\r\n            return verwijderenOpdracht.Melding;\r\n        }\r\n        public void GewijzigdModel(IMeetstaatModel model)\r\n        {\r\n            bool meetstaatGewijzigd = false;\r\n            foreach (BMeetstaat meetstaat in _Meetstaten)\r\n            {\r\n                if (meetstaat._Model?._ModelId == model._ModelId)\r\n                {\r\n                    LeesMeetstaat(meetstaat);\r\n\r\n                    Debug.Assert(meetstaat.Begroting == this, \"BBegroting.GewijzigdModel() - ander meetstaatdocument\");\r\n                    meetstaat.GewijzigdModel(model);\r\n                    if (_MeetstaatKoppelingen._Aantal > 0)\r\n                        GewijzigdModelKoppelingen(meetstaat);\r\n                    meetstaat.Rekenen();\r\n                    meetstaatGewijzigd = true;\r\n                }\r\n            }\r\n            if (meetstaatGewijzigd)\r\n                OpdrachtenVergeten();\r\n        }\r\n        public BMeetstaatKoppeling? ZoekMeetstaatKoppeling(int kid)\r\n        {\r\n            if (_MeetstaatKoppelingen._Aantal > 0 && kid != 0)\r\n            {\r\n                if (kid < 0)\r\n                    kid = -kid;\r\n                BMeetstaatKoppeling koppeling;\r\n                for (int index = _MeetstaatKoppelingen._Aantal - 1; index >= 0; index--)\r\n                {\r\n                    koppeling = _MeetstaatKoppelingen[index];\r\n                    if (koppeling._KoppelingId == kid)\r\n                        return koppeling;\r\n                }\r\n            }\r\n            return null;\r\n        }\r\n        public int ZoekEerstGekoppeldeBgrRegel(int mstid)\r\n        {\r\n            int stuIndexGevonden = -1;\r\n            for (int stuIndex = 0; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                if (_Stu[stuIndex]._Regel != null && _Stu[stuIndex]._Regel?._HeeftInterneMeetstaat == true)\r\n                {\r\n                    if (mstid == GeefMeetstaatId(_Stu[stuIndex]._Regel))\r\n                    {\r\n                        stuIndexGevonden = stuIndex;\r\n                        break;\r\n                    }\r\n                }\r\n            }\r\n            return stuIndexGevonden;\r\n        }\r\n        public bool VerwijderMeetstaatKoppeling(int kid, out BMeetstaatKoppeling? mk, out BewaarItemMutatieStatus mut)\r\n        {\r\n            mk = null;\r\n            mut = BewaarItemMutatieStatus.Ongewijzigd;\r\n\r\n            if (_MeetstaatKoppelingen._Aantal > 0 && kid != 0)\r\n            {\r\n                if (kid < 0)\r\n                    kid = -kid;\r\n\r\n                BMeetstaatKoppeling koppeling;\r\n                for (int index = _MeetstaatKoppelingen._Aantal - 1; index >= 0; index--)\r\n                {\r\n                    koppeling = _MeetstaatKoppelingen[index];\r\n                    if (koppeling._KoppelingId == kid)\r\n                    {\r\n                        mk = koppeling;\r\n                        mut = koppeling._MutatieStatus;\r\n                        mk.ZetMutatieStatus(BewaarItemMutatieStatus.Verwijderd);\r\n                        _MeetstaatKoppelingen.Verwijderen(index);\r\n                        return true;\r\n                    }\r\n                }\r\n            }\r\n            return false;\r\n        }\r\n        private void VerwijderMeetstaat(int meetstaatId)\r\n        {\r\n            // Geen controles, er wordt geen opdracht gegenereerd\r\n            IMeetstaat meetstaat;\r\n            for (int index = _Meetstaten.Count - 1; index >= 0; index--)\r\n            {\r\n                meetstaat = _Meetstaten[index];\r\n                if (meetstaat._Id == meetstaatId)\r\n                {\r\n                    _Meetstaten.RemoveAt(index);\r\n                    _Metingen?.VerwijderMeetstaatMetingKoppelingen(meetstaatId);\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n        private void GewijzigdModelKoppelingen(BMeetstaat meetstaat)\r\n        {\r\n            if (_MeetstaatKoppelingen._Aantal > 0)\r\n            {\r\n                IMeetstaatModel? model = meetstaat._Model;\r\n\r\n                for (int kIndex = _MeetstaatKoppelingen._Aantal - 1; kIndex >= 0; kIndex--)\r\n                {\r\n                    BMeetstaatKoppeling koppeling = _MeetstaatKoppelingen[kIndex];\r\n                    if (koppeling._MeetstaatId == meetstaat._Id)\r\n                    {\r\n                        if (null == model?.GeefKolom(koppeling._KolomId))   // Gekoppelde kolom is verwijderd?\r\n                        {\r\n                            IBegrotingsRegel? bgrRegel = ZoekGekoppeldeBegrotingsRegel(koppeling);\r\n                            if (bgrRegel != null)\r\n                            {\r\n                                bgrRegel.MeetstaatKoppeling(null);\r\n                                _logboek.Toevoegen(\r\n                                   _DocumentNaam,\r\n                                   koppeling._DocumentNr,\r\n                                   $\"{ProjectResources.TradC19}{BStatics.c_Spatie}{bgrRegel._Aanduiding}{BStatics.c_Spatie}{ProjectResources.TradC110}\");\r\n                            }\r\n                            _MeetstaatKoppelingen.Verwijderen(kIndex);\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        internal bool HeeftGekoppeldeBegrotingsRegel(BMeetstaatKoppeling koppeling)\r\n        {\r\n            int stuIndex = koppeling._DocumentNr;\r\n            if (stuIndex >= 0 &&\r\n               stuIndex < _Stu._Aantal &&\r\n               _Stu[stuIndex]._Id == koppeling._DocumentId)\r\n            {\r\n                return true;\r\n            }\r\n\r\n            if (_Stu.ZoekId(koppeling._DocumentId, out stuIndex))\r\n            {\r\n                return true;\r\n            }\r\n\r\n            return false;\r\n        }\r\n        public IBegrotingsRegel? ZoekGekoppeldeBegrotingsRegel(BMeetstaatKoppeling koppeling)\r\n        {\r\n            bool gevonden = false;\r\n            int stuIndex = koppeling._DocumentNr;\r\n            if (stuIndex >= 0 &&\r\n               stuIndex < _Stu._Aantal &&\r\n               _Stu[stuIndex]._Id == koppeling._DocumentId)\r\n            {\r\n                gevonden = true;\r\n            }\r\n            else if (_Stu.ZoekId(koppeling._DocumentId, out stuIndex))\r\n            {\r\n                koppeling._DocumentNr = stuIndex;\r\n                gevonden = true;\r\n            }\r\n            if (gevonden)\r\n            {\r\n                _Stu.LeesBegrotingsRegel(stuIndex);\r\n                return _Stu[stuIndex]._Regel;\r\n            }\r\n            return null;\r\n        }\r\n        internal BBgrBladRegel? ZoekGekoppeldeBegrotingsbladRegel(BMeetstaatKoppeling koppeling)\r\n        {\r\n            BBgrBladRegel? gevondenBbdRegel = null;\r\n            // \r\n            if (_Bbd._Tabel._Lijst.Count == 0) // lees de begrotingstabel gegevens, en reken\r\n            {\r\n                BegrotingBladRekenen();\r\n            }\r\n\r\n            foreach (BBgrBladRegel bbdRegel in m_Bbd?._Tabel?._Lijst ?? Enumerable.Empty<BBgrBladRegel>())\r\n            {\r\n                if (bbdRegel._RegelSoort == BBgrBladRegel.EBbdRegelSoort.Functie)\r\n                {\r\n                    if (bbdRegel._Functie?._FunctieSoort == BBegrotingBladFunctie.EFunctieSoort.Eenheidsprijs)\r\n                    {\r\n                        if (bbdRegel._Functie._MstKid == koppeling._KoppelingId)\r\n                        {\r\n                            gevondenBbdRegel = bbdRegel;\r\n                            break;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n            return gevondenBbdRegel;\r\n        }\r\n        private void MeetstatenControleren()\r\n        {\r\n            foreach (BMeetstaat meetstaat in _Meetstaten)\r\n            {\r\n                string resultaat = LeesMeetstaat(meetstaat);\r\n                if (!string.IsNullOrEmpty(resultaat))\r\n                {\r\n                    _logboek.Toevoegen(_Naam, resultaat);\r\n                }\r\n                if (GeefAantalKoppelingen(meetstaat) > 0)\r\n                {\r\n                    // Alleen voorlopige invulling melden als de meetstaat daadwerkelijk gebruikt wordt (zie #14352)\r\n                    int ar = meetstaat.AantalRijen();\r\n                    for (int regelNr = 0; regelNr < ar; regelNr++)\r\n                    {\r\n                        if (meetstaat.VeldString(BMeetstaatKolom.c_StuurcodeKolomNr, regelNr) == BMeetstaat.c_StkVoorlopig)\r\n                        {\r\n                            _logboek.Toevoegen(\r\n                               _DocumentNaam,\r\n                               regelNr + 1,\r\n                               meetstaat._Id,\r\n                               $\"{ProjectResources.TradC111}{BStatics.c_Spatie}{meetstaat._Omschrijving}\",\r\n                               EViewKey.MeetGridInKlassiekView);\r\n                            _logboek.ExtraContextLetter = BMeetstaat.c_ContextLetter;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        public void KoppelingKopieren(\r\n           IBegrotingsRegel origRegel,\r\n           IBegrotingsRegel doelRegel,\r\n           BMeetstaat.EKopieerKoppeling kopieerKoppeling,\r\n           BMeetstaatKopieRegistratie meetstaatKopieRegistratie)\r\n        {\r\n            bool binnenBegroting = origRegel.Begroting == doelRegel.Begroting;\r\n            switch (kopieerKoppeling)\r\n            {\r\n                case BMeetstaat.EKopieerKoppeling.Niets:\r\n                    return;\r\n\r\n                case BMeetstaat.EKopieerKoppeling.Koppeling:\r\n                    {\r\n                        Debug.Assert(binnenBegroting, \"BBegroting.KoppelingKopieren() - verkeerde kopieeroptie bij kopi?ren naar andere begroting\");\r\n\r\n                        int mstKidOrig = origRegel._MstKid;\r\n                        BMeetstaatKoppeling? koppelingOrig = ZoekMeetstaatKoppeling(mstKidOrig);\r\n                        if (koppelingOrig != null)\r\n                        {\r\n                            var koppelingDoel = new BMeetstaatKoppeling(BewaarItemMutatieStatus.Nieuw, koppelingOrig, doelRegel._Id);\r\n                            koppelingDoel._KoppelingId = GeefNieuwId();\r\n                            if (doelRegel.MeetstaatKoppeling(koppelingDoel))\r\n                            {\r\n                                _MeetstaatKoppelingen.Toevoegen(koppelingDoel);\r\n                                if (origRegel._KoppelingStatus == EKoppelingStatus.Overschreven)\r\n                                    doelRegel.MeetstaatOverschreven(false);\r\n                                meetstaatKopieRegistratie.KoppelingGekopieerd(koppelingDoel._KoppelingId);   // Tbv UNDO\r\n                            }\r\n                        }\r\n                        break;\r\n                    }\r\n\r\n                case BMeetstaat.EKopieerKoppeling.Overschreven:\r\n                case BMeetstaat.EKopieerKoppeling.Meetstaat:\r\n                    {\r\n                        int mstKidOrig = origRegel._MstKid;\r\n\r\n                        IBegroting? bgrOrig = binnenBegroting ? this : origRegel.Begroting.GeefAndereBegroting(this);\r\n                        if (bgrOrig != null)\r\n                        {\r\n                            BMeetstaatKoppeling? koppelingOrig = bgrOrig.ZoekMeetstaatKoppeling(mstKidOrig);\r\n                            if (koppelingOrig != null)\r\n                            {\r\n                                int meetstaatIdKopie = meetstaatKopieRegistratie.GeefMeetstaatIdKopie(koppelingOrig._MeetstaatId);\r\n                                if (meetstaatIdKopie <= 0)\r\n                                {\r\n                                    BMeetstaat? meetstaatOrig = bgrOrig.GeefMeetstaat(koppelingOrig._MeetstaatId);\r\n                                    BMeetstaat meetstaatKopie;\r\n                                    if (binnenBegroting)\r\n                                    {\r\n                                        meetstaatKopie = new BMeetstaat(meetstaatOrig!, false);\r\n                                    }\r\n                                    else\r\n                                    {\r\n                                        IMeetstaatModel model = ZoekMeetstaatModel(meetstaatOrig!._Model!, meetstaatKopieRegistratie);\r\n                                        Debug.Assert(model != null, \"BBegroting.KoppelingKopieren() na ZoekMeetstaatModel() geen model\");\r\n                                        meetstaatKopie = new BMeetstaat(meetstaatOrig, model, false);\r\n                                    }\r\n                                    meetstaatIdKopie = meetstaatKopie._Id = GeefNieuwId();\r\n                                    meetstaatKopie.Begroting = this;\r\n                                    _Meetstaten.Add(meetstaatKopie);\r\n                                    meetstaatKopieRegistratie.MeetstaatGekopieerd(meetstaatOrig!._Id, meetstaatIdKopie);\r\n                                }\r\n\r\n                                BMeetstaatKoppeling koppelingDoel = new BMeetstaatKoppeling(BewaarItemMutatieStatus.Nieuw, meetstaatIdKopie, koppelingOrig._KolomId, koppelingOrig._RegelId);\r\n                                koppelingDoel._DocumentId = doelRegel._Id;\r\n                                koppelingDoel._KoppelingId = GeefNieuwId();\r\n\r\n                                if (doelRegel.MeetstaatKoppeling(koppelingDoel))\r\n                                {\r\n                                    _MeetstaatKoppelingen.Toevoegen(koppelingDoel);\r\n                                    meetstaatKopieRegistratie.KoppelingGekopieerd(koppelingDoel._KoppelingId);   // Tbv UNDO\r\n\r\n                                    if (kopieerKoppeling == BMeetstaat.EKopieerKoppeling.Overschreven ||\r\n                                       origRegel._KoppelingStatus == EKoppelingStatus.Overschreven)\r\n                                        doelRegel.MeetstaatOverschreven(false);\r\n                                }\r\n                            }\r\n                        }\r\n                        break;\r\n                    }\r\n                default:\r\n                    return;\r\n            }\r\n            VerhoogMeetstaatVersie();\r\n        }\r\n        public void KoppelingKopieren(IList<BClipboardStructuurRegel> csRegels, BClipboardStructuurRegel csRegel, IBegrotingsRegel doelRegel, BMeetstaat.EKopieerKoppeling kopieerKoppeling,\r\n           BMeetstaatKopieRegistratie meetstaatKopieRegistratie, bool inclusiefMetingen)\r\n        {\r\n            switch (kopieerKoppeling)\r\n            {\r\n                case BMeetstaat.EKopieerKoppeling.Niets:\r\n                    return;\r\n\r\n                case BMeetstaat.EKopieerKoppeling.Koppeling:\r\n                    {\r\n                        BMeetstaatKoppeling koppelingOrig = csRegel._MeetstaatKoppeling;\r\n                        if (koppelingOrig != null)\r\n                        {\r\n                            BMeetstaat? meetstaat = GeefMeetstaat(koppelingOrig._MeetstaatId);\r\n                            if (meetstaat == null)\r\n                                goto case BMeetstaat.EKopieerKoppeling.Meetstaat;\r\n\r\n                            BMeetstaatKoppeling koppelingDoel = new BMeetstaatKoppeling(BewaarItemMutatieStatus.Nieuw, koppelingOrig, doelRegel._Id);\r\n                            koppelingDoel._KoppelingId = GeefNieuwId();\r\n                            if (doelRegel.MeetstaatKoppeling(koppelingDoel))\r\n                            {\r\n                                _MeetstaatKoppelingen.Toevoegen(koppelingDoel);\r\n                                if (csRegel._KoppelingStatus == EKoppelingStatus.Overschreven)\r\n                                    doelRegel.MeetstaatOverschreven(false);\r\n                                meetstaatKopieRegistratie.KoppelingGekopieerd(koppelingDoel._KoppelingId);   // Tbv UNDO\r\n                            }\r\n                        }\r\n                        break;\r\n                    }\r\n\r\n                case BMeetstaat.EKopieerKoppeling.Overschreven:\r\n                case BMeetstaat.EKopieerKoppeling.Meetstaat:\r\n                    {\r\n                        BMeetstaatKoppeling koppelingOrig = csRegel._MeetstaatKoppeling;\r\n                        if (koppelingOrig != null)\r\n                        {\r\n                            // Is de meetstaat al eerder gekopieerd?\r\n                            int meetstaatIdKopie = meetstaatKopieRegistratie.GeefMeetstaatIdKopie(koppelingOrig._MeetstaatId);\r\n                            if (meetstaatIdKopie <= 0)\r\n                            {\r\n                                // Zoek de originele meetstaat\r\n                                BMeetstaat? meetstaatOrig = null;\r\n                                foreach (BClipboardStructuurRegel csr in csRegels)\r\n                                {\r\n                                    if (csr._MeetstaatId == koppelingOrig._MeetstaatId)\r\n                                    {\r\n                                        meetstaatOrig = csr._Meetstaat;\r\n                                        break;\r\n                                    }\r\n                                }\r\n                                Debug.Assert(meetstaatOrig != null, \"BBegroting.KoppelingKopieren() - geen meetstaatOrig\");\r\n                                if (meetstaatOrig == null)\r\n                                    return;   // niets gekopieerd\r\n\r\n                                // Is het model al eerder gekopieerd?\r\n                                IMeetstaatModel meetstaatModel = ZoekMeetstaatModel(meetstaatOrig!._Model!, meetstaatKopieRegistratie);\r\n                                BMeetstaat meetstaatKopie = new BMeetstaat(meetstaatOrig, meetstaatModel, inclusiefMetingen);\r\n                                meetstaatIdKopie = meetstaatKopie._Id = GeefNieuwId();\r\n                                if (inclusiefMetingen && _Metingen != null)\r\n                                    _Metingen.KopieerMetingKoppeling(meetstaatOrig._Id, meetstaatIdKopie);\r\n                                meetstaatKopie.Begroting = this;\r\n                                _Meetstaten.Add(meetstaatKopie);\r\n                                meetstaatKopieRegistratie.MeetstaatGekopieerd(meetstaatOrig._Id, meetstaatIdKopie);\r\n                            }\r\n\r\n                            BMeetstaatKoppeling koppelingDoel = new BMeetstaatKoppeling(BewaarItemMutatieStatus.Nieuw, meetstaatIdKopie, koppelingOrig._KolomId, koppelingOrig._RegelId);\r\n                            koppelingDoel._DocumentId = doelRegel._Id;\r\n                            koppelingDoel._KoppelingId = GeefNieuwId();\r\n\r\n                            doelRegel.MeetstaatKoppeling(koppelingDoel);\r\n                            _MeetstaatKoppelingen.Toevoegen(koppelingDoel);\r\n                            if (kopieerKoppeling == BMeetstaat.EKopieerKoppeling.Overschreven ||\r\n                               csRegel._KoppelingStatus == EKoppelingStatus.Overschreven)\r\n                                doelRegel.MeetstaatOverschreven(false);\r\n                            // Ook hier moet he juist geregistreerd worden omdat anders de Undo/Redo niet goed gaat\r\n                            meetstaatKopieRegistratie.KoppelingGekopieerd(koppelingDoel._KoppelingId);   // Tbv UNDO\r\n                        }\r\n                        break;\r\n                    }\r\n                default:\r\n                    return;\r\n            }\r\n            VerhoogMeetstaatVersie();\r\n        }\r\n        /// <summary>\r\n        /// Verander de omschrijving van de meetstaat in die van de (eerste) gekoppelde begrotingsregel\r\n        /// </summary>\r\n        /// <param name=\"meetstaat\">De meetstaat waarvan de omschrijving moet worden veranderd</param>\r\n        /// <param name=\"bgrRegelId\">ID van de begrotingsregel die aan de meetstaat is gekoppeld</param>\r\n        /// <returns>true indien gelukt</returns>\r\n        public bool MeetstaatOmschrijving(IMeetstaat meetstaat, int bgrRegelId)\r\n        {\r\n            if (bgrRegelId > 0 &&\r\n               _Stu.ZoekId(bgrRegelId, out int stuIndex) &&\r\n               MeetstaatOmschrijving(stuIndex, meetstaat))\r\n            {\r\n                return true;\r\n            }\r\n            return MeetstaatOmschrijving(meetstaat);\r\n        }\r\n        /// <summary>\r\n        /// Verander de omschrijving van de meetstaat in die van de eerste gekoppelde begrotingsregel\r\n        /// </summary>\r\n        /// <param name=\"meetstaat\">De meetstaat waarvan de omschrijving moet worden veranderd</param>\r\n        /// <returns>true indien gelukt</returns>\r\n        public bool MeetstaatOmschrijving(IMeetstaat meetstaat)\r\n        {\r\n            for (int stuIndex = 1; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                if (MeetstaatOmschrijving(stuIndex, meetstaat))\r\n                    return true;\r\n            }\r\n            return false;\r\n        }\r\n        private bool MeetstaatOmschrijving(int stuIndex, IMeetstaat meetstaat)\r\n        {\r\n            _Stu.LeesBegrotingsRegel(stuIndex);\r\n            IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n            BMeetstaatKoppeling? koppeling = ZoekMeetstaatKoppeling(bgrRegel?._MstKid ?? 0);\r\n            if (koppeling != null && koppeling._MeetstaatId == meetstaat._Id)\r\n            {\r\n                var hernoemenOpdracht = new MeetstaatHernoemenOpdracht(meetstaat, bgrRegel?._Omschrijving ?? string.Empty);      // Probeer de omschrijving van de meetstaat te wijzigen\r\n                if (OpdrachtUitvoeren(hernoemenOpdracht))\r\n                    VerhoogMeetstaatVersie();\r\n                return true;   // Ook als de opdracht niet kon worden uitgevoerd, misschien is de omschrijving al gelijk aan die van de eerste gekoppelde begrotingsregel\r\n            }\r\n            return false;\r\n        }\r\n        private IMeetstaatModel ZoekMeetstaatModel(IMeetstaatModel externModel, BMeetstaatKopieRegistratie meetstaatKopieRegistratie)\r\n        {\r\n            // Is het model al eerder gevonden?\r\n            int modelId = meetstaatKopieRegistratie.GeefMeetstaatModelIdKopie(externModel._ModelId);\r\n            if (modelId > 0)\r\n            {\r\n                foreach (IMeetstaatModel vzlModel in _MeetstaatModelVzl._Modellen)\r\n                {\r\n                    if (vzlModel._ModelId == modelId)\r\n                        return vzlModel;\r\n                }\r\n            }\r\n\r\n            // Is er een model met dezelfde naam?\r\n            BMeetstaatModel? gelijknamigModel = _MeetstaatModelVzl.ZoekModel(externModel._Naam);\r\n            if (gelijknamigModel != null && gelijknamigModel.Vergelijk(externModel))\r\n            {\r\n                meetstaatKopieRegistratie.MeetstaatModelGevonden(modelId, gelijknamigModel._ModelId);\r\n                return gelijknamigModel;\r\n            }\r\n\r\n            // Is er een model met dezelfde definitie?\r\n            foreach (IMeetstaatModel vzlModel in m_MeetstaatModelVzl?._Modellen ?? Enumerable.Empty<IMeetstaatModel>())\r\n            {\r\n                if (gelijknamigModel != vzlModel && vzlModel.Vergelijk(externModel))\r\n                {\r\n                    meetstaatKopieRegistratie.MeetstaatModelGevonden(modelId, vzlModel._ModelId);\r\n                    return vzlModel;\r\n                }\r\n            }\r\n            IMeetstaatModel importModel = _MeetstaatModelVzl.ImporteerMeetstaatModel(externModel, gelijknamigModel != null);\r\n            importModel.GeldigModel();  // zorgt voor wat initialisatie\r\n\r\n            meetstaatKopieRegistratie.MeetstaatModelGekopieerd(externModel._ModelId, importModel._ModelId);\r\n            return importModel;\r\n        }\r\n        #endregion\r\n\r\n        #region Rekenen\r\n        public void tbdBerekenAks()\r\n        {\r\n            _XtoKst.TbdBerekenAks(EXto.Bto);           // SKS(BgrBtoKs)\r\n            _XtoKst.TbdBerekenAks(EXto.Nto);           // SKS(BgrNtoKs)\r\n        }\r\n        public void MaakBrutoBegroting(BgrOpslaan bgrOpslaan, bool alleBtwRegels)\r\n        {\r\n            Debug.Assert(m_Bbd != null, \"BBegroting.MaakBrutoBegroting() - Er is nog geen begrotingsblad in het BBegroting-object\");\r\n            Rekenen(ERekendiepte.Volledig);\r\n            double totaalBegroting = _BgrBto.Waarde;\r\n            IBegroting ibrutobegroting = _maakBrutobegroting.MaakBrutoBegroting(bgrOpslaan, alleBtwRegels, this);\r\n            // Zorg ervoor dat de opdrachten verzameling leeg is na het omzetten naar bruto begroting\r\n            ibrutobegroting.OpdrachtenVergeten();\r\n\r\n            _OpdrachtVzl.Gewijzigd();\r\n            ThrowExceptionAlsTotaalOorspronkelijkeBegrotingEnBrutobegrotingVerschilt(totaalBegroting, ibrutobegroting);\r\n        }\r\n\r\n        private static void ThrowExceptionAlsTotaalOorspronkelijkeBegrotingEnBrutobegrotingVerschilt(double totaalBegroting, IBegroting ibrutobegroting)\r\n        {\r\n            const double toegestaanVerschilBegrotingsposten = 1d;  // Er mag een klein verschil zijn tussen de oorspronkelijke begroting en de brutobegroting, vanwege afrondingen\r\n            const double toegestaanVerschil = 10d;   // Groter verschil wordt toegelaten\r\n\r\n            double totaalBrutoBegroting = ibrutobegroting._BgrBto.Waarde;\r\n            double absVerschil = Math.Abs(totaalBrutoBegroting - totaalBegroting);\r\n            double margeAfrondingsVerschil = ibrutobegroting.BegrotingspostenToepassen ? toegestaanVerschilBegrotingsposten : toegestaanVerschil;\r\n            if (absVerschil >= margeAfrondingsVerschil)\r\n            {\r\n                throw new TotaalOorspronkelijkeBegrotingEnBrutobegrotingVerschiltException();\r\n            }\r\n        }\r\n\r\n        public void Rekenen(ERekendiepte diepte)\r\n        {\r\n            Rekenen(diepte, new BBerekenStaart());\r\n        }\r\n        public void BerekenStaart(int bgrPostId)\r\n        {\r\n            _REl._MoetRekenen = true;\r\n            Rekenen(ERekendiepte.Wijzigingen, new BBerekenStaart() { _AlleenStaart = true, _AlleenBgrpostId = bgrPostId });\r\n        }\r\n        private void Rekenen(ERekendiepte diepte, BBerekenStaart berekenStaart)\r\n        {\r\n            _Bbd._BgrPostToepassen = BegrotingspostenToepassen;\r\n            if (m_Snel || m_GroepeerOpdrachten ||\r\n                !MoetRekenen && !_REl._MoetRekenen && diepte == ERekendiepte.Wijzigingen)\r\n                return;\r\n\r\n            if (!berekenStaart._GeenVastTotaalBerekenen)\r\n            {\r\n                // Tbv toerekenen naar vast totaal het BVastTotaal-object resetten:\r\n                _VastTotaal.Reset();\r\n            }\r\n\r\n            bool meldingen = diepte == ERekendiepte.Meldingen;\r\n\r\n            Debug.Assert(_Stu._Aantal > 0 && _Stu[0]._Regel != null, \"BBegroting.Rekenen() - Geen rootelement aanwezig in begrotingsstructuur\");\r\n            BElement? rootEl = _REl;\r\n            Debug.Assert(m_Bbd != null, \"BBegroting.Rekenen() - Er is nog geen begrotingsblad in het BBegroting-object\");\r\n\r\n            BXtoKst subtotaal = new BXtoKst(_VltId, BegrotingsValuta);\r\n            BRawInfo? rawInfo = (m_Tpe == EBgrTpe.Raw) ? m_RawInfo : null;\r\n            var rekenGegevens = new BRekenGegevens(\r\n                m_Stu,\r\n                diepte,\r\n                m_Tpe,\r\n                _AfgerondRekenen,\r\n                _ElementenOp0,\r\n                rawInfo,\r\n                subtotaal)\r\n            {\r\n                _BerekenStaart = berekenStaart\r\n            };\r\n\r\n            do\r\n            {\r\n                _UurloonMeldingen = true;\r\n                RekenMeldingen.LeesRekenMeldingen();\r\n\r\n                // Reken in het begrotingblad de begroting door\r\n                m_Bbd.Rekenen(_DocumentNaam, rekenGegevens, rootEl, m_XtoKst, out m_TotUur);  // m_XtoKst en m_TotUur bevatten het resultaat\r\n                diepte = ERekendiepte.Wijzigingen;\r\n                _logboek.GeenDoubluresToevoegen = true;\r\n            } while (m_VastTotaal?.VerderRekenen() == true && berekenStaart?._GeenVastTotaalBerekenen != true);\r\n            _logboek.GeenDoubluresToevoegen = false;\r\n\r\n            if (meldingen)\r\n            {\r\n                MeetstatenControleren();\r\n                if (m_BasisValuta!._Onbekend) // Dit is een DocValuta\r\n                    _logboek.Toevoegen(_DocumentNaam, ProjectResources.TradC112, EViewKey.AlgmCtrlInAlgemeenView);\r\n                if (m_AfgerondRekenen?._Afronden == true)\r\n                    _logboek.Toevoegen(_DocumentNaam, ProjectResources.TradC113, EViewKey.AlgmCtrlInAlgemeenView);\r\n                if (ControleerOpVastPrijsIndicatie())\r\n                    _logboek.Toevoegen(_DocumentNaam, ProjectResources.TradC114, EViewKey.BegrGridInKlassiekeView);\r\n                _VastTotaal.Meldingen();\r\n            }\r\n\r\n            // Bereken de staartkosten\r\n            //\r\n            //   BgrXtoStr == BgrXto - BgrXtoSks\r\n            //   BgrXto    == _XtoKst[Bto,Aks]\r\n            //   BgrXtoSks == _XtoKst[Bto,Arb] + _XtoKst[Bto,Mta] + _XtoKst[Bto,Mte] + _XtoKst[Bto,Oda]\r\n            //\r\n\r\n            if (m_RawInfo != null && m_RawInfo._RawBegroting)\r\n            {\r\n                BBedrag bedrag = new BBedrag(m_VttId, m_RawInfo._RawSubtotaal);\r\n                m_RawInfo.ZetRawSubTotaal(bedrag, BegrotingsValuta);\r\n\r\n                bedrag = new BBedrag(m_VttId, m_RawInfo._RawAltSubtotaal);\r\n                m_RawInfo.ZetRawAltSubTotaal(bedrag, BegrotingsValuta);\r\n            }\r\n\r\n            _XtoKst[EXto.Bto, EKst.Str] = _XtoKst[EXto.Bto, EKst.Aks] - _XtoKst.GeefSks(EXto.Bto);   // SKS: Arb+Mta+Mte+Oda, geen Str\r\n            _XtoKst[EXto.Nto, EKst.Str] = _XtoKst[EXto.Nto, EKst.Aks] - _XtoKst.GeefSks(EXto.Nto);\r\n\r\n            BegrotingBerekendHandler?.BegrotingBerekend();\r\n\r\n            rootEl.IsGewijzigd();         // Tbv opslag\r\n            _REl._MoetRekenen = MoetRekenen = false;\r\n            rootEl._TotUur = m_TotUur;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Bereken het Mjob Bedrag, de contante waarde en investering.\r\n        /// </summary>\r\n        public void RekenenMjobContanteWaardeInvestering()\r\n        {\r\n            bool nieuweGroepeerOpdrachtGemaakt = GroepeerOpdrachten(); // Er is een mogelijkheid dat bij deze wijzigingen groepsopdrachten gemaakt worden\r\n\r\n            BContext? originalContext = _Context;\r\n            if (nieuweGroepeerOpdrachtGemaakt)\r\n                _Context = null;\r\n\r\n            BBrinkKostenbestandEigenschappen? eigenschappen = _BrinkKostenbestandEigenschappenOnderhoud;\r\n\r\n            DataTable? cloudDataCache = HaalAlleOnderhoudsGegevensUitDeCloud(eigenschappen?._KostenbestandId);\r\n\r\n            // Rekenen Mjob Bedrag gaat vanaf het root element.\r\n            int index = 0;\r\n            _MjobContanteWaardeIsActueel = true;\r\n            RekenenMjobContanteWaardeInvesteringOnderbouwing(_REl, cloudDataCache, ref index);\r\n\r\n            if (nieuweGroepeerOpdrachtGemaakt)\r\n            {\r\n                GroepeerOpdrachten(_ViewNr, ProjectResources.TradC115);\r\n                _Context = originalContext;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// Per regel uit de begroting het Mjob Bedrag, de contante waarde en investering berekenen.\r\n        /// </summary>\r\n        /// <param name=\"regel\"></param>\r\n        /// <param name=\"kostenbestandEigenschappen\"></param>\r\n        /// <param name=\"index\"></param>\r\n        public void RekenenMjobContanteWaardeInvestering(IBegrotingsRegel? bgrRegel)\r\n        {\r\n            RekenenMjobContanteWaardeInvestering(bgrRegel, null);\r\n        }\r\n\r\n        public void ZetScenarioStatusActueel(IBegrotingsRegel bgrRegel)\r\n        {\r\n            int stuIndex = _Stu.ZoekId(bgrRegel._Id);\r\n\r\n            if (bgrRegel._OnderbouwingType == EOnderbouwing.Element || bgrRegel._OnderbouwingType == EOnderbouwing.Kostenpost)\r\n            {\r\n                if (bgrRegel.GeefString(BBegrotingsRegel.EGegeven.OnderhoudsCode, false) != string.Empty)\r\n                {\r\n                    string scenario = bgrRegel.GeefString(BBegrotingsRegel.EGegeven.Scenario, false);\r\n                    if (!string.IsNullOrEmpty(scenario))\r\n                    {\r\n                        WijzigStringBgrRegel(true, stuIndex, BBegrotingsRegel.EGegeven.Scenario, BScenario.ScenarioStatusActueel(scenario), null, out bool lokaal);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n\r\n        /// <summary>\r\n        /// Per regel uit de begroting het Mjob Bedrag, de contante waarde en investering berekenen.\r\n        /// </summary>\r\n        /// <param name=\"regel\"></param>\r\n        /// <param name=\"kostenbestandEigenschappen\"></param>\r\n        /// <param name=\"index\"></param>\r\n        internal void RekenenMjobContanteWaardeInvestering(IBegrotingsRegel? bgrRegel, DataTable? cloudDataCache)\r\n        {\r\n            if (bgrRegel == null) return;\r\n            bool rekenen;\r\n            bool lokaal;\r\n            bool kostenbestandAanwezig;\r\n            int stuIndex = _Stu.ZoekId(bgrRegel._Id);\r\n\r\n            if (bgrRegel._OnderbouwingType == EOnderbouwing.Element || bgrRegel._OnderbouwingType == EOnderbouwing.Kostenpost)\r\n            {\r\n                if (bgrRegel.GeefString(BBegrotingsRegel.EGegeven.OnderhoudsCode, false) != string.Empty)\r\n                {\r\n                    DataTable? cloudData;\r\n                    if (cloudDataCache == null)\r\n                    {\r\n                        BBrinkKostenbestandEigenschappen? eigenschappen = _BrinkKostenbestandEigenschappenOnderhoud;\r\n                        cloudData = HaalOnderhoudsGegevensUitDeCloud(eigenschappen?._KostenbestandId, stuIndex);\r\n                    }\r\n                    else\r\n                    {\r\n                        cloudData = HaalOnderhoudsGegevensUitDeCloudCache(cloudDataCache, stuIndex);\r\n                    }\r\n                    // Checken of er in data uit de cloud handelingen aanwezig zijn, dan venster tonen.\r\n                    // Eerste regel is het onderdeel en geen handeling, dus count > 1.\r\n\r\n                    // cloudData geeft altijd wat terug. Ook als er geen Onderdeelcode gevonden is (en dus geen handelingen).\r\n                    // In dat geval is er maar ??n regel waarbij er geen onderhoudscode aanwezig is.\r\n                    // Een handelingcode kan niet leeg zijn.\r\n\r\n                    if (cloudData != null && cloudData.Rows.Count >= 1)\r\n                    {\r\n                        bool eersteRegelHeeftHandelingCode = true;\r\n                        BScenario scenario;\r\n                        if (cloudData.Rows.Count == 1)\r\n                        {\r\n                            eersteRegelHeeftHandelingCode = !string.IsNullOrEmpty((string)cloudData.Rows[0][\"hndcode\"]);///NIETVERTALEN\r\n                        }\r\n                        if (eersteRegelHeeftHandelingCode)\r\n                        {\r\n                            // Op basis van de onderhoudscode de data uit de cloud halen.\r\n                            scenario = new BScenario(bgrRegel, _BrinkKostenbestandEigenschappenOnderhoud);\r\n                            scenario.ZetActueel(m_BrinkKostenbestandEigenschappenOnderhoud?._Wijzigdatum ?? default);\r\n                            scenario.LeesStandaardScenario(cloudData);\r\n\r\n                            WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.MjobBedrag, scenario.MjobBedrag, false);\r\n                            WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.ContanteWaarde, scenario.ContanteWaarde, false);\r\n                            // Investering is het doorgerekend totaal plus de contante waarde van de regel.\r\n                            WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.Investering, _afronden.Bedrag(bgrRegel.GeefDouble(BBegrotingsRegel.EGegeven.drktot, out bool geenWaarde) + scenario.ContanteWaarde, 0), false);\r\n                            WijzigStringBgrRegel(true, stuIndex, BBegrotingsRegel.EGegeven.Scenario, scenario.SchrijfScenario(), null, out lokaal);\r\n                        }\r\n                        else\r\n                        {\r\n                            // Geen handelingen.\r\n                            WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.MjobBedrag, 0.0, false);\r\n                            WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.ContanteWaarde, 0.0, false);\r\n                            WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.Investering, bgrRegel.GeefDouble(BBegrotingsRegel.EGegeven.drktot, out rekenen), false);\r\n\r\n                            // LETOP! Als er geen kostenbestand is, laten we het scenario intact, anders maken we het scenario leBBegrotingsRegel.EGegeven.\r\n                            kostenbestandAanwezig = (_BrinkKostenbestandEigenschappenOnderhoud?._KostenbestandId != null) && (_BrinkKostenbestandEigenschappenOnderhoud?._KostenbestandId != Guid.Empty);\r\n                            if (kostenbestandAanwezig)\r\n                            {\r\n                                WijzigStringBgrRegel(true, stuIndex, BBegrotingsRegel.EGegeven.Scenario, \"\", null, out lokaal);//NIETVERTALEN\r\n                            }\r\n\r\n                        }\r\n                    }\r\n                    else\r\n                    {\r\n                        // Geen Clouddata.\r\n                        WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.MjobBedrag, 0.0, false);\r\n                        WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.ContanteWaarde, 0.0, false);\r\n                        WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.Investering, bgrRegel.GeefDouble(BBegrotingsRegel.EGegeven.drktot, out rekenen), false);\r\n\r\n                        // LETOP! Als er geen kostenbestand is, laten we het scenario intact, anders maken we het scenario leBBegrotingsRegel.EGegeven.\r\n                        kostenbestandAanwezig = (_BrinkKostenbestandEigenschappenOnderhoud?._KostenbestandId != null) && (_BrinkKostenbestandEigenschappenOnderhoud?._KostenbestandId != Guid.Empty);\r\n                        if (kostenbestandAanwezig)\r\n                        {\r\n                            WijzigStringBgrRegel(true, stuIndex, BBegrotingsRegel.EGegeven.Scenario, \"\", null, out lokaal);//NIETVERTALEN\r\n                        }\r\n                    }\r\n\r\n                }\r\n                else\r\n                {\r\n                    // Geen onderhoudscode.\r\n                    WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.MjobBedrag, 0.0, false);\r\n                    WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.ContanteWaarde, 0.0, false);\r\n                    WijzigDoubleBgrRegel(stuIndex, BBegrotingsRegel.EGegeven.Investering, bgrRegel.GeefDouble(BBegrotingsRegel.EGegeven.drktot, out rekenen), false);\r\n                    WijzigStringBgrRegel(true, stuIndex, BBegrotingsRegel.EGegeven.Scenario, \"\", null, out lokaal);//NIETVERTALEN\r\n                }\r\n            }\r\n\r\n        }\r\n\r\n        /// <summary>\r\n        /// Per regel uit de begroting het Mjob Bedrag, de contante waarde en investering berekenen.\r\n        /// </summary>\r\n        /// <param name=\"regel\"></param>\r\n        /// <param name=\"kostenbestandEigenschappen\"></param>\r\n        /// <param name=\"index\"></param>\r\n        private void RekenenMjobContanteWaardeInvesteringOnderbouwing(IBegrotingsRegel regel, DataTable? cloudDataCache, ref int index)\r\n        {\r\n\r\n            // Doorloop de onderbouwing\r\n            IBegrotingsRegel? bgrRegel = _Stu.GeefOnderbouwingsRegel(regel._Id, ++index);\r\n\r\n            while (bgrRegel != null)  // zolang niet einde vd onderbouwing is bereikt\r\n            {\r\n                // Checken of het een element of kostenpost betreft.\r\n                switch (bgrRegel._OnderbouwingType)\r\n                {\r\n                    case EOnderbouwing.Element:\r\n                        RekenenMjobContanteWaardeInvesteringOnderbouwing(bgrRegel, cloudDataCache, ref index);\r\n                        ++index;\r\n                        break;\r\n\r\n                    case EOnderbouwing.Kostenpost:\r\n                        ++index;\r\n                        break;\r\n\r\n                    case EOnderbouwing.Opslagpost:  // overslaan maar wel overgaan op\r\n                        ++index;                    // de volgende begrotingsregel\r\n                        break;\r\n\r\n                    case EOnderbouwing.Commentaar:  // overslaan maar wel overgaan op\r\n                        ++index;                    // de volgende begrotingsregel\r\n                        break;\r\n                }\r\n\r\n                // De regel berekenen.\r\n                RekenenMjobContanteWaardeInvestering(bgrRegel, cloudDataCache);\r\n\r\n                // Volgende begrotingsregel in de onderbouwing\r\n                bgrRegel = _Stu.GeefOnderbouwingsRegel(regel._Id, index);\r\n\r\n                if (bgrRegel == null && (index < _Stu._Aantal))\r\n                {\r\n                    // Volgende begrotingsregel ophalen op basis van de index.\r\n                    bgrRegel = _Stu[index]._Regel;\r\n                }\r\n            }\r\n        }\r\n\r\n\r\n        /// <summary>\r\n        /// Per regel uit de begroting het Mjob Bedrag en de contante waarde resetten.\r\n        /// </summary>\r\n        /// <param name=\"regel\"></param>\r\n        /// <param name=\"kostenbestandEigenschappen\"></param>\r\n        /// <param name=\"index\"></param>\r\n        private void ResetMjobContanteWaarde(IBegrotingsRegel regel, ref int index)\r\n        {\r\n\r\n            // Doorloop de onderbouwing\r\n            IBegrotingsRegel? bgrRegel = _Stu.GeefOnderbouwingsRegel(regel._Id, ++index);\r\n\r\n            while (bgrRegel != null)  // zolang niet einde vd onderbouwing is bereikt\r\n            {\r\n                // Checken of het een element of kostenpost betreft.\r\n                switch (bgrRegel._OnderbouwingType)\r\n                {\r\n                    case EOnderbouwing.Element:\r\n                        ResetMjobContanteWaarde(bgrRegel, ref index);\r\n                        ++index;\r\n                        break;\r\n\r\n                    case EOnderbouwing.Kostenpost:\r\n                        ++index;\r\n                        break;\r\n\r\n                    case EOnderbouwing.Opslagpost:  // overslaan maar wel overgaan op\r\n                        ++index;                    // de volgende begrotingsregel\r\n                        break;\r\n\r\n                    case EOnderbouwing.Commentaar:  // overslaan maar wel overgaan op\r\n                        ++index;                    // de volgende begrotingsregel\r\n                        break;\r\n                }\r\n\r\n                // Bij een element altijd de status gewijzigd, bij een kostenpost alleen als deze een onderhoudscode heeft.\r\n                if (bgrRegel._OnderbouwingType == EOnderbouwing.Kostenpost)\r\n                {\r\n                    if (bgrRegel.GeefString(BBegrotingsRegel.EGegeven.OnderhoudsCode, false) != \"\")//NIETVERTALEN\r\n                    {\r\n                        bgrRegel.BgrRglGewijzigd(true);\r\n                    }\r\n                }\r\n                else if (bgrRegel._OnderbouwingType == EOnderbouwing.Element)\r\n                {\r\n                    bgrRegel.BgrRglGewijzigd(true);\r\n                }\r\n\r\n\r\n                // Volgende begrotingsregel in de onderbouwing\r\n                bgrRegel = _Stu.GeefOnderbouwingsRegel(regel._Id, index);\r\n\r\n                if (bgrRegel == null && (index < _Stu._Aantal))\r\n                {\r\n                    // Volgende begrotingsregel ophalen op basis van de index.\r\n                    bgrRegel = _Stu[index]._Regel;\r\n                }\r\n            }\r\n        }\r\n\r\n        public DataTable? HaalOnderhoudsGegevensUitDeCloudCache(DataTable? cloudDataCache, int stuIndex)\r\n        {\r\n            DataTable? result = null;\r\n            if (cloudDataCache != null && cloudDataCache.Rows.Count > 0)\r\n            {\r\n                BStructuurRegel regel = _Stu[stuIndex];\r\n                result = cloudDataCache.Clone();\r\n                foreach (DataRow row in cloudDataCache.Select(string.Format(\"bgrregelnr = {0}\", regel._Id)))//NIETVERTALEN)\r\n                {\r\n                    result.ImportRow(row);\r\n                }\r\n            }\r\n\r\n            return result;\r\n        }\r\n\r\n        public DataTable? HaalAlleOnderhoudsGegevensUitDeCloud(Guid? kostenbestandId)\r\n        {\r\n            DataTable? onderhoudsGegevens = null;\r\n            if (kostenbestandId != null)\r\n            {\r\n                #region Inloggen / Test module / Vaststellen (onderhouds)codes\r\n                if (!KostenbestandInloggen())\r\n                    return null;\r\n\r\n                #endregion Inloggen / Test module / Vaststellen (onderhouds)codes\r\n\r\n                IBegrotingsRegel begrotingsRegel;\r\n                string onderhoudsCode;\r\n                var regels = new List<BStructuurRegel>();\r\n                foreach (BStructuurRegel regel in _Stu.Lijst)\r\n                {\r\n                    begrotingsRegel = _Stu.GeefBegrotingsRegel(regel);\r\n                    onderhoudsCode = begrotingsRegel.GeefString(BBegrotingsRegel.EGegeven.OnderhoudsCode, false);\r\n                    if (!string.IsNullOrEmpty(onderhoudsCode))\r\n                    {\r\n                        regels.Add(regel);\r\n                    }\r\n                }\r\n\r\n                string xmlText = GenereerXmlTekst(regels, BBegrotingsRegel.EGegeven.OnderhoudsCode);\r\n                Guid rptid = _rapportService.RapportDataToevoegen(xmlText, (Guid)kostenbestandId, _Naam, MjobRapport.TypeOnderhoud);\r\n                onderhoudsGegevens = _rapportService.RapportDataLezen(rptid, null, MjobRapport.TypeOnderhoud);\r\n            }\r\n\r\n            return onderhoudsGegevens;\r\n        }\r\n\r\n        public DataTable? HaalOnderhoudsGegevensUitDeCloud(Guid? kostenbestandId, int stuIndex)\r\n        {\r\n            DataTable? onderhoudsGegevens = null;\r\n            if (kostenbestandId != null)\r\n            {\r\n                #region Inloggen / Test module / Vaststellen (onderhouds)codes\r\n                if (!KostenbestandInloggen())\r\n                    return null;\r\n\r\n                #endregion Inloggen / Test module / Vaststellen (onderhouds)codes\r\n\r\n                List<BStructuurRegel> regels = new List<BStructuurRegel>();\r\n                regels.Add(_Stu[stuIndex]);\r\n\r\n                string xmlText = GenereerXmlTekst(regels, BBegrotingsRegel.EGegeven.OnderhoudsCode);\r\n\r\n                Guid rptid = _rapportService.RapportDataToevoegen(xmlText, (Guid)kostenbestandId, _Naam, MjobRapport.TypeOnderhoud);\r\n\r\n                onderhoudsGegevens = _rapportService.RapportDataLezen(rptid, null, MjobRapport.TypeOnderhoud);\r\n\r\n            }\r\n\r\n            return onderhoudsGegevens;\r\n        }\r\n\r\n        private static string GenereerXmlTekst(List<BStructuurRegel> regels, BBegrotingsRegel.EGegeven onderhoudsCodeKolom)\r\n        {\r\n            using MemoryStream ms = new MemoryStream();\r\n            using XmlTextWriter w = new XmlTextWriter(ms, Encoding.GetEncoding(\"utf-16\"));//NIETVERTALEN\r\n            w.Formatting = Formatting.Indented;\r\n\r\n            w.WriteStartDocument();\r\n            w.WriteStartElement(\"onderhoudsxml\");//NIETVERTALEN\r\n            foreach (BStructuurRegel item in regels)\r\n            {\r\n\r\n                int niv = item._Niveau;\r\n                string? code = item._Regel?.GeefString(BBegrotingsRegel.EGegeven.cclcde, false);\r\n                string? oms = item._Regel?.GeefString(BBegrotingsRegel.EGegeven.oms, false);\r\n                w.WriteStartElement(\"ond\");//NIETVERTALEN\r\n                w.WriteAttributeString(\"niv\", XmlConvert.ToString(niv));//NIETVERTALEN\r\n                w.WriteAttributeString(\"rglnr\", XmlConvert.ToString(item._Id)); //NIETVERTALEN // Geeft de regel_id in de begroting aan (is niet de stuIndex)\r\n                w.WriteAttributeString(\"code\", code);//NIETVERTALEN\r\n                w.WriteAttributeString(\"oms\", oms);//NIETVERTALEN\r\n\r\n                string ondcode = item._Regel?.GeefString(onderhoudsCodeKolom, false)?.Trim() ?? string.Empty;  // Lees de onderhoudscode\r\n                if (!string.IsNullOrEmpty(ondcode))\r\n                {\r\n                    bool geenWaarde = false;\r\n                    double hvh = item._Regel is { } r ? r.GeefDouble(BBegrotingsRegel.EGegeven.drkhvh, out geenWaarde) : 0;\r\n                    string enh = item._Regel?.GeefString(BBegrotingsRegel.EGegeven.enh, false) ?? string.Empty;\r\n\r\n                    w.WriteAttributeString(\"ondcode\", ondcode);//NIETVERTALEN\r\n                    w.WriteAttributeString(\"hvh\", XmlConvert.ToString((decimal)hvh));//NIETVERTALEN\r\n                    w.WriteAttributeString(\"enh\", enh);//NIETVERTALEN\r\n                }\r\n                w.WriteEndElement();\r\n            }\r\n            w.WriteEndElement();\r\n            w.WriteEndDocument();\r\n            w.Flush();\r\n            ms.Position = 0;\r\n            using StreamReader reader = new StreamReader(ms);\r\n            return reader.ReadToEnd();\r\n        }\r\n\r\n        /// <summary>Genereer een nieuw uurloon op basis van een bestaand uurloon\r\n        /// </summary>\r\n        /// <param name=\"uurloonCodeOrg\"></param>\r\n        /// <param name=\"uurloonVzl\"></param>\r\n        /// <returns></returns>\r\n        public string GeefUniekeUurloonCode(string uurloonCodeOrg, BUurloonCVzl uurloonVzl, string prefix)\r\n        {\r\n            string? uurloonCode = null;\r\n            // Er komt een uurloon binnen UITVOERDER (max 10 chars)\r\n            // Strategie\r\n            // Test eerst of het lukt met het prefix karakter, als dat niet lukt dan\r\n            //   Voeg een karakter [A-Z][0-1] toe tot maximaal 10 posities toe en test of deze al bestaat\r\n            //   Begin met aanvullen aan het eind (tot max 10 chars)\r\n            //    Als dat niet meer kan ga dan vanaf uurloonCodeOrg.Length - 1 naar links \r\n            bool aanvullen = true;\r\n            int startLengte = uurloonCodeOrg.Length;\r\n            string basisUurloonCode = uurloonCodeOrg.Trim();\r\n\r\n\r\n            if (uurloonCodeOrg.Length < 10)\r\n            {\r\n                string uurloonCodeMetPrefix = basisUurloonCode + prefix;\r\n                if (!uurloonVzl.HeeftUurloon(uurloonCodeMetPrefix))\r\n                {\r\n                    uurloonCode = uurloonCodeMetPrefix;\r\n                }\r\n            }\r\n\r\n            if (uurloonCode == null)\r\n            {\r\n                int tekenIndex = 0;\r\n                string tekens = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\";//NIETVERTALEN)\r\n                do\r\n                {\r\n                    uurloonCode = basisUurloonCode + tekens[tekenIndex++].ToString();\r\n                    if (tekenIndex >= tekens.Length)\r\n                    {\r\n                        tekenIndex = 0;\r\n                        if (uurloonCode.Length == BUurloonB.c_UlnCdeLen && aanvullen)\r\n                        {\r\n                            aanvullen = false;\r\n                            startLengte--;\r\n                            basisUurloonCode = uurloonCodeOrg.Substring(0, startLengte);\r\n                        }\r\n                        else\r\n                        {\r\n                            if (aanvullen)\r\n                            {\r\n                                basisUurloonCode = uurloonCode;\r\n                            }\r\n                            else\r\n                            {\r\n                                startLengte--;\r\n                                basisUurloonCode = uurloonCodeOrg.Substring(0, startLengte);\r\n                            }\r\n                        }\r\n                    }\r\n                } while (uurloonVzl.HeeftUurloon(uurloonCode));\r\n            }\r\n            return uurloonCode;\r\n        }\r\n\r\n        public BMiddelen BerekenMiddelenGebruik(BBegrotingTabel begrotingTabel)\r\n        {\r\n            _Mid.WisMiddelenGebruik();\r\n            BElement? rootEl = _REl;\r\n\r\n            return _Mid.GeefMiddelenTabel(begrotingTabel);\r\n        }\r\n\r\n        #endregion\r\n\r\n        #region Voorbeeldbegroting\r\n        public static BBegroting VoorbeeldBegroting(bool metBtwRekenen)\r\n        {\r\n            if (s_VoorbeeldBegroting == null)\r\n            {\r\n                BBegroting bgr = new BBegroting(ProjectResources.TradC116, GeefStdBasisValuta(), new BegrotingMaxIdBepaler());\r\n                bgr.RegistreerOpdrachten(false);\r\n                if (metBtwRekenen)\r\n                {\r\n                    // NB Kan hier nietr de \"bgr._BtwToepassen = true;\" gebruiken want die gaat rekeken en geeft dan logboekmeldingen\r\n                    BBegrotingsGegeven bgv = bgr._Bgv.MaakBegrotingsGegeven(BBegrotingsGegeven.c_BtwToepassen, EGgvTpe.Tekst, \"Btw toepassen\");//NIETVERTALEN\r\n                    bgv._Wde = Constants.Waar;\r\n                }\r\n\r\n                // Maak begrotingsregels aan\r\n                BElement hoofdstuk = bgr.MaakElement(BBegroting.c_RElId, true);   // true: achteraan toevoegen in de begroting\r\n                BElement subHoofdstuk = bgr.MaakElement(hoofdstuk._Id, true);\r\n                BElement paragraaf = bgr.MaakElement(subHoofdstuk._Id, true);\r\n                BElement element = bgr.MaakElement(paragraaf._Id, true);\r\n                BKostenpost? kostenpost = bgr.MaakKostenpost(element._Id, true);\r\n\r\n                bgr.MaakOpslagpost(element._Id, true);\r\n                bgr.MaakCommentaar(element._Id, true);\r\n                // toekomst:\r\n                bgr.MaakKostenpost(BBegroting.c_RElId, true);   // Losse kostenpost\r\n\r\n                // Voeg wat gegevens toe\r\n                for (int index = bgr._Stu._Aantal - 1; index > 0; index--)\r\n                    bgr._Stu[index]._Regel?.VoorbeeldGegevens();\r\n\r\n                string ulnCde = ProjectResources.TradC117;\r\n                BUurloonBVzl ulbVzl = bgr.GeefUurloonBVzl();\r\n                ulbVzl.VerwijderUurloon(string.Empty);   // Standaarduurloon staat vooraan, vervang deze\r\n                BUurloonB ulb = new BUurloonB(ulnCde, new BBedrag(bgr._VltId, 19.50), 0.0);\r\n                ulb._Oms = ProjectResources.TradC1171;\r\n                ulbVzl.ToevoegenUurloon(ulb);\r\n                IList<BValutaDeco> bvaVzl = bgr.BegrotingsValuta;\r\n                s_VoorbeeldBegroting = bgr;\r\n                kostenpost?.WijzigUurloon(ulnCde);\r\n                bgr.RegistreerOpdrachten(true);   // houdt in: bgr.Rekenen(ERekendiepte.Volledig);\r\n            }\r\n            return s_VoorbeeldBegroting;\r\n        }\r\n        #endregion Voorbeeldbegroting\r\n\r\n        #region Geeffuncties\r\n        public static BDocValuta GeefStdBasisValuta()\r\n        {\r\n            List<BValutaDeco> bva = new();\r\n            BValutaDeco? basisVal = BValuta.GeefBasisValuta(); // Geef de StamValuta met koers 1.00: Dit is een StamValuta\r\n            basisVal ??= BValuta.GeefValuta(0);          // Dit is een StamValuta\r\n\r\n            BDocValuta bgrVal = BDocValuta.MaakValuta(bva, 1, basisVal._Aanduiding, basisVal._Koers, basisVal._Omschrijving, basisVal._Teken, basisVal._Datum);\r\n\r\n            //Let op! wordt nu gerefereerd naar de begroting._Bva\r\n            bgrVal.ZetMutatieStatus(BewaarItemMutatieStatus.Nieuw);\r\n            return bgrVal;\r\n        }\r\n        public static BDocValuta GeefValutaUitBValuta(string aanduid)\r\n        {\r\n            var bva = new List<BValutaDeco>();\r\n            BValutaDeco? basisVal = BValuta.GeefValuta(aanduid, true); // Geef de StamValuta met koers 1.00: Dit is een StamValuta\r\n            BDocValuta bgrVal = BDocValuta.MaakValuta(bva, 1, basisVal!._Aanduiding, basisVal._Koers, basisVal._Omschrijving, basisVal._Teken, basisVal._Datum);\r\n\r\n            //Let op! wordt nu gerefereerd naar de begroting._Bva\r\n            bgrVal.ZetMutatieStatus(BewaarItemMutatieStatus.Nieuw);\r\n            return bgrVal;\r\n        }\r\n        internal BXtoKst? GeefBedragen()\r\n        {\r\n            return m_XtoKst;\r\n        }\r\n        /// <summary>\r\n        /// Geef een begrotingsregel, indien deze nog niet aanwezig is deze eerst inlezen\r\n        /// </summary>\r\n        public IBegrotingsRegel? GeefBegrotingsRegel(int stuIndex)\r\n        {\r\n            _Stu.LeesBegrotingsRegel(stuIndex);\r\n            return _Stu[stuIndex]._Regel;\r\n        }\r\n        public BMiddel GeefMiddel(int midId, int ktpId)\r\n        {\r\n            Debug.Assert(m_Mid != null);\r\n\r\n            BMiddel? middel = _Mid.ZoekMiddel(midId);\r\n            if (middel == null && m_LeesMiddel != null)\r\n                middel = m_LeesMiddel(midId, BMiddel.c_GeenMidCde, ktpId);  // Wordt hierbij ook in m_Mid geplaatst\r\n\r\n            if (middel == null && _structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.ControlerenEnRepareren)\r\n            {\r\n                middel = new BMiddel(midId, _VltId);  // mutatiestatus Nieuw\r\n                middel._Oms = \"BRINK AUTOMATISERING\";//NIETVERTALEN\r\n                middel.WijzigMiddelCode(\"BRINK_\" + midId.ToString()); //NIETVERTALEN // Hopelijk is dit uniek\r\n                _Mid.MiddelToevoegen(middel);\r\n                int stuIndex = _Stu.ZoekId(ktpId);\r\n                LogboekMelding(string.Format(ProjectResources.TradA002418, stuIndex));\r\n                _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Middel);\r\n            }\r\n            return middel!; //Throw exception is null??\r\n        }\r\n\r\n        public BMeting? GeefMeting(int objId)\r\n        {\r\n            BMeting? meting = null;\r\n            if (m_LeesMeting != null) meting = m_LeesMeting(objId);\r\n            return meting;\r\n\r\n        }\r\n        public BMeting? GeefMeting(Guid mtnGuid)\r\n        {\r\n            BMeting? meting = null;\r\n            if (m_LeesMetingGuid != null)\r\n                meting = m_LeesMetingGuid(mtnGuid);\r\n            return meting;\r\n\r\n\r\n        }\r\n        public BMiddel GeefMiddel(string? midcde)\r\n        {\r\n            Debug.Assert(m_Mid != null);\r\n\r\n            // bepaal of er al minstens 1 kostenpost is\r\n            // die een middel met de nieuwe code toepast:\r\n            BMiddel? middel = null;\r\n            if (!string.IsNullOrEmpty(midcde))\r\n            {\r\n                middel = _Mid.ZoekMidCde(midcde, out bool verwijderd);\r\n                if (middel == null && !verwijderd && m_LeesMiddel != null)\r\n                {\r\n                    middel =\r\n                       m_LeesMiddel(BMiddel.c_GeenMidId, midcde, -1);          // wordt hierbij ook in m_Mid geplaatst\r\n                }\r\n            }\r\n            return middel!; //Throw exception is null??\r\n        }\r\n\r\n        /// <summary>Bereken voor iedere valuta (ook de basivaluta) het gebruik \r\n        /// NB Deze method berekent het valutagebruik over alle regels. Er wordt (nog) geen rekening gehouden met selecties\r\n        /// </summary>\r\n        public void BerekenValutaGebruik()\r\n        {\r\n            m_BasisValuta!.NettoTotaal = m_BasisValuta.BrutoTotaal = 0.0;\r\n            foreach (BValutaDeco valuta in BegrotingsValuta)\r\n            {\r\n                valuta.NettoTotaal = valuta.BrutoTotaal = 0.0;\r\n            }\r\n\r\n            for (int stuIndex = 0; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                BStructuurRegel stuRegel = _Stu[stuIndex];\r\n                if (stuRegel._Tpe == EOnderbouwing.Kostenpost)\r\n                {\r\n                    BKostenpost kp = (BKostenpost)_Stu.GeefBegrotingsRegel(stuRegel);\r\n                    if (kp._Actief)\r\n                    {\r\n                        BValutaDeco valuta = GeefValutaMetId(kp._Middel._VltId);\r\n                        BXtoKst xto = kp.GeefBedragen();\r\n                        double uurtarief = kp.Begroting.GeefUurTarief(kp._Middel._UlnCde).Waarde;\r\n                        double arbeid = kp._Middel._UurNrm * uurtarief;\r\n                        double bedragen = kp._Middel._PrsMta + kp._Middel._PrsMte + kp._Middel._PrsOda;\r\n                        double valutaBedrag = (bedragen + arbeid) * kp._DrkHvh;\r\n                        valuta.NettoTotaal += valutaBedrag;\r\n                        valuta.BrutoTotaal += valutaBedrag * valuta.KoersFactor;\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        public BValutaDeco GeefValutaMetId(int id)\r\n        {\r\n            return BegrotingsValuta.First(v => v._VltId == id);\r\n        }\r\n        public BUurloonBVzl GeefUurloonBVzl()\r\n        {\r\n            Debug.Assert(_REl._Uln is BUurloonBVzl, \"BBegroting.GeefUurloonBVzl() - _REl._Uln is geen BUurloonBVzl\");\r\n            return (BUurloonBVzl)_REl._Uln;\r\n        }\r\n        /// <summary>\r\n        /// Controleer of de uurlooncode in de begroting is opgenomen.\r\n        /// Ja return true\r\n        /// Nee return false\r\n        /// </summary>\r\n        /// <param name=\"uurlooncode\"></param>\r\n        /// <returns></returns>\r\n        public bool GebruiktUurloon(string uurlooncode)\r\n        {\r\n            int stuIndex = 0;\r\n            while (stuIndex < _Stu._Aantal)\r\n            {\r\n                // Zorg dat de begrotingsregel gelezen is\r\n                _Stu.LeesBegrotingsRegel(stuIndex);\r\n                BStructuurRegel stuRegel = _Stu[stuIndex];\r\n                if (stuRegel._Regel?._OnderbouwingType == EOnderbouwing.Kostenpost)\r\n                {\r\n                    BKostenpost kp = (BKostenpost)stuRegel._Regel;\r\n                    if (kp._UlnCde == uurlooncode)\r\n                        return true;\r\n                }\r\n                stuIndex++;\r\n            }\r\n\r\n\r\n            return false;\r\n        }\r\n        public bool GebruiktProdFact()\r\n        {\r\n            IList<IBegrotingsRegel> ktplijst = _Stu.GeefBgrRegels((int)EOnderbouwing.Kostenpost);\r\n            if (ktplijst.Where(item => item._HeeftProductieFactor).Count() > 0)\r\n            {\r\n                return true;\r\n            }\r\n            return false;\r\n        }\r\n        /// <summary>Geef het type van de begroting als leesbare tekst terug (voluit geschreven met hoofdletter)\r\n        /// </summary>\r\n        /// <param name=\"type\">Opgevraagde type</param>\r\n        /// <returns>De tekst of \"Onbepaald\" indien geen bekend type</returns>\r\n        public static string GeefTypeAlsLeesbareTekst(EBgrTpe type)\r\n        {\r\n            string alsTekst = \"Onbepaald\";//NIETVERTALEN\r\n            switch (type)\r\n            {\r\n                case EBgrTpe.Elementen:\r\n                    alsTekst = \"Elementen\";//NIETVERTALEN\r\n                    break;\r\n                case EBgrTpe.Traditioneel:\r\n                    alsTekst = \"Traditioneel\";//NIETVERTALEN\r\n                    break;\r\n                case EBgrTpe.Onderhoud:\r\n                    alsTekst = \"Onderhoud\";//NIETVERTALEN\r\n                    break;\r\n                case EBgrTpe.Raw:\r\n                    alsTekst = \"Raw\";//NIETVERTALEN\r\n                    break;\r\n            }\r\n            return alsTekst;\r\n        }\r\n        public static string GeefTypeAlsLeesbareTekstXml(EBgrTpe type, int versie)\r\n        {\r\n            string alsTekst = \"Onbepaald\";//NIETVERTALEN\r\n\r\n            if (versie < 5)\r\n            {\r\n                switch (type)\r\n                {\r\n                    case EBgrTpe.Elementen:\r\n                        alsTekst = \"Elementen\";//NIETVERTALEN\r\n                        break;\r\n                    case EBgrTpe.Traditioneel:\r\n                        alsTekst = \"Traditioneel\";//NIETVERTALEN\r\n                        break;\r\n                    case EBgrTpe.Onderhoud:\r\n                        alsTekst = \"Onderhoud\";//NIETVERTALEN\r\n                        break;\r\n                    case EBgrTpe.Raw:\r\n                        alsTekst = \"Raw\";//NIETVERTALEN\r\n                        break;\r\n                }\r\n                return alsTekst;\r\n\r\n            }\r\n            else\r\n            {\r\n                switch (type)\r\n                {\r\n                    case EBgrTpe.Elementen:\r\n                        alsTekst = \"ELT\";//NIETVERTALEN\r\n                        break;\r\n                    case EBgrTpe.Traditioneel:\r\n                        alsTekst = \"TRD\";//NIETVERTALEN\r\n                        break;\r\n                    case EBgrTpe.Onderhoud:\r\n                        alsTekst = \"OND\";//NIETVERTALEN\r\n                        break;\r\n                    case EBgrTpe.Raw:\r\n                        alsTekst = \"RAW\";//NIETVERTALEN\r\n                        break;\r\n                }\r\n            }\r\n            return alsTekst;\r\n        }\r\n\r\n        public static bool GeefBgrTypeVanTekst(string tpe, out EBgrTpe bgrTpe)\r\n        {\r\n            bgrTpe = (EBgrTpe)(-1);\r\n            switch (tpe.ToLower())\r\n            {\r\n                case \"elementen\"://NIETVERTALEN\r\n                case \"elt\"://NIETVERTALEN\r\n                    bgrTpe = EBgrTpe.Elementen;\r\n                    break;\r\n                case \"traditioneel\"://NIETVERTALEN\r\n                case \"trd\"://NIETVERTALEN\r\n                    bgrTpe = EBgrTpe.Traditioneel;\r\n                    break;\r\n                case \"onderhoud\"://NIETVERTALEN\r\n                case \"odh\"://NIETVERTALEN\r\n                    bgrTpe = EBgrTpe.Onderhoud;\r\n                    break;\r\n                case \"raw\"://NIETVERTALEN\r\n                    bgrTpe = EBgrTpe.Raw;\r\n                    break;\r\n            }\r\n            Debug.Assert((int)bgrTpe != -1, \"BBegroting.GeefBgrTypeVanTekst Onbekend type\");\r\n            return bgrTpe != (EBgrTpe)(-1);\r\n        }\r\n\r\n        public static string GeefOnderbouwingAlsLeesbareTekst(EOnderbouwing onderbouwing)\r\n        {\r\n            string alsTekst = \"onbepaald\";//NIETVERTALEN\r\n            switch (onderbouwing)\r\n            {\r\n                case EOnderbouwing.Commentaar: alsTekst = \"commentaar\"; break;//NIETVERTALEN\r\n                case EOnderbouwing.Element: alsTekst = \"element\"; break;//NIETVERTALEN\r\n                case EOnderbouwing.Kostenpost: alsTekst = \"kostenpost\"; break;//NIETVERTALEN\r\n                case EOnderbouwing.Opslagpost: alsTekst = \"opslagpost\"; break;//NIETVERTALEN\r\n            }\r\n            return alsTekst;\r\n        }\r\n        public static EOnderbouwing GeefOnderbouwingVanTekst(string onderbouwing)\r\n        {\r\n            EOnderbouwing alsOnderbouwing;\r\n            switch (onderbouwing)\r\n            {\r\n                case \"commentaar\": alsOnderbouwing = EOnderbouwing.Commentaar; ; break;//NIETVERTALEN\r\n                case \"element\": alsOnderbouwing = EOnderbouwing.Element; break;//NIETVERTALEN\r\n                case \"kostenpost\": alsOnderbouwing = EOnderbouwing.Kostenpost; break;//NIETVERTALEN\r\n                case \"opslagpost\": alsOnderbouwing = EOnderbouwing.Opslagpost; break;//NIETVERTALEN\r\n                default: throw new OnbekendOnderbouwingstypeException();//NIETVERTALEN\r\n            }\r\n            return alsOnderbouwing;\r\n        }\r\n\r\n        public BRawInfo GeefRawInfo()\r\n        {\r\n            Debug.Assert(_Tpe == EBgrTpe.Raw, \"BBegrotingstype is niet Raw.\");\r\n            m_RawInfo ??= new BRawInfo(m_Bgv);\r\n            return m_RawInfo;\r\n        }\r\n\r\n        #endregion\r\n\r\n        #region Hulpfuncties\r\n        public void BgrRglGewijzigd(IBegrotingsRegel regel, bool rekenen)\r\n        {\r\n            if (rekenen && !m_Snel)\r\n            {\r\n                // doorgeven aan BStructuur-object\r\n                _Stu.RegelMoetRekenen(regel._Id);\r\n                MoetRekenen = true;  // herberekening is noodzakelijk\r\n            }\r\n        }\r\n\r\n        public bool HeeftLegeElementCodes(BBegrotingsRegel.EGegeven codeKolom)\r\n        {\r\n            string? orgDoc = _logboek.Document;\r\n            bool legeElementCodes = false;\r\n\r\n            try\r\n            {\r\n                _logboek.Document = _DocumentNaam;\r\n\r\n                for (int stuIndex = 1; stuIndex < _Stu._Aantal; stuIndex++) // root doet niet mee\r\n                {\r\n                    BStructuurRegel stuRegel;\r\n                    if (_Stu[stuIndex]._Tpe == EOnderbouwing.Element)\r\n                    {\r\n                        stuRegel = _Stu[stuIndex];\r\n                        if (stuRegel._Regel == null)\r\n                            _Stu.LeesBegrotingsRegel(stuIndex);\r\n\r\n                        string code = stuRegel._Regel!.GeefString(codeKolom, true);\r\n                        if (string.IsNullOrEmpty(code))\r\n                        {\r\n                            legeElementCodes = true;\r\n                            _logboek.Toevoegen(_DocumentNaam, stuIndex, ProjectResources.TradB2413);\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                _logger.LogExceptionWithMessage(ex);\r\n            }\r\n            finally\r\n            {\r\n                _logboek.Document = orgDoc;\r\n            }\r\n\r\n            return legeElementCodes;\r\n        }\r\n\r\n        public void MiddelGewijzigd(int midId, bool rekenen)\r\n        {\r\n            // doorgeven aan BStructuur-object\r\n            if (!m_Snel)\r\n            {\r\n                _Stu.MiddelGewijzigd(midId, _Umc, rekenen);\r\n\r\n                // De snelle modus wordt altijd afgesloten met volledig doorrekenen\r\n                // In dat geval hoeft er nu niets te gebeuren\r\n                if (!m_Snel && rekenen)\r\n                    MoetRekenen = true;  // herberekening is noodzakelijk\r\n            }\r\n        }\r\n        public void UurloonBVzlGewijzigd()\r\n        {\r\n            _REl.UurloonBVzlGewijzigd();\r\n        }\r\n        private string GeefOpmaakGegeven(string opmkey)\r\n        {\r\n            BBegrotingsGegeven? bgv = _Bgv.GeefBegrotingsGegeven(opmkey);\r\n            if (bgv != null)\r\n                return bgv._Wde.TrimEnd();\r\n            return string.Empty;\r\n        }\r\n        public bool HeeftProductieFactor()\r\n        {\r\n            bool productieFactorGevonden = false;\r\n            for (int stuIndex = 0; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                BStructuurRegel rgl = _Stu.LeesBegrotingsRegel(stuIndex);\r\n                if (rgl._Regel?._HeeftProductieFactor == true) // && rgl._Tpe == EOnderbouwing.Kostenpost\r\n                {\r\n                    productieFactorGevonden = true;\r\n                    break;\r\n                }\r\n            }\r\n            return productieFactorGevonden;\r\n        }\r\n\r\n        public EBimMeetstaatKoppelVersie GeefBimKoppelVersie()\r\n        {\r\n            EBimMeetstaatKoppelVersie bimKoppelVersie = EBimMeetstaatKoppelVersie.Onbekend;\r\n\r\n            if (m_Metingen != null)\r\n            {\r\n                List<BStructuurRegel> metingRegels = (from BStructuurRegel rgl in _Stu.Lijst\r\n                                                      where rgl._Regel?._Meting != null &&\r\n                                                            rgl._Regel?._MetingProvider == EMetingProvider.BimOnline\r\n                                                      select rgl).ToList();\r\n\r\n                if (metingRegels.Count > 0)\r\n                {\r\n                    bool idKoppeling = (from BStructuurRegel rgl in metingRegels\r\n                                        where rgl._Regel?._Meting?._MtnGuid == Guid.Empty\r\n                                        select rgl).Any();\r\n\r\n                    bool guidKoppeling = (from BStructuurRegel rgl in metingRegels\r\n                                          where rgl._Regel?._Meting?._MtnGuid != Guid.Empty\r\n                                          select rgl).Any();\r\n\r\n                    if (idKoppeling) bimKoppelVersie |= EBimMeetstaatKoppelVersie.Id;\r\n                    if (guidKoppeling) bimKoppelVersie |= EBimMeetstaatKoppelVersie.Guid;\r\n\r\n                    Debug.Assert(bimKoppelVersie != EBimMeetstaatKoppelVersie.Combinatie, \"Ongeldige combinatie van bim metingen oude en nieuwe stijl\");//NIETVERTALEN\r\n                }\r\n\r\n            }\r\n            return bimKoppelVersie;\r\n        }\r\n\r\n        private void WijzigOpmaakGegeven(string opmkey, string opmwaarde, string opmtitel)\r\n        {\r\n            if (opmwaarde.Length <= c_OpmLen)\r\n            {\r\n                BBegrotingsGegeven bgv = _Bgv.MaakBegrotingsGegeven(opmkey, EGgvTpe.Tekst, opmtitel);//NIETVERTALEN\r\n                bgv._Wde = opmwaarde;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// Maak van een kostenpost een sjoemelpost.\r\n        /// Een sjoemelpost is een kostenpost waarvan de hoeveelheid altijd 1 is.\r\n        /// De materiaalprijs in het bijbehorende middel wordt gevarieerd.\r\n        /// Op die manier kan er altijd naar een vast begrotingstotaal toe worden gerekend.\r\n        /// Deze functie:\r\n        /// - is zonder UNDO\r\n        /// - als er al een sjoemelpost is dan wijzigt er niets\r\n        /// </summary>\r\n        /// <param name=\"kostenpost\">De kostenpost die gebruikt zal worden om naar een vast begrotingstotaal toe te rekenen</param>\r\n        public void LeesXmlVtt(BKostenpost kostenpost)\r\n        {\r\n            if (_VttId == 0)\r\n            {\r\n                if (_Stu.ZoekId(kostenpost._Id, out int vttIndex))\r\n                {\r\n                    BWijzigVttId opdracht = new BWijzigVttId(vttIndex);\r\n                    opdracht.Uitvoeren(this);\r\n                }\r\n            }\r\n        }\r\n        public void SetActieContext(EActieContext actieContext)\r\n        {\r\n            m_ActieContext = actieContext;\r\n        }\r\n\r\n        /// <summary>Wijzig het begrotingtype en stel eventueel gegevens in op basis van dit type (o.a. Raw)\r\n        /// </summary>\r\n        /// <param name=\"nieuwType\">Het nieuwe type van de begroting</param>\r\n        private void ZetBegrotingType(EBgrTpe nieuwType)\r\n        {\r\n            if (m_Tpe != nieuwType)\r\n            {\r\n                m_Tpe = nieuwType;\r\n                // Bij een niet Raw begroting geen BBgrBldFieTopRaw toepassen\r\n                m_RawInfo?.ZetRawBegroting(m_Tpe == EBgrTpe.Raw);\r\n            }\r\n        }\r\n\r\n\r\n        #endregion\r\n\r\n        #region Opdrachten uitvoeren en ongedaan maken\r\n        /// <summary>Zoek een opgegeven elementcode van een gegeven niveau\r\n        /// </summary>\r\n        /// <param name=\"zoekCode\">De gezochte code (gezocht wordt op een trimend code)</param>\r\n        /// <param name=\"stuIndex\">Begin zoeken bij deze index</param>\r\n        /// <param name=\"vanNiveau\">De gevraagde code moet van hetzelfde niveau zijn (of van ??n van de kinderen ?)</param>\r\n        /// <returns>Indien gevonden de index van de sturegel anders -1</returns>\r\n        public int ZoekElementCodeVanNiveau(string zoekCode, int stuIndex, int vanNiveau)\r\n        {\r\n            int gevondenIndex = -1;\r\n            int beginZoeken = 0;\r\n            int eindeZoeken = _Stu._Aantal - 1;\r\n\r\n            if (vanNiveau > 1)\r\n            {\r\n                // Zoek binnen element tradEltParentId naar kinderen met dezelfde code\r\n                beginZoeken = stuIndex;\r\n                eindeZoeken = _Stu.EindeElement(stuIndex);\r\n            }\r\n\r\n            // Zoek nu in de range stuIndex tm EindeElement\r\n            // naar een elementregel van het gewenste niveau en met de opgegeven zoekcode\r\n            for (int zoekIndex = beginZoeken; zoekIndex < eindeZoeken; zoekIndex++)\r\n            {\r\n                if (_Stu[zoekIndex]._Niveau == vanNiveau && _Stu[zoekIndex]._Tpe == EOnderbouwing.Element)\r\n                {\r\n                    IBegrotingsRegel? elementRegel = _Stu.LeesBegrotingsRegel(zoekIndex)._Regel;\r\n                    string? elementCode = elementRegel?._CclCde.TrimEnd();\r\n                    if (string.Compare(elementCode, zoekCode, true) == 0)\r\n                    {\r\n                        gevondenIndex = zoekIndex;\r\n                        break;\r\n                    }\r\n                }\r\n            }\r\n            return gevondenIndex;\r\n        }\r\n\r\n        public BMeetstaat.EKopieerKoppeling BepaalKopieerKoppeling(bool binnenBegroting)\r\n        {\r\n            BMeetstaat.EKopieerKoppeling kopieerKoppeling\r\n               = binnenBegroting\r\n               ? BMeetstaat.KopieerKoppelingInternOptie(out bool vragen)\r\n               : BMeetstaat.KopieerKoppelingExternOptie(out vragen);\r\n\r\n            if (vragen)\r\n            {\r\n                Debug.Assert(m_VraagKopieerKoppeling != null, \"BBegroting.BepaalKopieerKoppeling() - geen m_VraagKopieerKoppeling\");//NIETVERTALEN\r\n\r\n                if (m_VraagKopieerKoppeling != null)\r\n                    kopieerKoppeling = m_VraagKopieerKoppeling(binnenBegroting, kopieerKoppeling);\r\n                else\r\n                    kopieerKoppeling = BMeetstaat.EKopieerKoppeling.Niets;\r\n            }\r\n            return kopieerKoppeling;\r\n        }\r\n        #region Knippen plakken verplaatsen nieuwe stijl\r\n        /// <summary>\r\n        /// Knippen en plakken\r\n        /// </summary>\r\n        /// <param name=\"opdracht\"></param>\r\n        /// <returns></returns>\r\n        public bool Uitvoeren(BPlakBgrRegels opdracht)\r\n        {\r\n            return _copyPasteBegroting.Paste(this, opdracht);\r\n        }\r\n        /// <summary>\r\n        /// Knippen en plakken\r\n        /// </summary>\r\n        /// <param name=\"opdracht\"></param>\r\n        /// <returns></returns>\r\n\r\n        public bool Uitvoeren(BPlakBgrRegelsUMCRef opdracht)\r\n        {\r\n            return _copyPasteBegroting.Paste(this, opdracht);\r\n        }\r\n\r\n        public bool Uitvoeren(BVervangMiddel vervangOpdracht)\r\n        {\r\n            if (m_Stu == null ||\r\n                _Stu._Aantal <= vervangOpdracht.StuIndexDoel ||\r\n                vervangOpdracht.StuIndexDoel <= 0 ||\r\n                vervangOpdracht.MiddelOrig == null)\r\n                return false;\r\n\r\n            var kostenpostDoel = _Stu[vervangOpdracht.StuIndexDoel]._Regel as BKostenpost;\r\n            if (kostenpostDoel == null)\r\n                return false;\r\n\r\n            // Wijzigt de code van het middel?\r\n            string nieuweCode = vervangOpdracht.MiddelOrig._MidCde;\r\n            if (string.Compare(nieuweCode, kostenpostDoel._CclCde, StringComparison.Ordinal) != 0)\r\n                vervangOpdracht.WijzigCodeOpdracht = new BWijzigMiddelCode(vervangOpdracht.StuIndexDoel, nieuweCode);\r\n\r\n            if (_Umc && vervangOpdracht.Controlevraag != null)\r\n            {\r\n                BMiddel? middel = _Mid.ZoekMidCde(nieuweCode, out bool verwijderd);  // Ga na of de nieuwe code al voorkomt in de doelbegroting\r\n                if (middel != null && !verwijderd)\r\n                {\r\n                    int aantalKostenposten = _Stu.AantalKostenpostenVanMiddel(middel._Id);\r\n                    bool inclActieveRegel = vervangOpdracht.WijzigCodeOpdracht == null;  // De code van de actieve regel komt al overeen met de nieuwe middelcode\r\n                    if (!vervangOpdracht.Controlevraag(nieuweCode, aantalKostenposten, inclActieveRegel))  // false: annuleren\r\n                        return false;\r\n                }\r\n            }\r\n            if (vervangOpdracht.WijzigCodeOpdracht != null && !Uitvoeren(vervangOpdracht.WijzigCodeOpdracht))\r\n                return false;\r\n\r\n            // Maak een kopie van het ongewijzigde middel ten behoeve van het ongedaan maken\r\n            BMiddel middelDoel = kostenpostDoel._Middel;\r\n            BMiddel middelOud = new BMiddel(middelDoel._Id, middelDoel._VltId);\r\n            middelOud.GegevensOvernemen(middelDoel);\r\n            vervangOpdracht.MiddelOud = middelOud;\r\n            vervangOpdracht.MiddelDoel = middelDoel;\r\n\r\n            // Neem ook de overige gegevens over, incl. de wzgdtm\r\n            middelDoel.GegevensOvernemen(vervangOpdracht.MiddelOrig);\r\n\r\n            // Neem ook de valuta over\r\n            middelDoel._VltId = BDocValuta.GeefValutaId(vervangOpdracht._bgrOrig.BegrotingsValuta, BegrotingsValuta, vervangOpdracht.MiddelOrig._VltId);\r\n\r\n            middelDoel.WijzigingInMiddel();\r\n            kostenpostDoel.BgrRglGewijzigd(true);\r\n\r\n            _Context = vervangOpdracht._Context;\r\n\r\n            return true;\r\n        }\r\n        #endregion Knippen plakken verplaatsen kopieren nieuwe stijl\r\n        public bool Uitvoeren(BWijzigMiddelCode opdracht)\r\n        {\r\n            //Ik ben hier ook niet echt gelukkig mee: js\r\n            if (null != MiddelBeHoudenBijGeneriekClipboard)\r\n            {\r\n                if (true == MiddelBeHoudenBijGeneriekClipboard)\r\n                    MiddelBeHoudenBijGeneriekClipboard = null;\r\n                return false;\r\n            }\r\n            MiddelBeHoudenBijGeneriekClipboard = null;\r\n            /* e-mail van HvdR aan AJdH dd. 1-7-2003 over het wijzigen van middeleigenschappen:\r\n\r\n               Zonder UMC\r\n               Elke kostenpost heeft z'n eigen middel.\r\n               Wijzigen van middeleigenschappen, inclusief z'n middelcode, heeft alleen betrekking op het middel bij de kostenpost.\r\n\r\n               Met UMC\r\n               Wijzigen van alle middeleigenschappen - uitgezonderd de middelcode - beinvloedt alle kostenposten die het middel toepassen. Bijv. wanneer de materiaalprijs wijzigt zal ook de eenheidsprijs van de kostenpost wijzigen.\r\n\r\n               Wijzigen van de middelcode met UMC\r\n               - Bepaal hoeveel kostenposten het middel met de oude middelcode toepassen voor de wijziging (#KTP_OUD)\r\n               - Bepaal hoeveel kostenposten het middel met de nieuwe middelcode toepassen na de wijziging (#KTP_NIEUW).\r\n               - Als #KTP_OUD = 1 en #KTP_NIEUW = 1 dan wijzigt alleen de middelcode van het middel.\r\n               - Als #KTP_OUD = 1 en #KTP_NIEUW > 1 dan moet het oude middel worden verwijderd.\r\n               - Als #KTP_OUD > 1 en #KTP_NIEUW = 1 dan moet een kopie van het oude middel worden gemaakt.\r\n               - Als #KTP_OUD > 1 en #KTP_NIEUW > 1 dan wijzigt alleen de koppeling tussen kostenpost en middel.\r\n               NB als de oude of nieuwe middelcode leeg is dan #KTP_OUD = 1 resp. #KTP_NIEUW = 1\r\n\r\n            */\r\n\r\n            IBegrotingsRegel? bgrRegel = _Stu[opdracht.StuIndex]._Regel;\r\n            if (bgrRegel?._OnderbouwingType != EOnderbouwing.Kostenpost)\r\n                return false;\r\n\r\n            BKostenpost kostenpost = (BKostenpost)bgrRegel;\r\n            BMiddel middelOud = kostenpost._Middel;\r\n\r\n            string midcde = opdracht.MidCdeNieuw;\r\n            if (midcde == middelOud._MidCde)\r\n                return false;               // geen wijziging\r\n\r\n            opdracht.WijzigDatum = middelOud._WzgDtm;\r\n            opdracht.MidCdeOud = middelOud._MidCde;\r\n            if (!_Umc)                                                   // geen unieke middelencodering?\r\n            {\r\n                // elke kostenpost z'n eigen middel:\r\n                //   dit heeft geen consequenties\r\n                //   voor andere kostenposten\r\n                middelOud.WijzigMiddelCode(midcde);\r\n                opdracht.GeenWijzigDatum = false;                      // tbv UNDO\r\n                kostenpost.MiddelGewijzigd(false);                       // false: geen herberekening nodig\r\n                return true;\r\n            }\r\n\r\n            // bepaal of er meer dan 1 kostenpost is\r\n            // die het middel met de huidige code toepast\r\n            opdracht.MeerKtpOud = false;\r\n            opdracht.MiddelOud = middelOud;\r\n            if (string.IsNullOrEmpty(middelOud._MidCde) == false &&\r\n               _Stu.ZoekMiddel(middelOud._Id, kostenpost._Id))\r\n                opdracht.MeerKtpOud = true;\r\n\r\n            // bepaal of er al minstens 1 kostenpost is\r\n            // die een middel met de nieuwe code toepast:\r\n            BMiddel? middelNieuw = GeefMiddel(midcde);                                        // Zoek in de begroting zelf\r\n            if (middelNieuw == null)\r\n            {\r\n                // Alleen in het prijzenboek zoeken en een middel overnemen als we een \"blanco\" code overschrijven\r\n                // Als het een bestaande code is dan betekent dit het wijzigen van de bestaande code van het middel\r\n\r\n                if (_Umc && _PrijzenBoek != null && string.IsNullOrEmpty(middelOud._MidCde))\r\n                {\r\n                    middelNieuw = _PrijzenBoek.GeefMiddel(midcde);                            // Zoek in de referentie\r\n                    if (middelNieuw != null)\r\n                    {\r\n                        BMiddel overgenomenMiddel = new BMiddel(GeefNieuwId(), middelNieuw, _VltId); // Maak een nieuw middel op basis van die uit de referentie\r\n                        middelNieuw = overgenomenMiddel;                                        // Dit is het middel welke aan de kostenpost gekoppeld wordt \r\n                        _Mid.MiddelToevoegen(middelNieuw);\r\n                        if (!_REl._Uln.HeeftUurloon(middelNieuw._UlnCde))                        // Neem indien nodig het uurloon over\r\n                        {\r\n                            UurloonOvernemen(_PrijzenBoek, middelNieuw._UlnCde);\r\n                            opdracht.UurloonToegevoegd = true;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n            opdracht.MeerKtpNieuw = middelNieuw != null;\r\n\r\n            // nu de benodigde wijziging(-en) uitvoeren\r\n            if (opdracht.MeerKtpOud)\r\n            {\r\n                // Meerdere kostenposten passen het middel\r\n                // met de huidige code toe\r\n                if (middelNieuw == null)                                  // Nieuwe code komt nog niet voor (of is leeg)\r\n                {\r\n                    // - Als #KTP_OUD > 1 en #KTP_NIEUW = 1 dan\r\n                    // moet een kopie van het oude middel worden gemaakt.\r\n                    middelNieuw = new BMiddel(GeefNieuwId(), middelOud, middelOud._VltId);\r\n                    middelNieuw.MiddelGewijzigd += MiddelGewijzigd;\r\n                    middelNieuw.WijzigMiddelCode(midcde);\r\n\r\n                    kostenpost.WijzigMiddel(middelNieuw, true);            // true: rekenen\r\n                    _Mid.MiddelToevoegen(middelNieuw);\r\n                }\r\n                else                                                     // Nieuwe middelcode wordt reeds toegepast\r\n                {\r\n                    // - Als #KTP_OUD > 1 en #KTP_NIEUW > 1 dan\r\n                    // wijzigt alleen de koppeling tussen\r\n                    // kostenpost en middel.\r\n                    kostenpost.WijzigMiddel(middelNieuw, true);\r\n                    middelNieuw.WijzigingInMiddel();// true: rekenen\r\n                    opdracht._Rekenen = true;\r\n                }\r\n            }\r\n            else\r\n            {\r\n                // Slechts 1 kostenpost die het middel\r\n                // met de huidige code toepast\r\n                if (middelNieuw == null)                                  // Nieuwe code komt nog niet voor (of is leeg)\r\n                {\r\n                    // - Als #KTP_OUD = 1 en #KTP_NIEUW = 1 dan\r\n                    // wijzigt alleen de middelcode van het middel.\r\n                    opdracht.GeenWijzigDatum = false;                   // Tbv UNDO\r\n                    middelOud.WijzigMiddelCode(midcde);\r\n                    kostenpost.MiddelGewijzigd(false);                    // false: geen herberekening nodig\r\n                }\r\n                else                                                     // Nieuwe middelcode wordt reeds toegepast\r\n                {\r\n                    // - Als #KTP_OUD = 1 en #KTP_NIEUW > 1 dan\r\n                    // moet het oude middel worden verwijderd.\r\n                    _Mid.MiddelVerwijderen(middelOud, false);             // false: geen UNDO-actie\r\n                    kostenpost.WijzigMiddel(middelNieuw, true);              // true: rekenen\r\n\r\n                    opdracht._Rekenen = true;\r\n                }\r\n                if (middelNieuw != null)\r\n                {\r\n                    middelNieuw.WijzigingInMiddel();\r\n                    middelNieuw.MiddelGewijzigd += MiddelGewijzigd;\r\n                }\r\n                middelOud?.WijzigingInMiddel();\r\n\r\n            }\r\n            return true;                                                // De middelcode van de kostenpost is gewijzigd\r\n        }\r\n        public bool Uitvoeren(BWijzigValuta opdracht)\r\n        {\r\n            m_BasisValuta!.BerekenKoersFactoren();\r\n            int vlt = opdracht.GeefValuta(_VltId);\r\n            if (null != m_Stu)\r\n            {\r\n                for (int rglNr = _Stu._Aantal - 1; rglNr >= 0; rglNr--)\r\n                {\r\n                    _Stu.LeesBegrotingsRegel(rglNr);\r\n                    BStructuurRegel stuRegel = _Stu[rglNr];\r\n                    stuRegel._Regel?.WijzigValuta(vlt, m_BasisValuta._ValutaVzl);\r\n                }\r\n            }\r\n            _Mid.WijzigValuta(vlt, opdracht.GeefAlles());\r\n            m_Bbd?.WijzigValuta(vlt);\r\n            BBedrag vstTot = _VstTot;\r\n            if ( /* vstTot._Waarde != 0.0 && */ vstTot.Valuta != vlt)\r\n            {\r\n                vstTot.WijzigValuta(vlt, m_BasisValuta._ValutaVzl);\r\n                _VstTot = vstTot;\r\n            }\r\n            _XtoKst.WijzigValuta(vlt, m_BasisValuta._ValutaVzl);\r\n            //_Vlt = vlt;\r\n\r\n            Rekenen(ERekendiepte.Volledig);\r\n            foreach (BValutaDeco valuta in BegrotingsValuta)\r\n            {\r\n                if (valuta._VltId == vlt)\r\n                {\r\n                    m_BasisValuta = (BDocValuta)valuta;\r\n                }\r\n            }\r\n            m_BasisValuta.BerekenKoersFactoren();\r\n            Rekenen(ERekendiepte.Volledig);\r\n            return true;\r\n        }\r\n\r\n        public bool Uitvoeren(BWijzigMiddelCodeExcl opdracht)\r\n        {\r\n            BMiddel middel = opdracht.Middel;\r\n            string midcde = opdracht.MidCdeNieuw;\r\n            if (midcde == middel._MidCde)\r\n                return false;                              // Geen wijziging\r\n\r\n            opdracht.MidCdeOud = middel._MidCde;\r\n\r\n            // Met UMC: is er al een middel\r\n            // met de nieuwe code?\r\n            if (_Umc && null != GeefMiddel(midcde))        // Middel gevonden met de nieuwe middelcode\r\n                return false;\r\n\r\n            middel.WijzigMiddelCode(midcde);\r\n            MiddelGewijzigd(middel._Id, false);            // false: geen herberekening nodig\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BWijzigBgrOms opdracht)\r\n        {\r\n            m_Oms = opdracht.OmsNieuw;\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BWijzigRawVoorblad opdracht)\r\n        {\r\n            _RawVoorblad = opdracht.VoorbladNieuw;\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BWijzigRawInschrijfbiljet opdracht)\r\n        {\r\n            _RawInschrijfBiljet = opdracht.InschrijfbiljetNieuw;\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BWijzigBgrRefElt opdracht)\r\n        {\r\n            _ElementenBoekNaam = opdracht.RefEltNieuw;\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BWijzigBgrRefPrz opdracht)\r\n        {\r\n            _PrijzenBoekNaam = opdracht.RefPrzNieuw;\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BWijzigBgrRefLevPrz opdracht)\r\n        {\r\n            _LevPrijzenBoekNaam = opdracht.RefLevPrzNieuw;\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BWijzigKostenbestand opdracht)\r\n        {\r\n            if (opdracht.Nieuwbouw)\r\n                _KostenbestandEigenschappenNieuwbouw = opdracht.IdentificatieNieuw;\r\n            else\r\n                _KostenbestandEigenschappenOnderhoud = opdracht.IdentificatieNieuw;\r\n            return true;\r\n        }\r\n\r\n        public bool Uitvoeren(BWijzigKostenbestandParameters opdracht)\r\n        {\r\n            _KostenbestandOnderhoudParameters = opdracht.ParametersNieuw;\r\n            return true;\r\n        }\r\n\r\n        public bool Uitvoeren(BWijzigBgrTpe opdracht)\r\n        {\r\n            ZetBegrotingType(opdracht.TpeNieuw);\r\n            Rekenen(ERekendiepte.Volledig);\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BWijzigVttId opdracht)\r\n        {\r\n            int vttIdOud = _VttId;\r\n            if (vttIdOud == 0 && opdracht._VttIndexNieuw == 0)\r\n                return false;\r\n\r\n            int vttIdNieuw = 0;\r\n            BKostenpost? kostenpostNieuw = null;\r\n            if (opdracht._VttIndexNieuw > 0)\r\n            {\r\n                _Stu.LeesBegrotingsRegel(opdracht._VttIndexNieuw);\r\n                BStructuurRegel stuRegel = _Stu[opdracht._VttIndexNieuw];\r\n                if (stuRegel._Tpe != EOnderbouwing.Kostenpost ||\r\n                   (vttIdOud > 0 && stuRegel._Id == vttIdOud))\r\n                    return false;\r\n\r\n                vttIdNieuw = stuRegel._Id;\r\n                kostenpostNieuw = stuRegel._Regel as BKostenpost;\r\n            }\r\n\r\n            if (vttIdOud != 0)\r\n            {\r\n                opdracht._VttIndexOud = _Stu.ZoekKostenpost(vttIdOud);      // tbv UNDO\r\n\r\n                //    De vorige kostenpost die gebruikt werd om naar een vast totaal toe te\r\n                //    rekenen moet weer een reguliere kostenpost worden.\r\n                // -> Is nu anders:\r\n                // De vorige kostenpost die gebruikt werd om naar een vast totaal toe te\r\n                // rekenen moet een passieve kostenpost worden.\r\n                _Stu.LeesBegrotingsRegel(opdracht._VttIndexOud);\r\n                BStructuurRegel stuRegel = _Stu[opdracht._VttIndexOud];\r\n                BKostenpost? kostenpostOud = stuRegel._Regel as BKostenpost;\r\n                if (kostenpostOud?._Id == _VttId)\r\n                {\r\n                    opdracht._VttOud_Stt = kostenpostOud._Stt;\r\n                    opdracht._VttOud_Dri = kostenpostOud._Dri;\r\n\r\n                    // EDri dri = (m_Tpe == EBgrTpe.Elementen) ? EDri.Drn : EDri.Tgd;\r\n                    // kostenpostOud.WijzigDri(dri);\r\n                    kostenpostOud.WijzigDri(EDri.Drn);\r\n                    kostenpostOud._Actief = false;\r\n\r\n                }\r\n            }\r\n\r\n            VasttotaalId = vttIdNieuw;        // kan 0 zijn\r\n\r\n            if (kostenpostNieuw != null)\r\n            {\r\n                opdracht.KostenpostOpslaan(kostenpostNieuw);\r\n                kostenpostNieuw.WijzigRegelStatus(ERegelStatus.Normaal);\r\n                // Nieuw middel aanmaken, aan kostenpost koppelen en in de middelenlijst opnemen\r\n                VerwijderKtpMiddel(kostenpostNieuw, true);\r\n                if (kostenpostNieuw._HeeftProductieFactor)\r\n                {\r\n                    kostenpostNieuw.ZetProductieFactorUit();\r\n                }\r\n                BMiddel middel = new BMiddel(GeefNieuwId(), _VltId);\r\n                middel.MiddelGewijzigd += MiddelGewijzigd;\r\n                middel._Oms = kostenpostNieuw._Middel._Oms;\r\n                middel._Enh = kostenpostNieuw._Middel._Enh;\r\n                kostenpostNieuw.MaakVttKostenpost(middel);\r\n                _Mid.MiddelToevoegen(middel);\r\n                kostenpostNieuw._Actief = true;\r\n            }\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BWijzigVttBedrag opdracht)\r\n        {\r\n            _VstTot = opdracht._vttBedragNieuw;\r\n            if (opdracht._Rekenen)\r\n            {\r\n                MoetRekenen = true;     // herberekening is noodzakelijk\r\n                Rekenen(ERekendiepte.Wijzigingen);\r\n            }\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BWijzigUmc opdracht)\r\n        {\r\n            if (opdracht.Umc == _Umc)\r\n                return false;                        // Geen wijziging\r\n\r\n            if (opdracht.Umc)\r\n            {\r\n                List<string>? dubbeleCodes = opdracht.DubbeleCodes;\r\n                var result = _Mid.UniekGecodeerd(out dubbeleCodes, 0, out _);\r\n                opdracht.DubbeleCodes = dubbeleCodes;\r\n\r\n                if (!result) return false;\r\n            }\r\n            else\r\n            {\r\n                opdracht.Middelen = new Hashtable();\r\n                int stuIndex = -1;\r\n                BKostenpost? ktp = (BKostenpost?)_Stu.GeefVolgendeBgrRegel(EOnderbouwing.Kostenpost, ref stuIndex);\r\n                while (ktp != null)\r\n                {\r\n                    BMiddel middel = ktp._Middel;\r\n                    if (!string.IsNullOrEmpty(middel._MidCde))\r\n                    {\r\n                        if (opdracht.Middelen.Contains(middel._Id))\r\n                        {\r\n                            // duplicaat Middel aanmaken\r\n                            var duplMiddel = new BMiddel(GeefNieuwId(), middel, middel._VltId);\r\n                            duplMiddel.MiddelGewijzigd += MiddelGewijzigd;\r\n                            ktp.WijzigMiddel(duplMiddel, false);   // false: rekenen is niet nodig\r\n                            _Mid.MiddelToevoegen(duplMiddel);\r\n                        }\r\n                        else\r\n                        {\r\n                            opdracht.Middelen.Add(middel._Id, middel);\r\n                        }\r\n                    }\r\n                    ktp = (BKostenpost?)_Stu.GeefVolgendeBgrRegel(EOnderbouwing.Kostenpost, ref stuIndex);\r\n                }\r\n            }\r\n\r\n            _Umc_Private = opdracht.Umc;\r\n            return true;\r\n        }\r\n        public bool Uitvoeren(BVerwijderNieuwePagina opdracht)\r\n        {\r\n            if (opdracht.StuIndexLijst == null)\r\n            {\r\n                opdracht.StuIndexLijst = new List<int>();\r\n                for (int stuIndex = _Stu._Aantal - 1; stuIndex > 0; stuIndex--)\r\n                {\r\n                    IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n                    if (bgrRegel?._NieuwePagina == true)\r\n                    {\r\n                        bgrRegel?._NieuwePagina = false;\r\n                    }\r\n                }\r\n            }\r\n            else\r\n            {\r\n                foreach (int stuIndex in opdracht.StuIndexLijst)\r\n                {\r\n                    IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n                    bgrRegel?._NieuwePagina = false;\r\n                }\r\n            }\r\n            return opdracht.StuIndexLijst.Count > 0;\r\n        }\r\n        public bool Uitvoeren(BActualiseren2baOpdracht opdracht)\r\n        {\r\n            return opdracht.Uitvoeren(this);\r\n        }\r\n\r\n        public static bool Uitvoeren(BOpdracht opdracht)\r\n        {\r\n            Debug.Assert(false, \"BBegroting.Uitvoeren() - niet geimplementeerd: \" + opdracht.ToString());\r\n            return false;\r\n        }\r\n        public void OngedaanMaken(BVervangMiddel opdracht)\r\n        {\r\n            OngedaanMakenMiddelVervangen(opdracht);\r\n            opdracht._RegelNummer = opdracht.StuIndexDoel;\r\n        }\r\n\r\n        public void MeetstaatKopieenVerwijderen(BMeetstaatKopieRegistratie? meetstaatKopieRegistratie)\r\n        {\r\n            if (meetstaatKopieRegistratie != null)\r\n            {\r\n                // Verwijder koppelingen\r\n                int index = 0;\r\n                int id = meetstaatKopieRegistratie.GeefKoppelingIdKopie(ref index);\r\n                while (id != 0)\r\n                {\r\n                    VerwijderMeetstaatKoppeling(id, out BMeetstaatKoppeling? _, out BewaarItemMutatieStatus _);\r\n                    id = meetstaatKopieRegistratie.GeefKoppelingIdKopie(ref index);\r\n                }\r\n\r\n                // Verwijder meetstaten\r\n                index = 0;\r\n                id = meetstaatKopieRegistratie.GeefMeetstaatIdKopie(ref index);\r\n                while (id != 0)\r\n                {\r\n                    VerwijderMeetstaat(id);\r\n                    id = meetstaatKopieRegistratie.GeefMeetstaatIdKopie(ref index);\r\n                }\r\n\r\n                // Verwijder meetstaatmodellen\r\n                index = 0;\r\n                id = meetstaatKopieRegistratie.GeefMeetstaatModelIdKopie(ref index);\r\n                while (id != 0)\r\n                {\r\n                    _MeetstaatModelVzl.VerwijderModel(id);\r\n                    id = meetstaatKopieRegistratie.GeefMeetstaatModelIdKopie(ref index);\r\n                }\r\n                VerhoogMeetstaatVersie();\r\n            }\r\n        }\r\n        public void OngedaanMaken(BPlakBgrRegels opdracht)\r\n        {\r\n            /*if (opdracht.m_NiveauOpdracht != null)\r\n               opdracht.m_NiveauOpdracht.OngedaanMaken(this);\r\n\r\n            if (opdracht.m_WijzigVttId != null)\r\n               OngedaanMaken(opdracht.m_WijzigVttId);*/\r\n\r\n            OngedaanMakenPlakken(opdracht);\r\n\r\n            BUurloonBVzl ulnVzl = (BUurloonBVzl)_REl._Uln;\r\n            ulnVzl.Verwijderen(opdracht.UurloonCodes);\r\n\r\n            BMeetstaatKopieRegistratie meetstaatKopieRegistratie = opdracht._MeetstaatKopieRegistratie;\r\n            MeetstaatKopieenVerwijderen(meetstaatKopieRegistratie);\r\n            _Context = opdracht._Context;\r\n            //opdracht._RegelNummer = opdracht.m_StuIndexDoel;\r\n            //opdracht._ExtraNummer = _Stu.ZoekElement(opdracht.m_PrtIdDoel, opdracht.m_StuIndexDoel);\r\n        }\r\n        private void OngedaanMakenPlakken(BPlakBgrRegels opdracht)\r\n        {\r\n\r\n            foreach (BStructuurRegel doelStructuurRegel in opdracht._DoelStructuurRegels.Reverse())\r\n            {\r\n                VerwijderBegrotingsRegel(doelStructuurRegel._IndexTag, true, false);\r\n                opdracht.StuIndexDoel = doelStructuurRegel._IndexOud;\r\n                opdracht._RegelNummer = opdracht.StuIndexDoel;\r\n\r\n                MoetRekenen = true;\r\n            }\r\n            _Context = opdracht._Context;\r\n        }\r\n        private void OngedaanMakenMiddelVervangen(BVervangMiddel opdracht)\r\n        {\r\n            opdracht.MiddelDoel.GegevensOvernemen(opdracht.MiddelOud);\r\n            opdracht.MiddelDoel._VltId = opdracht.MiddelOud._VltId;\r\n            opdracht.MiddelDoel.WijzigingInMiddel();\r\n\r\n            BKostenpost? kostenpostDoel = _Stu[opdracht.StuIndexDoel]._Regel as BKostenpost;\r\n            kostenpostDoel?.BgrRglGewijzigd(true);\r\n\r\n            if (opdracht.WijzigCodeOpdracht != null)\r\n                OngedaanMaken(opdracht.WijzigCodeOpdracht);\r\n\r\n            MoetRekenen = true;\r\n        }\r\n\r\n        public void OngedaanMaken(BWijzigMiddelCode opdracht)\r\n        {\r\n            //opdracht._RegelNummer = opdracht.m_StuIndex-1;\r\n            opdracht._RegelNummer = opdracht.StuIndex;\r\n            _Context = opdracht._Context;\r\n            BKostenpost? kostenpost = _Stu[opdracht.StuIndex]._Regel as BKostenpost;\r\n\r\n            if (!_Umc)                                                   // geen unieke middelencodering?\r\n            {\r\n                // elke kostenpost z'n eigen middel:\r\n                // dit heeft geen consequenties voor andere kostenposten\r\n                kostenpost?._Middel.WijzigMiddelCode(opdracht.MidCdeOud);\r\n                kostenpost?.MiddelGewijzigd(false);                       // false: geen herberekening nodig\r\n            }\r\n            else\r\n            {\r\n                if (opdracht.MeerKtpOud)           // Meerdere kostenposten pasten het middel met de oude code toe\r\n                {\r\n                    if (opdracht.MeerKtpNieuw)      // Nieuwe middelcode werd reeds toegepast\r\n                    {\r\n                        // - Als #KTP_OUD > 1 en #KTP_NIEUW > 1 dan wijzigde alleen de koppeling tussen kostenpost en middel.\r\n                        kostenpost?.WijzigMiddel(opdracht.MiddelOud, true);            // true: rekenen\r\n                    }\r\n                    else                             // Nieuwe code kwam nog niet voor (of was leeg)\r\n                    {\r\n                        // - Als #KTP_OUD > 1 en #KTP_NIEUW = 1 dan moest een kopie van het oude middel worden gemaakt.\r\n                        BMiddel? middelNieuw = kostenpost?._Middel;\r\n                        kostenpost?.WijzigMiddel(opdracht.MiddelOud, true);            // true: rekenen\r\n                        _Mid.MiddelVerwijderen(middelNieuw, true);  // true: een UNDO-actie\r\n                    }\r\n                }\r\n                else     // Slechts 1 kostenpost die het middel met de huidige code toepast\r\n                {\r\n                    if (opdracht.MeerKtpNieuw)      // Nieuwe middelcode werd reeds toegepast\r\n                    {\r\n                        // - Als #KTP_OUD = 1 en #KTP_NIEUW > 1 dan moest het oude middel worden verwijderd.\r\n                        _Mid.MiddelVerwijderenOngedaanMaken(1);\r\n                        kostenpost?.WijzigMiddel(opdracht.MiddelOud, true);            // true: rekenen\r\n                    }\r\n                    else                             // Nieuwe code kwam nog niet voor (of was leeg)\r\n                    {\r\n                        // - Als #KTP_OUD = 1 en #KTP_NIEUW = 1 dan wijzigde alleen de middelcode van het middel.\r\n                        kostenpost?._Middel.WijzigMiddelCode(opdracht.MidCdeOud);\r\n                        kostenpost?.MiddelGewijzigd(false);  // false: geen herberekening nodig\r\n                    }\r\n                    if (opdracht.UurloonToegevoegd)\r\n                    {\r\n                        // Verwijder overbodig geworden uurloon\r\n                        BUurloonBVzl ulnVzl = (BUurloonBVzl)_REl._Uln;\r\n                        ulnVzl.Verwijderen(1);\r\n                    }\r\n                }\r\n                BMiddel? mid = GeefMiddel(opdracht.MidCdeNieuw);\r\n                if (mid != null)\r\n                {\r\n                    if (_Mid.GeefMiddelenGebruikOpId(mid._Id, forceren: true).Count == 0)\r\n                        _Mid.MiddelVerwijderen(mid, true);\r\n                }\r\n            }\r\n            if (!opdracht.GeenWijzigDatum && kostenpost is { } kp)\r\n                kp._Middel._WzgDtm = opdracht.WijzigDatum;\r\n        }\r\n\r\n        public void OngedaanMaken(BWijzigMiddelCodeExcl opdracht)\r\n        {\r\n            BMiddel middel = opdracht.Middel;\r\n            middel.WijzigMiddelCode(opdracht.MidCdeOud);\r\n            MiddelGewijzigd(middel._Id, false);                     // false: geen herberekening nodig\r\n        }\r\n\r\n        public void OngedaanMaken(BWijzigValuta opdracht)\r\n        {\r\n            Uitvoeren(opdracht);\r\n        }\r\n\r\n        public void OngedaanMaken(BWijzigBgrOms opdracht)\r\n        {\r\n            m_Oms = opdracht.OmsOud;\r\n        }\r\n        public void OngedaanMaken(BWijzigRawInschrijfbiljet opdracht)\r\n        {\r\n            _RawInschrijfBiljet = opdracht.InschrijfbiljetOud;\r\n        }\r\n        public void OngedaanMaken(BWijzigRawVoorblad opdracht)\r\n        {\r\n            _RawVoorblad = opdracht.VoorbladOud;\r\n        }\r\n        public void OngedaanMaken(BWijzigBgrRefElt opdracht)\r\n        {\r\n            _ElementenBoekNaam = opdracht.RefEltOud;\r\n        }\r\n        public void OngedaanMaken(BWijzigBgrRefPrz opdracht)\r\n        {\r\n            _PrijzenBoekNaam = opdracht.RefPrzOud;\r\n        }\r\n        public void OngedaanMaken(BWijzigBgrRefLevPrz opdracht)\r\n        {\r\n            _LevPrijzenBoekNaam = opdracht.RefLevPrzOud;\r\n        }\r\n        public void OngedaanMaken(BWijzigKostenbestand opdracht)\r\n        {\r\n            if (opdracht.Nieuwbouw)\r\n                _KostenbestandEigenschappenNieuwbouw = opdracht.IdentificatieOud;\r\n            else\r\n                _KostenbestandEigenschappenOnderhoud = opdracht.IdentificatieOud;\r\n        }\r\n        public void OngedaanMaken(BWijzigKostenbestandParameters opdracht)\r\n        {\r\n            _KostenbestandOnderhoudParameters = opdracht.ParametersOud;\r\n        }\r\n        public void OngedaanMaken(BWijzigBgrTpe opdracht)\r\n        {\r\n            ZetBegrotingType(opdracht.TpeOud);\r\n            Rekenen(ERekendiepte.Volledig);\r\n        }\r\n        public void OngedaanMaken(BWijzigVttId opdracht)\r\n        {\r\n            BMiddel middel;\r\n            int vttIdNieuw = _VttId;\r\n            if (vttIdNieuw > 0)\r\n            {\r\n                BKostenpost? kostenpost = (BKostenpost?)_Stu.GeefBegrotingsRegel(vttIdNieuw);\r\n                if (kostenpost is not null)\r\n                {\r\n                    VerwijderKtpMiddel(kostenpost, true);   // true: een UNDO-actie\r\n                    middel = opdracht.KostenpostHerstellen(kostenpost);\r\n                    _Mid.MiddelToevoegen(middel);\r\n                    if (opdracht._MstKid != 0)\r\n                    {\r\n                        BMeetstaatKoppeling? mk = ZoekMeetstaatKoppeling(opdracht._MstKid);\r\n                        if (mk != null)\r\n                        {\r\n                            kostenpost.MeetstaatKoppeling(mk);\r\n                            if (opdracht._MstKid < 0)\r\n                                kostenpost.MeetstaatOverschreven(false);  // false : niet herstellen\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n            int vttIdOud = 0;\r\n            if (opdracht._VttIndexOud > 0)\r\n            {\r\n                _Stu.LeesBegrotingsRegel(opdracht._VttIndexOud);\r\n                BStructuurRegel stuRegel = _Stu[opdracht._VttIndexOud];\r\n                vttIdOud = stuRegel._Id;\r\n                BKostenpost? kostenpostOud = stuRegel._Regel as BKostenpost;\r\n                kostenpostOud?.StatusHerstellen(opdracht._VttOud_Stt);\r\n                kostenpostOud?.WijzigDri(opdracht._VttOud_Dri);\r\n\r\n                kostenpostOud?.MaakVttKostenpost(kostenpostOud._Middel);\r\n            }\r\n            VasttotaalId = vttIdOud;\r\n            opdracht._RegelNummer = opdracht._VttIndexNieuw;\r\n            _Context = opdracht._Context;\r\n\r\n        }\r\n        public void OngedaanMaken(BWijzigVttBedrag opdracht)\r\n        {\r\n            _VstTot = opdracht._vttBedragOud;\r\n            MoetRekenen = true;     // herberekening is noodzakelijk\r\n            Rekenen(ERekendiepte.Wijzigingen);\r\n        }\r\n        public void OngedaanMaken(BWijzigUmc opdracht)\r\n        {\r\n            _Umc_Private = !opdracht.Umc;\r\n            if (!opdracht.Umc)\r\n            {\r\n                Debug.Assert(opdracht.Middelen != null, \"BBegroting.OngedaanMaken(BWijzigUmc) - geen opdracht.m_Middelen\");\r\n\r\n                int stuIndex = -1;\r\n                BKostenpost? ktp = _Stu.GeefVolgendeBgrRegel(EOnderbouwing.Kostenpost, ref stuIndex) as BKostenpost;\r\n                while (ktp != null)\r\n                {\r\n                    BMiddel middel = ktp._Middel;\r\n                    if (string.IsNullOrEmpty(middel._MidCde) == false)\r\n                    {\r\n                        if (!opdracht.Middelen.Contains(middel._Id))\r\n                        {\r\n                            // Dit is een duplicaat middel, het origineel heeft dezelfde middelcode\r\n                            IDictionaryEnumerator de = opdracht.Middelen.GetEnumerator();\r\n                            while (de.MoveNext())\r\n                            {\r\n                                BMiddel? zoekMiddel = de.Value as BMiddel;\r\n                                if (zoekMiddel != null &&\r\n                                   zoekMiddel._MidCde == middel._MidCde)\r\n                                {\r\n                                    ktp.WijzigMiddel(zoekMiddel, false);   // false: rekenen is niet nodig\r\n                                    _Mid.MiddelVerwijderen(middel, true);  // true: er wordt nu iets ongedaan gemaakt\r\n                                    break;\r\n                                }\r\n                            }\r\n                        }\r\n                    }\r\n                    ktp = _Stu.GeefVolgendeBgrRegel(EOnderbouwing.Kostenpost, ref stuIndex) as BKostenpost;\r\n                }\r\n            }\r\n        }\r\n        public void OngedaanMaken(BVerwijderNieuwePagina opdracht)\r\n        {\r\n            foreach (int stuIndex in opdracht.StuIndexLijst)\r\n            {\r\n                IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel;\r\n                bgrRegel?._NieuwePagina = true;\r\n            }\r\n        }\r\n        public void OngedaanMaken(BActualiseren2baOpdracht opdracht)\r\n        {\r\n            opdracht.OngedaanMaken(this);\r\n        }\r\n\r\n        //niet gebruikt: public void OngedaanMaken(BOpdracht opdracht)\r\n        //{\r\n        //   Debug.Assert(false,\"BBegroting.OngedaanMaken() - niet geimplementeerd\");\r\n        //}\r\n        #endregion\r\n\r\n        #region Herindexeren bestand\r\n        private void ControleerElement()\r\n        {\r\n            if (!_structuurStatusFout.Uitvoeren(EBegrotingControleStap.Elementen))\r\n                return;\r\n\r\n            LogboekMelding(ProjectResources.TradA002419);\r\n\r\n            _voortgangsBalk.ZetAantalenMsg(0, _Stu._Aantal, ProjectResources.TradA002419, false, 0);\r\n            BUurloonBVzl ulnbVzl = GeefUurloonBVzl();\r\n\r\n            for (int stuIndex = 1; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                _voortgangsBalk.Perc(stuIndex);\r\n                switch (_Stu[stuIndex]._Tpe)\r\n                {\r\n                    case EOnderbouwing.Element:\r\n                        int elementId = _Stu[stuIndex]._Id;\r\n                        BElement? element = _Stu[stuIndex]._Regel as BElement;\r\n                        if (element != null && !ControleerUurloon(ulnbVzl, element, out _))\r\n                        {\r\n                            element._Uln.Opschonen();\r\n                            element.ZetMutatieStatus(BewaarItemMutatieStatus.Gewijzigd);\r\n                            _OpdrachtVzl.Gewijzigd();\r\n                            LogboekMelding(string.Format(ProjectResources.TradA0024110 + BStatics.c_Spatie,/*//NIETVERTALEN*/\r\n                                     elementId, stuIndex));\r\n                            _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Uurloon);\r\n                        }\r\n\r\n                        for (int zoekIndex = 1; zoekIndex < _Stu._Aantal; zoekIndex++)\r\n                        {\r\n                            if (zoekIndex != stuIndex &&\r\n                               _Stu[zoekIndex]._Tpe == EOnderbouwing.Element &&\r\n                               _Stu[zoekIndex]._Id == _Stu[stuIndex]._Id)\r\n                            {\r\n                                if (_structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.ControlerenEnRepareren)\r\n                                {\r\n                                    IBegrotingsRegel? nieuwElement = MaakNieuwElement(stuIndex);\r\n                                    LogboekMelding(string.Format(ProjectResources.TradA0024111,\r\n                                        elementId, stuIndex, _Stu[zoekIndex]._Tpe, _Stu[zoekIndex]._Id, zoekIndex, nieuwElement?._Id));\r\n                                }\r\n                                else\r\n                                {\r\n                                    LogboekMelding(string.Format(ProjectResources.TradA0024112,\r\n                                       elementId, stuIndex, _Stu[zoekIndex]._Tpe, _Stu[zoekIndex]._Id));\r\n                                }\r\n                                _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Element);\r\n                            }\r\n                        }\r\n                        break;\r\n                }\r\n            }\r\n        }\r\n\r\n        private bool ControleerUurloon(BUurloonBVzl ulnbVzl, BElement elm, out BUurloonC? ulc)\r\n        {\r\n            bool returnValue = true;\r\n            ulc = null;\r\n            foreach (BUurloonC item in elm._Uln._Vzl)\r\n            {\r\n                if (!ulnbVzl.HeeftUurloon(item._UlnCde))\r\n                {\r\n                    ulc = item;\r\n                    returnValue = false;\r\n                }\r\n            }\r\n            return returnValue;\r\n        }\r\n\r\n        private int ControleerHierarchie()\r\n        {\r\n            LogboekMelding(ProjectResources.TradA0024113);\r\n            int gewijzigd = 0;\r\n\r\n            List<int> aParents = new(20);\r\n\r\n            for (int teller = 0; teller < aParents.Capacity; teller++)\r\n                aParents.Add(-1);\r\n\r\n            BStructuurRegel stuRegel;\r\n            _voortgangsBalk.ZetAantalenMsg(0, _Stu._Aantal, ProjectResources.TradA0024114, false, 0);\r\n\r\n            for (int stuIndex = 0; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                _voortgangsBalk.Perc(stuIndex);\r\n                stuRegel = _Stu[stuIndex];\r\n                switch (stuRegel._Tpe)\r\n                {\r\n                    case EOnderbouwing.Element:\r\n                        if (stuRegel._Niveau != -1)\r\n                            aParents[stuRegel._Niveau] = stuRegel._Id;\r\n                        if (stuRegel._Niveau > 0)\r\n                        {\r\n                            // Restant weer op -1 zetten\r\n                            for (int nivo = stuRegel._Niveau + 1; nivo < aParents.Capacity; nivo++)\r\n                                aParents[nivo] = -1;\r\n\r\n                            if (aParents.Contains(stuRegel._PrtId) == false)\r\n                            {\r\n                                LogboekMelding(string.Format(ProjectResources.TradA0024115,\r\n                                   _Stu[stuIndex]._Id, stuIndex, _Stu[stuIndex]._PrtId));\r\n\r\n                                gewijzigd = 64 + 1024;\r\n                            }\r\n                        }\r\n                        break;\r\n\r\n                    default:\r\n                        if (stuRegel._Niveau > 0)\r\n                        {\r\n                            if (aParents.Contains(stuRegel._PrtId) == false)\r\n                            {\r\n                                LogboekMelding(string.Format(ProjectResources.TradA0024116,\r\n                                   _Stu[stuIndex]._Id, stuIndex, _Stu[stuIndex]._PrtId));\r\n\r\n                                gewijzigd = 64 + 1024;\r\n                            }\r\n                        }\r\n                        break;\r\n                }\r\n            }\r\n            return gewijzigd;\r\n        }\r\n\r\n        private void ControleerKpComId()\r\n        {\r\n            if (!_structuurStatusFout.Uitvoeren(EBegrotingControleStap.KostenpostCommentaar))\r\n                return;\r\n\r\n            LogboekMelding(ProjectResources.TradA0024117);\r\n\r\n            _voortgangsBalk.ZetAantalenMsg(0, _Stu._Aantal, ProjectResources.TradA0024117, false, 0);\r\n\r\n            for (int stuIndex = 0; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                _voortgangsBalk.Perc(stuIndex);\r\n                switch (_Stu[stuIndex]._Tpe)\r\n                {\r\n                    case EOnderbouwing.Kostenpost:\r\n                        for (int zoekIndex = stuIndex + 1; zoekIndex < _Stu._Aantal; zoekIndex++)\r\n                        {\r\n                            if (_Stu[zoekIndex]._Id == _Stu[stuIndex]._Id &&\r\n                               _Stu[zoekIndex]._Tpe == EOnderbouwing.Kostenpost)\r\n                            {\r\n                                if (_Stu[stuIndex]._Regel is not BKostenpost kostenpost)\r\n                                {\r\n                                    if (_structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.ControlerenEnRepareren)\r\n                                    {\r\n                                        IBegrotingsRegel? nieuweKostenpost = MaakNieuweKostenpost(stuIndex);\r\n                                        LogboekMelding(string.Format(ProjectResources.TradA0024118,\r\n                                           _Stu[stuIndex]._Id, stuIndex, _Stu[zoekIndex]._Tpe, _Stu[zoekIndex]._Id, zoekIndex, nieuweKostenpost?._Id));\r\n                                    }\r\n                                    else\r\n                                    {\r\n                                        LogboekMelding(string.Format(ProjectResources.TradA00241272617,\r\n                                        _Stu[stuIndex]._Id, stuIndex));\r\n                                    }\r\n                                }\r\n\r\n                                else\r\n                                {\r\n                                    if (_structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.ControlerenEnRepareren)\r\n                                    {\r\n                                        IBegrotingsRegel? nieuweKostenpost = MaakNieuweKostenpost(stuIndex);\r\n                                        LogboekMelding(string.Format(ProjectResources.TradA0024119,\r\n                                           kostenpost._Id, stuIndex, _Stu[zoekIndex]._Tpe, _Stu[zoekIndex]._Id, zoekIndex, nieuweKostenpost?._Id));\r\n                                    }\r\n                                    else\r\n                                    {\r\n                                        LogboekMelding(\r\n                                            string.Format(ProjectResources.TradA0024120,\r\n                                                kostenpost._Id,\r\n                                                stuIndex,\r\n                                                _Stu[zoekIndex]._Tpe));\r\n                                    }\r\n                                }\r\n                            }\r\n                        }\r\n                        break;\r\n\r\n                    case EOnderbouwing.Commentaar:\r\n                        for (int zoekIndex = stuIndex + 1; zoekIndex < _Stu._Aantal; zoekIndex++)\r\n                        {\r\n                            if (_Stu[zoekIndex]._Id == _Stu[stuIndex]._Id && _Stu[zoekIndex]._Tpe == EOnderbouwing.Commentaar)\r\n                            {\r\n                                int commentaarId = _Stu[stuIndex]._Id;\r\n                                if (_structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.ControlerenEnRepareren)\r\n                                {\r\n                                    IBegrotingsRegel? nieuwCommentaar = MaakNieuwCommentaar(stuIndex);\r\n                                    LogboekMelding(string.Format(ProjectResources.TradA0024121,\r\n                                       commentaarId, stuIndex, _Stu[zoekIndex]._Tpe, _Stu[zoekIndex]._Id, zoekIndex, nieuwCommentaar?._Id));\r\n                                }\r\n                                else\r\n                                {\r\n                                    LogboekMelding(string.Format(ProjectResources.TradA0024122,\r\n                                       commentaarId, stuIndex));\r\n                                }\r\n                                _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Kostenpost);\r\n                            }\r\n                        }\r\n                        break;\r\n                }\r\n            }\r\n        }\r\n\r\n        private void ControleerMeetstaten()\r\n        {\r\n            if (!_structuurStatusFout.Uitvoeren(EBegrotingControleStap.Meetstaten))\r\n                return;\r\n\r\n            LogboekMelding(ProjectResources.TradA0024126);\r\n            bool controlerenEnRepareren = _structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.ControlerenEnRepareren;\r\n\r\n            // stap 0: zijn er koppelingen die naar een begrotingsregel wijzen terwijl de begrotingsregel geen meetstaatkoppelingID of een andere heeft?\r\n            BMeetstaatKoppeling msk_1, msk_2;\r\n            int mskID;\r\n            int stuIndex;\r\n            IBegrotingsRegel? begrotingsRegel;\r\n\r\n            bool maximaleNauwkeurigheid = _structuurStatusFout.Uitvoeren(EBegrotingControleStap.MaximaleNauwkeurigheid);\r\n            int aantalDecimalen = maximaleNauwkeurigheid ? 5 : 3;\r\n\r\n            if (_MeetstaatKoppelingen._Aantal > 0)\r\n            {\r\n                for (int mskIndex = _MeetstaatKoppelingen._Aantal - 1; mskIndex >= 0; mskIndex--)\r\n                {\r\n                    msk_1 = _MeetstaatKoppelingen[mskIndex];\r\n                    if (msk_1._DocumentId <= 0)\r\n                        continue;\r\n\r\n                    stuIndex = _Stu.ZoekId(msk_1._DocumentId);\r\n                    if (stuIndex <= 0)\r\n                    {\r\n                        _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.MeetstaatKoppelingIntegriteit);\r\n                        if (controlerenEnRepareren)\r\n                        {\r\n                            LogboekMelding(ProjectResources.TradMstNietbestaandeBgrRegelVerwijderd);\r\n                            _MeetstaatKoppelingen.Verwijderen(msk_1);\r\n                        }\r\n                        else\r\n                        {\r\n                            LogboekMelding(ProjectResources.TradMstNietbestaandeBgrRegel);\r\n                        }\r\n                        continue;\r\n                    }\r\n\r\n                    _Stu.LeesBegrotingsRegel(stuIndex);\r\n                    begrotingsRegel = _Stu[stuIndex]._Regel;\r\n                    if (Math.Abs(begrotingsRegel?._MstKid ?? 0) != msk_1._KoppelingId)\r\n                    {\r\n                        _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.MeetstaatKoppelingIntegriteit);\r\n                        if (controlerenEnRepareren)\r\n                        {\r\n                            _MeetstaatKoppelingen.Verwijderen(mskIndex);\r\n                            LogboekMelding(string.Format(ProjectResources.TradA00241273, msk_1._KoppelingId, stuIndex));\r\n                        }\r\n                        else\r\n                        {\r\n                            LogboekMelding(string.Format(ProjectResources.TradA00241274, msk_1._KoppelingId, stuIndex));\r\n                        }\r\n                    }\r\n                    else\r\n                    {\r\n                        ControleerMeetstaten_GekoppeldeHvh(stuIndex, begrotingsRegel, aantalDecimalen);\r\n                    }\r\n                }\r\n\r\n                // stap 1\r\n                // Controleer of er dubbele meetstaatkoppelingen voorkomen.\r\n                _voortgangsBalk.ZetAantalenMsg(0, _MeetstaatKoppelingen._Aantal, ProjectResources.TradA0024126, false, 0);\r\n                int verwijderd = -1;\r\n\r\n                int documentIDi, documentIDj;\r\n                for (int mskIndex_1 = 0; mskIndex_1 < _MeetstaatKoppelingen._Aantal; mskIndex_1++)\r\n                {\r\n                    _voortgangsBalk.Perc(mskIndex_1);\r\n\r\n                    msk_1 = _MeetstaatKoppelingen[mskIndex_1];\r\n\r\n                    documentIDi = msk_1._DocumentId;\r\n                    mskID = msk_1._KoppelingId;\r\n                    for (int mskIndex_2 = 0; mskIndex_2 < _MeetstaatKoppelingen._Aantal; mskIndex_2++)\r\n                    {\r\n                        msk_2 = _MeetstaatKoppelingen[mskIndex_2];\r\n                        documentIDj = msk_2._DocumentId;\r\n\r\n                        // Als documentIDi of documentIDj 0 is dan geen melding geven. Dan gaat het over meetstaten die gekoppeld zijn aan het begrotingsblad\r\n                        if (documentIDi == documentIDj && documentIDi != 0 && documentIDj != 0)\r\n                        {\r\n                            if (mskIndex_1 != mskIndex_2)\r\n                            {\r\n\r\n                                #region Controle welke verwijderd moet worden\r\n                                int teVerwijderen = -1;\r\n\r\n                                // Zoek via de structuurlijst naar de gekoppelde begrotingsregel\r\n                                stuIndex = _Stu.ZoekId(msk_1._DocumentId);\r\n                                // Als het documentid van deze 2 koppelingen hetzelfde is dan verder kijken.\r\n                                // - 1) Als de overige gegevens mstid, klmid en rglid ook hetzelfde zijn dan kan ik ??n\r\n                                //      van deze 2 zondermeer verwijderen: bij voorkeur die met de laagste (oudste) koppelingsid.\r\n                                // - 2) Als deze gegevens NIET hetzelfde zijn dan kijken naar\r\n                                //   2a) Welke hoeveelheid staat er bij de begrotingsregel.\r\n                                //   2b) Bestaat gekoppelde meetstaat 1 met mstid, klmid en rglid\r\n                                //   2c) Bestaat gekoppelde meetstaat 2 met mstid, klmid en rglid\r\n                                //   2d) Komt deze hoeveelheid overeen met de hoeveelheid van de gekoppelde meetstaatcel\r\n                                //   2e) Indien ok dan die met de laagste (oudste) koppelingsid verwijderen.\r\n\r\n                                int bgrRegelNr;\r\n                                if (stuIndex > 0)  // Gevonden?\r\n                                {\r\n                                    bgrRegelNr = stuIndex;\r\n                                }\r\n                                else\r\n                                {\r\n                                    if (controlerenEnRepareren)\r\n                                    {\r\n                                        LogboekMelding(string.Format(ProjectResources.TradA0024127 + BStatics.c_Spatie, msk_2, stuIndex, msk_1._DocumentId));\r\n                                        _MeetstaatKoppelingen.Verwijderen(msk_2);\r\n                                    }\r\n                                    else\r\n                                    {\r\n                                        LogboekMelding(string.Format(ProjectResources.TradA0024127 + BStatics.c_Spatie, msk_2, stuIndex, msk_1._DocumentId));\r\n                                    }\r\n                                    continue;\r\n                                }\r\n\r\n                                if (msk_1._DocumentId == msk_2._DocumentId &&\r\n                                   msk_1._KolomId == msk_2._KolomId &&\r\n                                   msk_1._RegelId == msk_2._RegelId &&\r\n                                   msk_1._MeetstaatId == msk_2._MeetstaatId)\r\n                                {\r\n                                    // 1) Als de overige gegevens mstid, klmid en rglid ook hetzelfde zijn dan kan ik ??n\r\n                                    //    van deze 2 zondermeer verwijderen: bij voorkeur die met de laagste (oudste) koppeling\r\n                                    if (msk_1._KoppelingId > msk_2._KoppelingId)\r\n                                    {\r\n                                        teVerwijderen = mskIndex_2;\r\n                                    }\r\n                                    else\r\n                                    {\r\n                                        teVerwijderen = mskIndex_1;\r\n                                    }\r\n                                }\r\n                                else\r\n                                {\r\n                                    // - 2) Als deze gegevens NIET hetzelfde zijn dan kijken naar\r\n\r\n                                    //   2a) Welke hoeveelheid staat er bij de begrotingsregel.\r\n                                    bool geenWaardeBgr = true;\r\n                                    double hvhBgr = _Stu[bgrRegelNr]._Regel is { } regelBgr\r\n                                        ? regelBgr.GeefDouble(BBegrotingsRegel.EGegeven.hvh, out geenWaardeBgr)\r\n                                        : 0.0;\r\n\r\n                                    //   2b) Bestaat gekoppelde meetstaat 1 met mstid, klmid en rglid\r\n                                    //   2c) Bestaat gekoppelde meetstaat 2 met mstid, klmid en rglid\r\n                                    BMeetstaat? mst_1 = GeefMeetstaat(msk_1._MeetstaatId);\r\n                                    BMeetstaat? mst_2 = GeefMeetstaat(msk_2._MeetstaatId);\r\n\r\n                                    double hvh_1 = 0.0, hvh_2 = 0.0;\r\n                                    bool geenWaarde_1 = false, geenWaarde_2 = false;\r\n                                    if (mst_1 != null)\r\n                                    {\r\n                                        hvh_1 = mst_1.GeefGekoppeldeWaarde(msk_1, out geenWaarde_1);\r\n                                    }\r\n                                    if (mst_2 != null)\r\n                                    {\r\n                                        hvh_2 = mst_2.GeefGekoppeldeWaarde(msk_2, out geenWaarde_2);\r\n                                    }\r\n\r\n                                    // Nu bepalen welke verwijderd moet worden\r\n                                    if (mst_1 == null || geenWaarde_1)\r\n                                    {\r\n                                        // Verwijder deze\r\n                                        teVerwijderen = mskIndex_1;\r\n                                    }\r\n                                    else if (mst_2 == null || geenWaarde_2)\r\n                                    {\r\n                                        // Verwijder deze\r\n                                        teVerwijderen = mskIndex_2;\r\n                                    }\r\n                                    if (teVerwijderen == -1)\r\n                                    {\r\n                                        // Ze bestaan beide: Nu kijken naar de hoeveelheden\r\n                                        //   2d) Komt deze hoeveelheid overeen met de hoeveelheid van de gekoppelde meetstaatcel\r\n                                        bool zelfdeHvh_1 = _statics.GetallenZijnGelijk(hvhBgr, hvh_1, 5);\r\n                                        bool zelfdeHvh_2 = _statics.GetallenZijnGelijk(hvhBgr, hvh_2, 5);\r\n                                        if (!zelfdeHvh_1 && !zelfdeHvh_2)\r\n                                        {\r\n                                            // Verwijder de laagste koppelingid\r\n                                            if (msk_1._KoppelingId > msk_2._KoppelingId)\r\n                                            {\r\n                                                teVerwijderen = mskIndex_2;\r\n                                            }\r\n                                            else\r\n                                            {\r\n                                                teVerwijderen = mskIndex_1;\r\n                                            }\r\n                                        }\r\n                                        else if (zelfdeHvh_1)\r\n                                        {\r\n                                            teVerwijderen = mskIndex_2;\r\n                                        }\r\n                                        else\r\n                                        {\r\n                                            teVerwijderen = mskIndex_1;\r\n                                        }\r\n\r\n                                    }\r\n                                }\r\n                                #endregion Controle welke verwijderd moet worden\r\n\r\n                                _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.MeetstaatKoppelingIntegriteit);\r\n                                if (controlerenEnRepareren)\r\n                                {\r\n                                    int koppelId;\r\n                                    if (teVerwijderen == mskIndex_1)\r\n                                    {\r\n                                        _MeetstaatKoppelingen.Verwijderen(msk_1);\r\n                                        koppelId = msk_2._KoppelingId;\r\n                                    }\r\n                                    else\r\n                                    {\r\n                                        _MeetstaatKoppelingen.Verwijderen(msk_2);\r\n                                        koppelId = msk_1._KoppelingId;\r\n                                    }\r\n\r\n                                    if (_Stu[stuIndex]._Regel != null &&\r\n                                        _Stu[stuIndex]._Regel?._MstKid != koppelId)\r\n                                    {\r\n                                        _Stu[stuIndex]._Regel?._MstKid = koppelId;\r\n                                        _Stu[stuIndex]._Regel?.ZetMutatieStatus(BewaarItemMutatieStatus.Gewijzigd);\r\n                                    }\r\n\r\n                                    LogboekMelding(string.Format(ProjectResources.TradA00241271, mskID, bgrRegelNr));\r\n                                    verwijderd = teVerwijderen;\r\n                                }\r\n                                else\r\n                                {\r\n                                    LogboekMelding(string.Format(ProjectResources.TradA00241272, mskID, bgrRegelNr));\r\n                                }\r\n                            }\r\n                        }\r\n                    }\r\n                    if (controlerenEnRepareren)\r\n                    {\r\n                        if (verwijderd == mskIndex_1) //de volgende koppeling is eentje lager\r\n                            mskIndex_1--;\r\n                        verwijderd = -1;\r\n                    }\r\n                }\r\n\r\n                // stap 2\r\n                // Controleer of er meetstaatkoppelingen zijn die niet in de begroting voorkomen.\r\n\r\n                for (int i = 0; i < _MeetstaatKoppelingen._Aantal; i++)\r\n                {\r\n                    _voortgangsBalk.Perc(i);\r\n                    BMeetstaatKoppeling mstk = _MeetstaatKoppelingen[i];\r\n                    if (ZoekGekoppeldeBegrotingsRegel(mstk) == null && ZoekGekoppeldeBegrotingsbladRegel(mstk) == null)\r\n                    {\r\n                        int koppelingId = mstk._KoppelingId;\r\n                        int regelNr = mstk._RegelNr;\r\n\r\n                        _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.MeetstaatKoppelingIntegriteit);\r\n\r\n                        //verwijder de meetstaat koppeling, als de parameter op direct herstellen staat.\r\n                        if (controlerenEnRepareren)\r\n                        {\r\n                            _MeetstaatKoppelingen.Verwijderen(mstk);\r\n                            i--;\r\n\r\n                            LogboekMelding(string.Format(ProjectResources.TradA00241273, koppelingId, regelNr));\r\n                        }\r\n                        else\r\n                        {\r\n                            LogboekMelding(string.Format(ProjectResources.TradA00241274, koppelingId, regelNr));\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n\r\n            for (stuIndex = 0; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                _voortgangsBalk.Perc(stuIndex);\r\n                if (_Stu[stuIndex]._Tpe == EOnderbouwing.Element ||\r\n                   _Stu[stuIndex]._Tpe == EOnderbouwing.Kostenpost)\r\n                {\r\n                    // stap 3\r\n                    // Controleer of er meetstaatkoppelingen in de begroting voorkomen\r\n                    // die niet in de meetstaatkoppelingen voorkomen\r\n                    IBegrotingsRegel? bgrRegel = _Stu[stuIndex]._Regel as BBegrotingsRegel;\r\n                    if (bgrRegel != null && bgrRegel._MstKid != 0)\r\n                    {\r\n                        BMeetstaatKoppeling? koppeling = ZoekMeetstaatKoppeling(bgrRegel._MstKid);\r\n                        if (null == koppeling)\r\n                        {\r\n                            _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.MeetstaatKoppelingIntegriteit);\r\n                            if (controlerenEnRepareren)\r\n                            {\r\n                                LogboekMelding(string.Format(ProjectResources.TradA00241275, bgrRegel._Id, stuIndex, bgrRegel._MstKid));\r\n                                bgrRegel.MeetstaatKoppeling(null);\r\n                            }\r\n                            else\r\n                            {\r\n                                LogboekMelding(string.Format(ProjectResources.TradA00241276, bgrRegel._Id, stuIndex, bgrRegel._MstKid));\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n\r\n            // stap 4\r\n            // Meetstaten met 0 regels verwijderen\r\n            for (int mstIndex = _Meetstaten.Count - 1; mstIndex > 0; mstIndex--)\r\n            {\r\n                _voortgangsBalk.Perc(mstIndex);\r\n                IMeetstaat meetstaat = _Meetstaten[mstIndex];\r\n                LeesMeetstaat(meetstaat);\r\n                if (meetstaat.AantalRijen() == 0)\r\n                {\r\n                    _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.MeetstaatNulRegels);\r\n                    string msg;\r\n                    if (controlerenEnRepareren)\r\n                    {\r\n                        msg = string.Format(ProjectResources.TradA00241277, meetstaat._Id);\r\n                        _VerwijderdeMeetstaten.Add(meetstaat);\r\n                        _Meetstaten.Remove(meetstaat);\r\n                        //begroting.VerhoogMeetstaatVersie();??? even aan SB vragen\r\n                    }\r\n                    else\r\n                    {\r\n                        msg = string.Format(ProjectResources.TradA00241278, meetstaat._Id);\r\n                    }\r\n                    LogboekMelding(msg);\r\n                }\r\n            }\r\n\r\n            bool ControleNogEenKeer = false;\r\n\r\n            // Stap 5 \r\n            // Controleer of er meetstaatkoppelingen zijn die niet in meetstaten voorkomen\r\n            for (int i = 0; i < _MeetstaatKoppelingen._Aantal; i++)\r\n            {\r\n                _voortgangsBalk.Perc(i);\r\n                BMeetstaatKoppeling mstk = _MeetstaatKoppelingen[i];\r\n\r\n                if (null == GeefMeetstaat(mstk._MeetstaatId))\r\n                {\r\n                    _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.MeetstaatKoppelingIntegriteit);\r\n                    if (controlerenEnRepareren)\r\n                    {\r\n                        _MeetstaatKoppelingen.Verwijderen(mstk);\r\n                        LogboekMelding(string.Format(ProjectResources.TradA00241279, mstk._KoppelingId));\r\n                        ControleNogEenKeer = true;\r\n                    }\r\n                    else\r\n                    {\r\n                        LogboekMelding(string.Format(ProjectResources.TradA002412710, mstk._KoppelingId));\r\n                    }\r\n                }\r\n            }\r\n\r\n            if (ControleNogEenKeer)\r\n                _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Verstoord);\r\n        }\r\n\r\n        private void ControleerMeetstaten_GekoppeldeHvh(int stuIndex, IBegrotingsRegel? begrotingsRegel, int aantalDecimalen)\r\n        {\r\n            if (begrotingsRegel == null) return;\r\n            if (begrotingsRegel._MstKid == 0)\r\n                return;\r\n\r\n            bool controlerenEnRepareren = _structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.ControlerenEnRepareren;\r\n\r\n            BMeetstaat? meetstaat = GeefMeetstaat(begrotingsRegel, out BMeetstaatKoppeling? meetstaatKoppeling);\r\n            if (meetstaatKoppeling == null || meetstaat == null)\r\n            {\r\n                _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.MeetstaatKoppelingIntegriteit);\r\n                if (controlerenEnRepareren)\r\n                {\r\n                    LogboekMelding(string.Format(ProjectResources.TradA00241275, begrotingsRegel._Id, stuIndex, begrotingsRegel._MstKid));\r\n                    begrotingsRegel.MeetstaatKoppeling(null);\r\n                }\r\n                else\r\n                {\r\n                    LogboekMelding(string.Format(ProjectResources.TradA00241276, begrotingsRegel._Id, stuIndex, begrotingsRegel._MstKid));\r\n                }\r\n                return;\r\n            }\r\n\r\n            if (begrotingsRegel._MstKid < 0)\r\n                return;\r\n\r\n            double hvhBgr = begrotingsRegel.GeefDouble(BBegrotingsRegel.EGegeven.hvh, out bool geenWaardeBgr);\r\n            if (geenWaardeBgr)\r\n                return;\r\n\r\n            double hvhMst = meetstaat.GeefGekoppeldeWaarde(meetstaatKoppeling, out bool geenWaardeMst);\r\n            if (geenWaardeMst)\r\n                return;\r\n\r\n            if (_statics.GetallenZijnGelijk(hvhBgr, hvhMst, aantalDecimalen))\r\n                return;\r\n\r\n            _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.MeetstaatKoppelingIntegriteit);\r\n            if (controlerenEnRepareren)\r\n            {\r\n                // Op regel {0} van de begroting is de hoeveelheid ({1:0.#####}) gelijkgemaakt aan de gekoppelde waarde in de meetstaat ({2:0.#####})\r\n                LogboekMelding(begrotingsRegel, string.Format(ProjectResources.TradBgrHvhNuGelijkAanMstHvh, stuIndex, hvhBgr, hvhMst));\r\n                begrotingsRegel.WijzigDouble(BBegrotingsRegel.EGegeven.hvh, hvhMst);\r\n                begrotingsRegel.MeetstaatKoppeling(meetstaatKoppeling);\r\n            }\r\n            else\r\n            {\r\n                // Op regel {0} van de begroting komt de hoeveelheid ({1:0.#####}) niet overeen met de gekoppelde waarde in de meetstaat ({2:0.#####})\r\n                LogboekMelding(begrotingsRegel, string.Format(ProjectResources.TradBgrHvhOngelijkMstHvh, stuIndex, hvhBgr, hvhMst));\r\n            }\r\n        }\r\n\r\n        private void ControleerModellen()\r\n        {\r\n            LogboekMelding(ProjectResources.TradA002412711);\r\n\r\n            for (int modelIndex = 0; modelIndex < m_MeetstaatModelVzl?.Aantal(); modelIndex++)\r\n            {\r\n                IMeetstaatModel model = m_MeetstaatModelVzl.GeefMeetstaatModel(modelIndex);\r\n                string orgNaam = model._Naam;\r\n                if (!m_MeetstaatModelVzl.ControleerUniekeNaam(model))\r\n                {\r\n                    string melding;\r\n                    // Dubbel code gevonden. Model is hernoemd naar een nieuwe unieke naam\r\n                    if (_structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.ControlerenEnRepareren)\r\n                    {\r\n                        melding = string.Format(ProjectResources.TradA002412712, orgNaam, model._Naam);\r\n                    }\r\n                    else\r\n                    {\r\n                        melding = string.Format(ProjectResources.TradA002412713, orgNaam);\r\n                    }\r\n                    _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.ModelnaamDubbel);\r\n                    LogboekMelding(melding);\r\n                }\r\n            }\r\n        }\r\n\r\n        public struct MstKoppelingId\r\n        {\r\n            public BMeetstaatKoppeling mst;\r\n            public int regId;\r\n\r\n\r\n            public MstKoppelingId(BMeetstaatKoppeling mstkopp, int documentId)\r\n            {\r\n                mst = mstkopp;\r\n                regId = documentId;\r\n            }\r\n        }\r\n\r\n        private int ControleerMiddelen()\r\n        {\r\n            if (!_structuurStatusFout.Uitvoeren(EBegrotingControleStap.Middelen))\r\n                return 0;\r\n\r\n            LogboekMelding(ProjectResources.TradA002412714);\r\n\r\n            int gewijzigd = 0;\r\n            _voortgangsBalk.ZetAantalenMsg(0, _Stu._Aantal, ProjectResources.TradA002412715, false, 0);\r\n            EControleerBegrotingStatus controleerBegrotingStatus = _structuurStatusFout.ControleerBegrotingStatus;\r\n\r\n            for (int stuIndex = 0; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                _voortgangsBalk.Perc(stuIndex);\r\n                if (_Stu[stuIndex]._Tpe == EOnderbouwing.Kostenpost)\r\n                {\r\n                    _Stu.LeesBegrotingsRegel(stuIndex);\r\n                    int kostenpostId = _Stu[stuIndex]._Id;\r\n                    var kostenpost = _Stu[stuIndex]._Regel as BKostenpost;\r\n                    if (kostenpost == null)\r\n                    {\r\n                        if (controleerBegrotingStatus == EControleerBegrotingStatus.ControlerenEnRepareren)\r\n                        {\r\n                            kostenpost = MaakNieuweKostenpost(stuIndex) as BKostenpost;  //logboek message staat in MaakNieuweKostenpost()\r\n                            kostenpostId = kostenpost?._Id ?? _Stu[stuIndex]._Id;\r\n                            _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Kostenpost);\r\n                        }\r\n                        else\r\n                        {\r\n                            LogboekMelding(string.Format(ProjectResources.TradA002412716, _Stu[stuIndex]._Id, stuIndex));\r\n                        }\r\n                    }\r\n\r\n                    if (kostenpost?._Middel == null)\r\n                    {\r\n                        if (controleerBegrotingStatus == EControleerBegrotingStatus.Controleren)\r\n                        {\r\n                            // Zie andere logboekmelding bij s_DirektHerstellen in de functie:BMiddel GeefMiddel(int midId, int ktpId) \r\n                            LogboekMelding(string.Format(ProjectResources.TradA002412717, kostenpostId, stuIndex));\r\n                        }\r\n                        else\r\n                        {\r\n                            MaakOntbrekendMiddel(kostenpost);\r\n                        }\r\n                        _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Middel);\r\n                    }\r\n                }\r\n            }\r\n            return gewijzigd;\r\n        }\r\n\r\n        private void ControleerParents()\r\n        {\r\n            if (!_structuurStatusFout.Uitvoeren(EBegrotingControleStap.Parents))\r\n                return;\r\n\r\n            LogboekMelding(ProjectResources.TradA002412718);\r\n            _voortgangsBalk.ZetAantalenMsg(0, _Stu._Aantal, ProjectResources.TradA002412719, false, 0);\r\n\r\n            for (int stuIndex = 0; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                try\r\n                {\r\n                    _voortgangsBalk.Perc(stuIndex);\r\n                    _Stu.LeesBegrotingsRegel(stuIndex);\r\n                    if (_Stu[stuIndex]._Regel == null)\r\n                        _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Verstoord);\r\n                }\r\n                catch (Exception ex)\r\n                {\r\n                    _logger.LogExceptionWithMessage(ex);\r\n\r\n                    // Fouten in dit stadium niet van belang, deze controle vindt later plaats\r\n                    _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Verstoord);\r\n                    return;\r\n                }\r\n\r\n                int parentid = _Stu[stuIndex]._PrtId;\r\n                if (parentid != 0)\r\n                {\r\n                    int zoekIndex = _Stu.ZoekElement(parentid, stuIndex);\r\n                    if (zoekIndex < 0 || zoekIndex >= stuIndex)\r\n                    {\r\n                        if (_structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.Controleren)\r\n                            LogboekMelding(string.Format(ProjectResources.TradA002412720,\r\n                               _Stu[stuIndex]._Id, stuIndex, parentid));\r\n\r\n                        _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.VerkeerdParentId);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        private void ControleerParentType()\r\n        {\r\n            LogboekMelding(ProjectResources.TradA002412721);\r\n            _voortgangsBalk.ZetAantalenMsg(0, _Stu._Aantal, ProjectResources.TradA002412722, false, 0);\r\n\r\n            for (int stuIndex = 0; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                _voortgangsBalk.Perc(stuIndex);\r\n\r\n                int parentid = _Stu[stuIndex]._PrtId;\r\n\r\n                if (parentid != 0 && _Stu.ZoekElement(parentid, stuIndex) < 0)\r\n                {\r\n                    int zoekindex;\r\n                    if (_Stu.ZoekId(parentid, out zoekindex) &&\r\n                       _Stu[zoekindex]._Tpe != EOnderbouwing.Element)\r\n                    {\r\n                        LogboekMelding(string.Format(ProjectResources.TradA002412723,\r\n                           _Stu[stuIndex]._Id, stuIndex, parentid, zoekindex));\r\n                        _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.ParentGeenElement);\r\n                    }\r\n                    else\r\n                    {\r\n                        LogboekMelding(string.Format(ProjectResources.TradA002412724,\r\n                           _Stu[stuIndex]._Id, stuIndex, parentid));\r\n                        _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Parent);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        public bool ControleerBgrDubbeleMsk()\r\n        {\r\n            if (_MeetstaatKoppelingen._Aantal == 0)\r\n                return false;\r\n\r\n            int mskDocumentId_1, mskDocumentId_2;\r\n            int stuIndex;\r\n\r\n            for (int mskIndex_1 = _MeetstaatKoppelingen._Aantal - 1; mskIndex_1 >= 0; mskIndex_1--)\r\n            {\r\n                mskDocumentId_1 = _MeetstaatKoppelingen[mskIndex_1]._DocumentId;\r\n                if (mskDocumentId_1 <= 0)\r\n                    continue;\r\n\r\n                stuIndex = _Stu.ZoekId(mskDocumentId_1);\r\n                if (stuIndex <= 0)\r\n                    continue;\r\n\r\n                for (int mskIndex_2 = mskIndex_1 - 1; mskIndex_2 >= 0; mskIndex_2--)\r\n                {\r\n                    mskDocumentId_2 = _MeetstaatKoppelingen[mskIndex_2]._DocumentId;\r\n\r\n                    if (mskDocumentId_1 == mskDocumentId_2)\r\n                        return true;\r\n                }\r\n            }\r\n\r\n            return false;\r\n        }\r\n\r\n        public BBegrotingsRegel.EBegrotingConsistentieStatus ControleerBgrRegelMeetstaatkoppeling()\r\n        {\r\n            BMeetstaatKoppeling msk;\r\n            int stuIndex;\r\n            IBegrotingsRegel? begrotingsRegel;\r\n            double hvhBgr;\r\n\r\n            for (int mskIndex = _MeetstaatKoppelingen._Aantal - 1; mskIndex >= 0; mskIndex--)\r\n            {\r\n                msk = _MeetstaatKoppelingen[mskIndex];\r\n                if (msk._DocumentId <= 0)\r\n                    continue;\r\n\r\n                stuIndex = _Stu.ZoekId(msk._DocumentId);\r\n                if (stuIndex <= 0)\r\n                    return BBegrotingsRegel.EBegrotingConsistentieStatus.LozeMsk;\r\n\r\n                _Stu.LeesBegrotingsRegel(stuIndex);\r\n                begrotingsRegel = _Stu[stuIndex]._Regel;\r\n                if (begrotingsRegel?._MstKid != msk._KoppelingId)\r\n                {\r\n                    if (begrotingsRegel?._MstKid == -msk._KoppelingId)\r\n                        continue;\r\n\r\n                    return BBegrotingsRegel.EBegrotingConsistentieStatus.BgrMstKid;\r\n                }\r\n\r\n                BMeetstaat? meetstaat = GeefMeetstaat(begrotingsRegel, out BMeetstaatKoppeling? meetstaatKoppeling);\r\n                if (meetstaatKoppeling == null || meetstaat == null)\r\n                    return BBegrotingsRegel.EBegrotingConsistentieStatus.GeenMst;\r\n\r\n                hvhBgr = begrotingsRegel.GeefDouble(BBegrotingsRegel.EGegeven.hvh, out bool geenWaardeBgr);\r\n                if (geenWaardeBgr)\r\n                    continue;\r\n\r\n                double hvhMst = meetstaat.GeefGekoppeldeWaarde(meetstaatKoppeling, out bool geenWaardeMst);\r\n                if (geenWaardeMst)\r\n                    continue;\r\n\r\n                if (!_statics.GetallenZijnGelijk(hvhBgr, hvhMst, 3))\r\n                    return BBegrotingsRegel.EBegrotingConsistentieStatus.BgrHvh;\r\n            }\r\n\r\n            return BBegrotingsRegel.EBegrotingConsistentieStatus.Ok;\r\n        }\r\n\r\n        public void ControleerStructuur(EBegrotingControleStap begrotingControleStappen)\r\n        {\r\n            LogboekMelding(ProjectResources.TradA002412725);\r\n\r\n            // Run 1 Controleer _MaxId\r\n            // Run 2 Alle regel die geen juiste parent hebben\r\n            // Run 4 Alle kostenposten/commentaar die ook als elem/comm voorkomen\r\n            // Run 3 Ontbrekende middelen\r\n            // Run 5 Alle elementen die ook als element voorkomen\r\n            // Run 6 Alle regels die een parent id hebben welke geen element is\r\n            // Run 7 Alle regels op hierarchie\r\n            // Run 8 Alle regels op meetstaat\r\n            try\r\n            {\r\n                _structuurStatusFout.BegrotingControleStappen = begrotingControleStappen;\r\n\r\n                _Stu.GeefNiveau(0);\r\n                _logboek.Toevoegen(_Naam, ProjectResources.TradA002412726);//i.v.m multiple gebruik functie\r\n                _Stu.ControleerLosseNietElementen(this); //LosseKtpMidden = 512,\r\n\r\n                //ControleerMaxId();         //  1 Run 1 Controleer _MaxId\r\n                ControleerParents();       //  2 Run 2 Alle regel die geen juiste parent hebben\r\n                ControleerKpComId();       //  4 Run 4 Alle kostenposten/commentaar die ook als elem/comm voorkomen\r\n                ControleerMiddelen();      //  8 Run 3 Ontbrekende middelen\r\n                ControleerElement();       // 16 Run 5 Alle elementen die ook als element voorkomen\r\n\r\n                if (_structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.Controleren)\r\n                {\r\n                    ControleerParentType();    // 32 Run 6 Alle regels die een parent id hebben welke geen element is\r\n                    ControleerHierarchie();    // 64 Run 7 Alle regels op hierarchie\r\n                }\r\n                ControleerMeetstaten();    //128 Run 8 Alle regels op meetstaatkoppeling\r\n                ControleerModellen();      // Controleer op dubbele modelnamen                 \r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                _logger.LogExceptionWithMessage(ex);\r\n                _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Verstoord);\r\n            }\r\n        }\r\n\r\n        private IBegrotingsRegel? MaakNieuwCommentaar(int stuIndex)\r\n        {\r\n            BStructuurRegel sturgl = _Stu[stuIndex];\r\n            int nieuwid = GeefNieuwId();\r\n            var sturegelnieuw = new BStructuurRegel(EOnderbouwing.Commentaar, sturgl._PrtId);\r\n\r\n            if (sturgl._Regel == null)\r\n            {\r\n                sturegelnieuw.SetRegel(new BCommentaar(nieuwid, string.Empty, BStatics.c_Bedrijf, 0, string.Empty, string.Empty));\r\n            }\r\n            else\r\n            {\r\n                sturegelnieuw.SetRegel(new BCommentaar(nieuwid, (BCommentaar)sturgl._Regel));\r\n                _Stu.VerwijderdeStructuurRegelToevoegen(sturgl);\r\n            }\r\n\r\n            sturegelnieuw._Regel?.Begroting = this;\r\n            sturegelnieuw._Regel?.ZetMutatieStatus(BewaarItemMutatieStatus.Nieuw);\r\n            sturegelnieuw._Niveau = sturgl._Niveau;\r\n            _Stu.Vervangen(sturegelnieuw, stuIndex);\r\n\r\n            return sturegelnieuw._Regel;\r\n        }\r\n\r\n        private IBegrotingsRegel? MaakNieuwElement(int stuIndex)\r\n        {\r\n            BStructuurRegel sturgl = _Stu[stuIndex];\r\n            int oudid = sturgl._Id;\r\n            int oudniv = sturgl._Niveau;\r\n\r\n            int nieuwid = GeefNieuwId();\r\n            BElement element = sturgl._Regel == null\r\n                ? new BElement(nieuwid, _VltId, this) { _Oms = BStatics.c_Bedrijf }\r\n                : new BElement(nieuwid, (BElement)sturgl._Regel, null) { Begroting = this };\r\n            var sturegelnieuw = new BStructuurRegel(element, sturgl._PrtId);\r\n\r\n            sturegelnieuw._Niveau = sturgl._Niveau;\r\n            sturegelnieuw._Regel?.ZetMutatieStatus(BewaarItemMutatieStatus.Nieuw);\r\n\r\n            _Stu.VerwijderdeStructuurRegelToevoegen(sturgl);\r\n            _Stu.Vervangen(sturegelnieuw, stuIndex);\r\n            WijzigKinderen(stuIndex, oudid, nieuwid, oudniv);\r\n\r\n            return sturegelnieuw._Regel;\r\n        }\r\n\r\n        public BKostenpost MaakOntbrekendekostenpostMetBestaandMiddel(int structuurregelId)\r\n        {\r\n            return MaakOntbrekendeKostenpostZonderMiddel(structuurregelId);\r\n        }\r\n\r\n        private IBegrotingsRegel? MaakNieuweKostenpost(int stuIndex)\r\n        {\r\n            BStructuurRegel sturgl = _Stu[stuIndex];\r\n            int nieuwid = GeefNieuwId();\r\n            BKostenpost kostenpost = MaakOntbrekendeKostenpost(nieuwid);\r\n            var sturegelnieuw = new BStructuurRegel(kostenpost, sturgl._PrtId);\r\n            sturegelnieuw._Regel?.Begroting = this;\r\n            sturegelnieuw._Regel?.ZetMutatieStatus(BewaarItemMutatieStatus.Nieuw);\r\n            sturegelnieuw._Niveau = sturgl._Niveau;\r\n            if (_structuurStatusFout.ControleerBegrotingStatus == EControleerBegrotingStatus.ControlerenEnRepareren)\r\n            {\r\n                LogboekMelding(string.Format(ProjectResources.TradA0024127261, sturgl._Id, sturegelnieuw._Id));\r\n                _structuurStatusFout.VoegStatusToe(EStructuurStatusFout.Kostenpost);\r\n\r\n            }\r\n            _Stu.Vervangen(sturegelnieuw, stuIndex);\r\n\r\n            return sturegelnieuw._Regel;\r\n        }\r\n\r\n        private void WijzigKinderen(int vanElementIndex, int oudeID, int nieuweID, int vanniveau)\r\n        {\r\n            for (int stuIndex = vanElementIndex + 1; stuIndex < _Stu._Aantal; stuIndex++)\r\n            {\r\n                if (_Stu[stuIndex]._Niveau <= vanniveau)\r\n                    break;\r\n\r\n                if (_Stu[stuIndex]._PrtId == oudeID)\r\n                {\r\n                    BStructuurRegel stuRegel = new BStructuurRegel(_Stu[stuIndex]._Regel, nieuweID);\r\n                    stuRegel._Niveau = _Stu[stuIndex]._Niveau;\r\n                    _Stu.Vervangen(stuRegel, stuIndex);\r\n                }\r\n            }\r\n        }\r\n\r\n        private BKostenpost MaakOntbrekendeKostenpost(int nieuwkpid)\r\n        {\r\n            BKostenpost kostenpost = new BKostenpost(nieuwkpid, string.Empty, _VltId, this);\r\n            MaakOntbrekendMiddel(kostenpost);\r\n            return kostenpost;\r\n        }\r\n        public BKostenpost MaakOntbrekendeKostenpostZonderMiddel(int nieuwkpid)\r\n        {\r\n            BKostenpost kostenpost = new BKostenpost(nieuwkpid, string.Empty, _VltId, this);\r\n            return kostenpost;\r\n        }\r\n        public BMiddel? MaakOntbrekendeMiddelAanDeHandVanDeKostenPost(BKostenpost? kostenpost)\r\n        {\r\n            BMiddel? middel = null;\r\n            if (kostenpost != null)\r\n            {\r\n                middel = new BMiddel(GeefNieuwId(), _VltId);\r\n                middel._Oms = BStatics.c_Bedrijf;   //NIETVERTALEN\r\n                kostenpost.WijzigMiddel(middel, false);\r\n                _Mid.MiddelToevoegen(middel);\r\n            }\r\n            return middel;\r\n        }\r\n\r\n        private void MaakOntbrekendMiddel(BKostenpost? kostenpost)\r\n        {\r\n            if (kostenpost != null)\r\n            {\r\n                BMiddel middel = new BMiddel(GeefNieuwId(), _VltId);\r\n                middel._Oms = BStatics.c_Bedrijf;  //NIETVERTALEN\r\n                kostenpost.WijzigMiddel(middel, false);\r\n                _Mid.MiddelToevoegen(middel);\r\n            }\r\n        }\r\n\r\n        #endregion // Herindexeren bestand\r\n\r\n        #region Links wijzigen\r\n        /// <summary>\r\n        /// Wijzig de URL's in de begroting\r\n        /// </summary>\r\n        /// <param name=\"oudeWaarde\">Zoektekst of -tekstfragment</param>\r\n        /// <param name=\"nieuweWaarde\">Vervangende tekst</param>\r\n        /// <param name=\"controleVraag\">Vraag de gebruiker om toestemming per vervanging</param>\r\n        /// <returns>Aantal gewijzigde URL's</returns>\r\n        public int WijzigLinks(string oudeWaarde, string nieuweWaarde, WijzigenControlevraagDlgte? controleVraag)\r\n        {\r\n            int gewijzigd = 0;\r\n\r\n            string zoekTekst = oudeWaarde.ToLower();\r\n            int aantal = _Stu._Aantal;\r\n            int pos;\r\n            bool stoppen = false;\r\n            string url;\r\n            StringBuilder nieuweUrl = new StringBuilder();\r\n            for (int stuIndex = 1; stuIndex < aantal; stuIndex++)\r\n            {\r\n                BStructuurRegel stuRegel = _Stu[stuIndex];\r\n                if (stuRegel._Tpe == EOnderbouwing.Element && stuRegel._Regel is BElement elt)\r\n                {\r\n                    url = elt._Url ?? string.Empty;\r\n                    if (url.Length != 0)\r\n                    {\r\n                        pos = url.ToLower().IndexOf(zoekTekst);\r\n                        if (pos >= 0)\r\n                        {\r\n                            nieuweUrl = new StringBuilder(nieuweWaarde);\r\n                            if (pos > 0)\r\n                                nieuweUrl = new StringBuilder(url.Substring(0, pos) + nieuweUrl);\r\n                            pos += zoekTekst.Length;\r\n                            if (pos < url.Length)\r\n                                nieuweUrl.Append(url.Substring(pos));\r\n                            if (controleVraag != null && !controleVraag(url, nieuweUrl.ToString(), out stoppen))\r\n                            {\r\n                                if (stoppen)\r\n                                    break;\r\n                                continue;\r\n                            }\r\n                            elt._Url = nieuweUrl.ToString();\r\n                            gewijzigd++;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n            if (!stoppen)\r\n            {\r\n                foreach (BMiddel middel in _Mid._Lijst)\r\n                {\r\n                    url = middel._Url;\r\n                    if (url.Length != 0)\r\n                    {\r\n                        pos = url.ToLower().IndexOf(zoekTekst);\r\n                        if (pos >= 0)\r\n                        {\r\n                            nieuweUrl = new StringBuilder(nieuweWaarde);\r\n                            if (pos > 0)\r\n                                nieuweUrl = new StringBuilder(url.Substring(0, pos) + nieuweUrl);\r\n                            pos += zoekTekst.Length;\r\n                            if (pos < url.Length)\r\n                                nieuweUrl.Append(url.Substring(pos));\r\n                            if (controleVraag != null && !controleVraag(url, nieuweUrl.ToString(), out stoppen))\r\n                            {\r\n                                if (stoppen)\r\n                                    break;\r\n                                continue;\r\n                            }\r\n                            middel._Url = nieuweUrl.ToString();\r\n                            gewijzigd++;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n            if (gewijzigd != 0)\r\n                _OpdrachtVzl.Gewijzigd();\r\n            return gewijzigd;\r\n        }\r\n        #endregion // Links wijzigen\r\n\r\n        #region Prijzenboek\r\n        public IBegroting? _PrijzenBoek { get; private set; }\r\n        public void ZetPrijzenBoek(IBegroting? prijzenBoek, string volledigeNaam)\r\n        {\r\n            _PrijzenBoek = prijzenBoek;\r\n            _PrijzenBoekNaam = (_PrijzenBoek == null) ? string.Empty : volledigeNaam;\r\n        }\r\n        #endregion Prijzenboek\r\n\r\n        #region Leverancier Prijzenboek\r\n        private bool _disposedValue;\r\n\r\n        public IBegroting? _LevPrijzenBoek { get; private set; }\r\n        public void ZetLevPrijzenBoek(IBegroting? levPrijzenBoek, string volledigeNaam)\r\n        {\r\n            _LevPrijzenBoek = levPrijzenBoek;\r\n            _LevPrijzenBoekNaam = (_LevPrijzenBoek == null) ? string.Empty : volledigeNaam;\r\n        }\r\n        #endregion Leverancier Prijzenboek\r\n        /// <summary>\r\n        /// Het verwijderen van de vastprijs-indicaties van alle elementen in de begroting.\r\n        /// </summary>\r\n        public void VerwijderenVastPrijsIndicatie()\r\n        {\r\n            // De elementen met vastprijs-indicatie ophalen uit de begroting.\r\n            IList<IBegrotingsRegel> elementen = _Stu.GeefBgrRegels((int)EOnderbouwing.Element);\r\n            List<IBegrotingsRegel> vastprijsElementen = elementen.Where(item => ((BElement)item)._VastPrijs).ToList();\r\n\r\n            // Vastprijs-indicatie van het element afhalen, zodat die automatisch wordt doorgerekend.\r\n            foreach (IElement element in vastprijsElementen.Cast<IElement>())\r\n            {\r\n                element._VastPrijs = false;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// Het bepalen of de begroting vaste hoeveelheden heeft.\r\n        /// </summary>\r\n        public bool BgrHeeftVasteHoeveelheden()\r\n        {\r\n            bool vasteHoeveelhedenAanwezig = false;\r\n\r\n            // Traditionle begrotingen kennen geen vaste hoeveelheden.\r\n            if (_Tpe != EBgrTpe.Traditioneel)\r\n            {\r\n                // De elementen met vaste hoeveelheden ophalen uit de begroting.\r\n                IList<IBegrotingsRegel> elementen = _Stu.GeefBgrRegels((int)EOnderbouwing.Element);\r\n                vasteHoeveelhedenAanwezig = elementen.Where(item => ((BElement)item)._Dri == EDri.Vst).Any();\r\n\r\n                // Als er geen elementen zijn, kunner er nog kostenposten met vaste hoeveelheden zijn.\r\n                if (!vasteHoeveelhedenAanwezig)\r\n                {\r\n                    // De kostenposten met vaste hoeveelheden ophalen uit de begroting.\r\n                    IList<IBegrotingsRegel> kostenposten = _Stu.GeefBgrRegels((int)EOnderbouwing.Kostenpost);\r\n                    vasteHoeveelhedenAanwezig = kostenposten.Where(item => ((BKostenpost)item)._Dri == EDri.Vst).Any();\r\n                }\r\n            }\r\n            return vasteHoeveelhedenAanwezig;\r\n        }\r\n\r\n        public bool BgrHeeftOpslagposten(int controle)\r\n        {\r\n            // Controle:\r\n            //  0: zijn er opslagposten in de begroting?\r\n            //  1: zijn er opslagposten in de begroting van type elementtussentotaal?\r\n            //  2: zijn er opslagposten in de begroting met een opslag per kostensoort?\r\n\r\n            int stuIndex = -1;\r\n            BOpslagpost? regel = _Stu.GeefVolgendeBgrRegel(EOnderbouwing.Opslagpost, ref stuIndex) as BOpslagpost;\r\n            while (regel != null)\r\n            {\r\n                switch (controle)\r\n                {\r\n                    case 0:\r\n                        return true;\r\n\r\n                    case 1:\r\n                        if (regel._IsElementTussentotaal)\r\n                            return true;\r\n                        break;\r\n\r\n                    case 2:\r\n                        if (!regel._IsNormaleOpslag && !regel._IsSubtotaalOpslag)\r\n                            break;\r\n                        if (!_statics.IsNul(regel._PctArb)\r\n                            || !_statics.IsNul(regel._PctMta)\r\n                            || !_statics.IsNul(regel._PctMte)\r\n                            || !_statics.IsNul(regel._PctOda))\r\n                            return true;\r\n                        break;\r\n                }\r\n                regel = _Stu.GeefVolgendeBgrRegel(EOnderbouwing.Opslagpost, ref stuIndex) as BOpslagpost;\r\n            }\r\n\r\n            return false;\r\n        }\r\n        public bool KlantkortingspercentageToegepast()\r\n        {\r\n            foreach (BMiddel middel in _Mid)\r\n            {\r\n                if (middel._KltKortingPercentage > 0)\r\n                    return true;\r\n            }\r\n            return false;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Bepalen of er Btw Geen gebruikt wordt in de begroting.\r\n        /// </summary>\r\n        /// <returns></returns>\r\n        public bool BgrHeeftBtwGeen()\r\n        {\r\n            bool btwGeenAanwezig = false;\r\n\r\n            if (_BtwToepassen)\r\n            {\r\n\r\n                // De kostenposten met btw geen ophalen uit de begroting.\r\n                IList<IBegrotingsRegel> kostenposten = _Stu.GeefBgrRegels((int)EOnderbouwing.Kostenpost);\r\n                btwGeenAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwArbeid == \"\").Any();//NIETVERTALEN\r\n\r\n                if (!btwGeenAanwezig)\r\n                {\r\n                    btwGeenAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwMateriaal == \"\").Any();//NIETVERTALEN\r\n                }\r\n\r\n                if (!btwGeenAanwezig)\r\n                {\r\n                    btwGeenAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwMaterieel == \"\").Any();//NIETVERTALEN\r\n                }\r\n\r\n                if (!btwGeenAanwezig)\r\n                {\r\n                    btwGeenAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwOnderaann == \"\").Any();//NIETVERTALEN\r\n                }\r\n\r\n            }\r\n\r\n            return btwGeenAanwezig;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Bepalen of er btw hoog gebruikt wordt in de begroting.\r\n        /// </summary>\r\n        /// <returns></returns>\r\n        public bool BgrHeeftBtwHoog()\r\n        {\r\n            bool btwHoogAanwezig = false;\r\n\r\n            if (_BtwToepassen)\r\n            {\r\n\r\n                // De kostenposten met btw hoog ophalen uit de begroting.\r\n                IList<IBegrotingsRegel> kostenposten = _Stu.GeefBgrRegels((int)EOnderbouwing.Kostenpost);\r\n                btwHoogAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwArbeid == \"H\").Any();//NIETVERTALEN\r\n\r\n                if (!btwHoogAanwezig)\r\n                {\r\n                    btwHoogAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwMateriaal == \"H\").Any();//NIETVERTALEN\r\n                }\r\n\r\n                if (!btwHoogAanwezig)\r\n                {\r\n                    btwHoogAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwMateriaal == \"H\").Any();//NIETVERTALEN\r\n                }\r\n\r\n                if (!btwHoogAanwezig)\r\n                {\r\n                    btwHoogAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwMateriaal == \"H\").Any();//NIETVERTALEN\r\n                }\r\n\r\n            }\r\n\r\n            return btwHoogAanwezig;\r\n        }\r\n\r\n        /// <summary>\r\n        /// Bepalen of er btw laag gebruikt wordt in de begroting.\r\n        /// </summary>\r\n        /// <returns></returns>\r\n        public bool BgrHeeftBtwLaag()\r\n        {\r\n            bool btwLaagAanwezig = false;\r\n\r\n            if (_BtwToepassen)\r\n            {\r\n\r\n                // De kostenposten met btw laag ophalen uit de begroting.\r\n                IList<IBegrotingsRegel> kostenposten = _Stu.GeefBgrRegels((int)EOnderbouwing.Kostenpost);\r\n                btwLaagAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwArbeid == \"L\").Any();//NIETVERTALEN\r\n\r\n                if (!btwLaagAanwezig)\r\n                {\r\n                    btwLaagAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwMateriaal == \"L\").Any();//NIETVERTALEN\r\n                }\r\n\r\n                if (!btwLaagAanwezig)\r\n                {\r\n                    btwLaagAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwMateriaal == \"L\").Any();//NIETVERTALEN\r\n                }\r\n\r\n                if (!btwLaagAanwezig)\r\n                {\r\n                    btwLaagAanwezig = kostenposten.Where(item => ((BKostenpost)item)._BtwMateriaal == \"L\").Any();//NIETVERTALEN\r\n                }\r\n\r\n            }\r\n\r\n            return btwLaagAanwezig;\r\n        }\r\n\r\n        public void ValutaGewijzigd(BDocValuta valuta)\r\n        {\r\n            m_BasisValuta = valuta;\r\n        }\r\n\r\n        public void ValutaOpschonen()\r\n        {\r\n            for (int index = BegrotingsValuta.Count - 1; index >= 0; index--)\r\n            {\r\n                BDocValuta? valuta = BegrotingsValuta[index] as BDocValuta;\r\n                if (valuta != null && !IsValutaInGebruik(valuta._VltId))\r\n                    BegrotingsValuta.RemoveAt(index);\r\n            }\r\n        }\r\n\r\n        /// <summary>Controleer of de uurlooncode langer is dan 2 posities\r\n        /// </summary>\r\n        /// <param name=\"maxLengte\"></param>\r\n        /// <returns>true indien alle uurlooncodes voldoen, anders false</returns>\r\n        public bool ControleerUurloonCodeLengte(int maxLengte)\r\n        {\r\n            bool lengteVoldoet = true;\r\n            for (int index = 0; index < _REl._Uln._Vzl.Count; index++)\r\n            {\r\n                BUurloonC uurloon = _REl._Uln._Vzl[index];\r\n                if (uurloon._UlnCde.Trim().Length > maxLengte)\r\n                {\r\n                    lengteVoldoet = false;\r\n                    break;\r\n                }\r\n            }\r\n            return lengteVoldoet;\r\n        }\r\n\r\n        /// <summary>Filter een begroting op bestaande regels in een andere begroting op basis van een code\r\n        /// <para>Voorlopig alleen op calculatie code mogelijk</para>\r\n        /// <para>NB Dit werkt dus niet met lege codes</para>\r\n        /// </summary>\r\n        /// <param name=\"doelBegroting\">De begroting waarvan getest wordt of de code daar al in voorkomt</param>\r\n        /// <param name=\"inclusiefBovenBouw\"></param>\r\n        /// <param name=\"inclusiefOnderbouwing\"></param>\r\n        /// <param name=\"stuIndexDoel\">Een nieuwe locatie waar het 'ovegebleven\" deel van deze begroting geplakt kan worden</param>\r\n        /// <returns>true indien er regels uitgefilter zijn, anders false</returns>\r\n        public bool KbFilterClassificatieRegels(IBegroting doelBegroting, IList<IKostenbestandRaadplegenItem> brinkKbRegels, ref int stuIndexDoel)\r\n        {\r\n            int stuIndex = 1; // NB lijst heeft geen root element m_Stu wel >> stuIndex begint met 1\r\n            int niveau = 1;\r\n            int zoekVanafIndex = 0;\r\n            bool regelsGefilterd = false, heeftLegeClassificatieCodes = false;\r\n\r\n            foreach (object item in brinkKbRegels)\r\n            {\r\n                BKlasse? itemCla = item as BKlasse;\r\n                if (itemCla != null && string.IsNullOrEmpty(itemCla.code))\r\n                {\r\n                    heeftLegeClassificatieCodes = true;\r\n                    break;\r\n                }\r\n            }\r\n\r\n            // Als er lege classificatie codes gevonden worden dan werkt het hele mechanisme \r\n            // van classificatie codes opzoeken niet meer en valt het hele systeem om\r\n            if (heeftLegeClassificatieCodes)\r\n                return false;\r\n\r\n            foreach (object item in brinkKbRegels)\r\n            {\r\n                BKlasse? itemCla = item as BKlasse;\r\n                if (itemCla != null && !string.IsNullOrEmpty(itemCla.code))\r\n                {\r\n                    int gevondenIndex = doelBegroting.ZoekElementCodeVanNiveau(itemCla.code, zoekVanafIndex, niveau);\r\n                    if (gevondenIndex > 0)\r\n                    {\r\n                        _Stu[stuIndex]._Niveau = -_Stu[stuIndex]._Niveau;\r\n                        stuIndexDoel = zoekVanafIndex = gevondenIndex;\r\n                        regelsGefilterd = true;\r\n                    }\r\n                    niveau++;\r\n                }\r\n                stuIndex++;\r\n            }\r\n\r\n            return regelsGefilterd;\r\n        }\r\n        /// <summary>Bepaal de invoeglocatie voor een aantak kbRegels.\r\n        /// <para>Hierbij wordt de instelling voor Element en Activiteit niveau gevolgd</para>\r\n        /// <para>NB Dit is alleen van toepassing op kbRegel verzamelingen zonder bovenbouw (classificaties)\r\n        /// Zodra die regels in de verzameling aanwezig zijn wordt de hierarchie van de classificaties gevolgd</para>\r\n        /// </summary>\r\n        /// <param name=\"huidigeStuIndex\"></param>\r\n        /// <param name=\"kbRegels\"></param>\r\n        /// <returns></returns>\r\n        public int KbBepaalInvoegLocatie(int huidigeStuIndex, IList<IKostenbestandRaadplegenItem> kbRegels)\r\n        {\r\n            int stuIndex = huidigeStuIndex;\r\n            int invoegNiveau = 0;\r\n\r\n            BBrinkKostenbestandEigenschappen kbEigenschappen = new BBrinkKostenbestandEigenschappen(_KostenbestandEigenschappenNieuwbouw);\r\n            IKostenbestandRaadplegenItem? firstElement = kbRegels.FirstOrDefault();\r\n            if (firstElement is Data.Kostenbestand.Models.BElement)\r\n            {\r\n                invoegNiveau = kbEigenschappen._ElementenNiveau;\r\n            }\r\n            else if (firstElement is Data.Kostenbestand.Models.BActiviteit)\r\n            {\r\n                invoegNiveau = kbEigenschappen._ActiviteitenNiveau;\r\n            }\r\n\r\n            if (invoegNiveau != 0)\r\n            {\r\n                // Er is een nieuw invoegNiveau bepaald, ga vanaf de huidige positie (stuIndex) op \r\n                // zoek naar de parent met niveau invoegNiveau\r\n\r\n                // NB Root niveau = 0, alle daaronder liggende niveaus zijn \"hogere\" niveaus \r\n\r\n                int bgrRegelNiveau = _Stu[stuIndex]._Niveau;\r\n                if (bgrRegelNiveau == invoegNiveau)\r\n                {\r\n                    // Ben ik zelf al van het juiste niveau dan klaar\r\n                }\r\n                else if (bgrRegelNiveau < invoegNiveau)\r\n                {\r\n                    if (bgrRegelNiveau == invoegNiveau - 1)\r\n                    {\r\n                        // De huidige regel wordt parent\r\n                    }\r\n                    else\r\n                    {\r\n                        // Het niveau van de huidige regel is te laag voor het invoegen.\r\n                        // Kijk naar de onderbouwing om te zien of er een geschikt niveau gevonden kan worden.\r\n                        // Kan dat niet, dan invoegen op lager niveau.\r\n                        int indexVanNiveau = _Stu.GeefEersteKindVanNiveau(true, false, stuIndex, invoegNiveau - 1);\r\n                        if (indexVanNiveau != -1)\r\n                        {\r\n                            stuIndex = indexVanNiveau;\r\n                        }\r\n                    }\r\n                }\r\n                else if (bgrRegelNiveau > invoegNiveau)\r\n                {\r\n                    // Ben ik zelf hoger dan het gewenste niveau naar boven zoeken naar de eerste van het juiste niveau\r\n                    int prtIndex = _Stu.ZoekParent(stuIndex);\r\n                    while (_Stu[prtIndex]._Niveau != invoegNiveau)\r\n                    {\r\n                        prtIndex = _Stu.ZoekParent(prtIndex);\r\n                        if (prtIndex == -1)\r\n                            break;\r\n                    }\r\n                }\r\n            }\r\n\r\n            return stuIndex;\r\n        }\r\n\r\n        public BBedrag GeefUurTarief(string cde)\r\n        {\r\n            BUurloonBVzl ulnVzl = (BUurloonBVzl)_REl._Uln;\r\n            return ulnVzl.GeefUurTarief(cde, true);\r\n        }\r\n\r\n        public IList<BStructuurRegel> GeefMtnGuidRegels(Guid mtnGuid)\r\n        {\r\n            return (from BStructuurRegel rgl in _Stu.Lijst\r\n                    where rgl._Regel?._Meting != null\r\n                        && rgl._Regel?._Meting?._MtnGuid == mtnGuid\r\n                        && rgl._Regel?._Meting?._MtnGuid != Guid.Empty\r\n                        && (rgl._Tpe == EOnderbouwing.Element\r\n                            || rgl._Tpe == EOnderbouwing.Kostenpost)\r\n                    select rgl).ToList();\r\n        }\r\n\r\n        public void LogboekMelding(IBegrotingsRegel bgrRegel, string melding)\r\n        {\r\n            int stuIndex = _Stu.ZoekId(bgrRegel._Id);\r\n            _logboek.Toevoegen(_Naam, stuIndex, melding);\r\n        }\r\n        public void LogboekMelding(IBegrotingsRegel bgrRegel, string melding, EViewKey castContextView)\r\n        {\r\n            int stuIndex = _Stu.ZoekId(bgrRegel._Id);\r\n            _logboek.Toevoegen(_Naam, stuIndex, melding, castContextView);\r\n        }\r\n        public void LogboekMelding(string melding)\r\n        {\r\n            _logboek.Toevoegen(_Naam, melding);\r\n        }\r\n        public void LogboekMelding(string melding, EViewKey castContextView)\r\n        {\r\n            _logboek.Toevoegen(_Naam, melding, castContextView);\r\n        }\r\n\r\n        public IBegroting? GeefAndereBegroting(IBegroting begroting)\r\n        {\r\n            return (begroting == this) ? null : this;\r\n        }\r\n\r\n        public bool UurloonOvernemen(IBegroting begroting, string cde)\r\n        {\r\n            BUurloonBVzl ulnVzl = (BUurloonBVzl)_REl._Uln;\r\n            if (ulnVzl.HeeftUurTarief(cde, true))          // true: geen nultarief\r\n                return false;\r\n\r\n            BUurloonBVzl? ulnVzlOrig = begroting._REl?._Uln as BUurloonBVzl;\r\n            return ulnVzl.KopieerUurloon(ulnVzlOrig, cde, _BasisValuta?._ValutaVzl);\r\n        }\r\n\r\n        public BBegrotingSelectie MaakBegrotingSelectie(int eltId)\r\n        {\r\n            int begin = _Stu.ZoekElement(eltId);\r\n            int einde = _Stu.EindeElement(begin);\r\n            BSelectie selectie = new BSelectie(begin, einde);\r\n            BBegrotingSelectie begrotingSelectie = new(this, selectie);\r\n            begrotingSelectie.Bewaren(true);\r\n            return begrotingSelectie;\r\n        }\r\n\r\n        public bool GeefOnderbouwingstype(string stuurcode, ref EOnderbouwing type)\r\n        {\r\n            if (stuurcode.TrimEnd().Length == 0 ||\r\n               char.IsLetter(stuurcode, 0) ||\r\n               stuurcode[0] == BBegrotingsRegel.c_cStkCorrectie)  // '$'\r\n            {\r\n                type = EOnderbouwing.Kostenpost;\r\n            }\r\n            else\r\n            {\r\n                switch (stuurcode[0])\r\n                {\r\n                    //case BBegrotingsRegel.c_cStkPassief: // ',' tijdelijke waarde, wordt omgezet in status PASSIEF\r\n                    case BBegrotingsRegel.c_cStkVoorlopig:\r\n                        type = EOnderbouwing.Kostenpost;\r\n                        break; // '?'\r\n\r\n                    case BBegrotingsRegel.c_cStkOpslag:\r\n                    case BBegrotingsRegel.c_cStkSub:\r\n                    case BBegrotingsRegel.c_cStkEltTtot:\r\n                    case BBegrotingsRegel.c_cStkSubOpslag:\r\n                    case BBegrotingsRegel.c_cStkEindOpslag:\r\n                        // Type is opslagpost, status geeft aan welke type opslagpost het betreft.\r\n                        type = EOnderbouwing.Opslagpost;\r\n                        break; // '%', '>', '^' of '@'\r\n\r\n                    case BBegrotingsRegel.c_cStkCommentaar:\r\n                        type = EOnderbouwing.Commentaar;\r\n                        break; // '\"'\r\n                    case BBegrotingsRegel.c_cAlleenOmsHoev:\r\n                    case BBegrotingsRegel.c_cAlleenTotPrys:\r\n                    case BBegrotingsRegel.c_cStkNietafdrukken:\r\n                        // type wordt niet gewijzigd alleen status verandert\r\n                        // '-' tijdelijke waarde, wordt omgezet in status PASSIEF, NIET AFDRUKKEN\r\n                        break;\r\n                    default:\r\n                        {\r\n                            // Een type blijft over:\r\n                            type = EOnderbouwing.Element;\r\n\r\n                            // Is het wel een mogelijke stuurcode van een element?\r\n                            if (!stuurcode.TryToInt(out int _))\r\n                                return false;\r\n\r\n                            break;\r\n                        }\r\n                }\r\n            }\r\n            return true;\r\n        }\r\n\r\n        public KopieerBegrotingRegelsUMCRefOpdracht MaakKopieerBegrotingsRegelsOpdrachtRefUmcAltF(IBegroting begroting, int eltId)\r\n        {\r\n            int begin = _Stu.ZoekElement(eltId);          // Bepaal de positie van het element in de structuurlijst van de begroting\r\n            int einde = _Stu.EindeElement(begin);         // Index van de eerste regel na de elementonderbouwing\r\n            BSelectie selectie = new(begin, einde);\r\n\r\n            KopieerBegrotingRegelsUMCRefOpdracht umcRefOpdracht = new KopieerBegrotingRegelsUMCRefOpdracht(begroting, this, selectie);\r\n\r\n            return umcRefOpdracht;\r\n        }\r\n\r\n        public KopieerBegrotingRegelsOpdracht MaakKopieerBegrotingsRegelsOpdracht(IBegroting begroting, int eltId)\r\n        {\r\n            int begin = _Stu.ZoekElement(eltId);          // Bepaal de positie van het element in de structuurlijst van de begroting\r\n            int einde = _Stu.EindeElement(begin);         // Index van de eerste regel na de elementonderbouwing\r\n            BSelectie selectie = new(begin, einde);\r\n\r\n            KopieerBegrotingRegelsOpdracht opdracht = new(begroting, this, selectie);\r\n\r\n            return opdracht;\r\n        }\r\n\r\n        public BElement? GeefParentElement(int idVanKind, out bool elementOp0)\r\n        {\r\n            elementOp0 = _ElementenOp0;\r\n            int parentId = _Stu.GeefParentId(idVanKind);\r\n            if (parentId == 0)\r\n                return null;\r\n            IBegrotingsRegel? bgrRgel = _Stu.GeefBegrotingsRegel(parentId);\r\n            BElement? elt = bgrRgel as BElement;\r\n            return elt;\r\n        }\r\n\r\n        public double GeefCumulatieveHvh(int middelId)\r\n        {\r\n            double cumulatieveHvh = 0.0;\r\n            int stuIndex = -1;\r\n            IStructuur bgrStructuur = _Stu;\r\n            BKostenpost? kostenpost = (BKostenpost?)bgrStructuur.GeefVolgendeBgrRegel(EOnderbouwing.Kostenpost, ref stuIndex);\r\n            while (kostenpost != null)\r\n            {\r\n                if (kostenpost._Actief && kostenpost._Middel._Id == middelId)\r\n                {\r\n                    if (kostenpost._Dri != EDri.Tgd)\r\n                        cumulatieveHvh += kostenpost._DrkHvh;\r\n                    else\r\n                        cumulatieveHvh += 1.0;\r\n                }\r\n                kostenpost = (BKostenpost?)bgrStructuur.GeefVolgendeBgrRegel(EOnderbouwing.Kostenpost, ref stuIndex);\r\n            }\r\n            return cumulatieveHvh;\r\n        }\r\n\r\n        public void BepaalMiddelenGebruik(int middelId, BMiddelenGebruik middelenGebruik)\r\n        {\r\n            IStructuur structuur = _Stu;\r\n            BElement element = _REl;\r\n            BKostenpost kostenpost;\r\n\r\n            // Doorloop de onderbouwing\r\n            int aantalRegels = structuur._Aantal;\r\n            IBegrotingsRegel? bgrRegel;\r\n            for (int stuIndex = 0; stuIndex < aantalRegels; stuIndex++)\r\n            {\r\n                bgrRegel = structuur[stuIndex]._Regel;\r\n                switch (bgrRegel?._OnderbouwingType)\r\n                {\r\n                    case EOnderbouwing.Element:  // subelement \r\n                        element = (BElement)bgrRegel;\r\n                        break;\r\n\r\n                    case EOnderbouwing.Kostenpost:\r\n                        kostenpost = (BKostenpost)bgrRegel;\r\n                        if (kostenpost._Middel._Id == middelId)\r\n                            middelenGebruik.KostenpostToevoegen(kostenpost, element, stuIndex);   // Ook als de kostenpost niet actief is\r\n                        break;\r\n                }\r\n            }\r\n            middelenGebruik.SelecteerMiddel(middelId, null);\r\n        }\r\n\r\n        /// <summary>\r\n        /// Geef een alternatieve tekst coor de alternatieve code kolom\r\n        /// Wordt gebruikt voor het tonen van het RAW RO subtotaal \"behoort tot RO\"\r\n        /// int de alternatieve code kolom (alleen bij een opslagpost \">\" onder een element met code \"9\"\r\n        /// </summary>\r\n        /// <param name=\"id\">De id van de opslagpost</param>\r\n        /// <param name=\"waarde\">de tekst waarde van het subtotaal</param>\r\n        /// <returns>true indien een subtotaal9RO regel anders false</returns>\r\n        public bool GeefAlternatiefCodeTekst(int id, out string waarde)\r\n        {\r\n            waarde = string.Empty;\r\n            if (_RawInfo != null && _RawInfo.IsSubtotaal9VanRO(this, id))\r\n            {\r\n                double waardeDbl = _RawInfo.GeefRawAltSubtotaal(_BasisValuta, BegrotingsValuta).Waarde;\r\n                waarde = _afronden.GetalAlsTekst(waardeDbl, 2);\r\n                return true;\r\n            }\r\n            return false;\r\n        }\r\n\r\n        protected virtual void Dispose(bool disposing)\r\n        {\r\n            if (!_disposedValue)\r\n            {\r\n                if (disposing)\r\n                {\r\n                    m_MeetstaatModelVzl?.Dispose();\r\n                }\r\n\r\n                _disposedValue = true;\r\n            }\r\n        }\r\n\r\n        public void Dispose()\r\n        {\r\n            // Do not change this code. Put cleanup code in 'Dispose(bool disposing)' method\r\n            Dispose(disposing: true);\r\n            GC.SuppressFinalize(this);\r\n        }\r\n\r\n        #region Delegates\r\n        public delegate BMeetstaat.EKopieerKoppeling VraagKopieerKoppelingDlgte(bool binnenBegroting, BMeetstaat.EKopieerKoppeling verstekWaarde);\r\n        public delegate bool WijzigenControlevraagDlgte(string oudeWaarde, string nieuweWaarde, out bool stoppen);\r\n        #endregion\r\n\r\n        public bool MoetRekenen { get; set; }\r\n    }\r\n", "metrics": {"ATFD": 499, "WMC": 1252, "TCC": 0.1911, "PublicMethods": 266, "AtfdFew": 4, "WmcVeryHigh": 47, "TccThreshold": 0.3333}, "context_level": "minimal", "model_name": "DeepSeek-V4-Pro", "prompt_version": "v1.1.0", "raw_system_prompt": "You are a .NET code quality expert. You will be given a code anti-pattern finding.\n\nExplain the impact of this anti-pattern on relevant ISO/IEC 25010 software\nquality attributes. Focus on attributes such as maintainability, analysability,\nmodifiability, testability, security, reliability, and compatibility where\napplicable. Only mention attributes that are genuinely relevant — do not\nenumerate every attribute by default.\n\nRespond ONLY with a JSON object in this exact format, with no additional text:\n{\n  \"explanation\": \"<why this is a problem and what its impact is>\",\n  \"quality_impact\": \"Quality impact:\\n- Attribute: short explanation\\n- Attribute: short explanation\",\n  \"remediation\": \"<concrete refactoring steps; include a short code example where helpful>\"\n}", "raw_user_prompt": "Anti-pattern: GodClass\r\n\r\n## Code\r\n```csharp\r\n\r\n    #endregion enum\r\n    /// <summary> Begroting: onderdeel van Project </summary>\r\n    public partial class BBegroting : IBegroting, IDisposable\r\n    {